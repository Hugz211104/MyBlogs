---
import Comments from '@/components/Comments.astro';
import Icon from '@/components/Icon.astro';
import TableOfContents, { type TocHeading } from '@/components/TableOfContents.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDateVi, type CategoryKey } from '@/lib/posts';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: CategoryKey;
  categoryLabel: string;
  backHref: string;
  backLabel: string;
  cover?: string;
  headings?: TocHeading[];
  tags?: string[];
  metaBadges?: { label: string; value: string }[];
  readingMinutes?: number;
}

const {
  title,
  description,
  date,
  category,
  categoryLabel,
  backHref,
  backLabel,
  cover,
  headings = [],
  tags = [],
  metaBadges = [],
  readingMinutes,
} = Astro.props;

const hasToc = headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 1;
---

<BaseLayout title={title} description={description} ogType="article">
  <div id="read-progress" class="read-progress" aria-hidden="true"></div>

  <div class:list={['article-layout', { 'article-layout--with-toc': hasToc }]}>
    <article class="article-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <Icon name="chevron-right" size={14} />
        <a href={backHref}>{backLabel}</a>
      </nav>

      <header class="article-header card">
        <div class="article-badges">
          <span class={`badge badge--${category}`}>
            <Icon name={category} size={13} />
            <span>{categoryLabel}</span>
          </span>
          {
            metaBadges.map((item) => (
              <span class="meta-chip">
                <strong>{item.label}:</strong> {item.value}
              </span>
            ))
          }
        </div>

        <h1 class="article-title">{title}</h1>
        <p class="article-summary">{description}</p>

        <div class="article-meta-row">
          <span class="meta-date">
            <Icon name="calendar" size={14} />
            <span>Ngày đăng: {formatDateVi(date)}</span>
          </span>
          {readingMinutes && <span class="meta-read">· ~{readingMinutes} phút đọc</span>}
          <button type="button" id="copy-share-link" class="share-btn">
            <Icon name="share" size={14} />
            <span id="copy-share-label">Sao chép link</span>
          </button>
        </div>

        {
          tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag) => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>
          )
        }

        {
          cover && (
            <div class="article-cover">
              <img src={cover} alt={`Ảnh bìa bài viết ${title}`} loading="eager" decoding="async" />
            </div>
          )
        }
      </header>

      <slot name="before-prose" />

      {hasToc && (
        <div class="mobile-toc-slot">
          <TableOfContents headings={headings} />
        </div>
      )}

      <div class="article-body card prose">
        <slot />
      </div>

      <Comments />

      <div class="article-footer">
        <a href={backHref} class="back-link">
          <Icon name="arrow-right" size={16} class="back-arrow" />
          <span>Quay lại danh sách {backLabel}</span>
        </a>
      </div>
    </article>

    {hasToc && (
      <div class="desktop-toc-slot">
        <TableOfContents headings={headings} />
      </div>
    )}
  </div>

  <dialog id="img-lightbox" class="img-lightbox" aria-label="Xem ảnh phóng to">
    <button type="button" id="img-lightbox-close" class="lightbox-close" aria-label="Đóng">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>
    <img id="img-lightbox-target" src="" alt="Ảnh phóng to từ bài viết" />
  </dialog>
</BaseLayout>

<script is:inline>
  (() => {
    // Reading progress bar
    const progress = document.getElementById('read-progress');
    if (progress) {
      const updateProgress = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
        progress.style.width = `${pct}%`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    // Share link button
    const shareBtn = document.getElementById('copy-share-link');
    const shareLabel = document.getElementById('copy-share-label');
    shareBtn?.addEventListener('click', async () => {
      if (!shareLabel) return;
      const orig = shareLabel.textContent;
      try {
        await navigator.clipboard.writeText(window.location.href);
        shareLabel.textContent = 'Đã chép link';
        shareBtn.classList.add('copied');
      } catch {
        shareLabel.textContent = 'Không thể chép';
      }
      setTimeout(() => {
        shareLabel.textContent = orig;
        shareBtn.classList.remove('copied');
      }, 1800);
    });

    // Inject copy buttons on code blocks
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.parentNode?.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy-btn';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        const text = pre.innerText || '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Đã chép';
          btn.classList.add('copied');
        } catch {
          btn.textContent = 'Lỗi';
        }
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 1600);
      });
      wrap.appendChild(btn);
    });

    // Image lightbox
    const dialog = document.getElementById('img-lightbox');
    const target = document.getElementById('img-lightbox-target');
    const closeBtn = document.getElementById('img-lightbox-close');
    if (dialog && target) {
      document.querySelectorAll('.prose img').forEach((img) => {
        img.title = 'Bấm để phóng to';
        img.addEventListener('click', () => {
          target.src = img.currentSrc || img.src;
          target.alt = img.alt || 'Ảnh bài viết phóng to';
          if (typeof dialog.showModal === 'function') dialog.showModal();
        });
      });

      closeBtn?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
  })();
</script>

<style>
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    z-index: 60;
    background: linear-gradient(90deg, var(--color-primary), var(--color-secondary), var(--color-accent));
    transition: width 80ms linear;
  }

  .article-layout {
    max-width: 860px;
    margin: 0 auto;
  }

  .article-layout--with-toc {
    max-width: 1180px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 264px;
    gap: 1.5rem;
    align-items: start;
  }

  .article-shell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-toc-slot {
    display: none;
  }

  .desktop-toc-slot {
    position: sticky;
    top: 88px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-primary-bright);
  }

  .article-header {
    padding: 1.65rem 1.75rem;
  }

  .article-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.95rem;
  }

  .meta-chip {
    font-size: 0.78rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--color-inset);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .meta-chip strong {
    color: var(--color-text);
  }

  .article-title {
    margin: 0 0 0.65rem;
    font-size: var(--size-2xl);
    line-height: 1.22;
    color: var(--color-text);
  }

  .article-summary {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.62;
  }

  .article-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.84rem;
    color: var(--color-text-subtle);
  }

  .meta-date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .meta-read {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .share-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0.3rem 0.82rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border);
    background: var(--color-inset);
    color: var(--color-primary-bright);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--motion-micro) var(--ease-smooth),
      background-color var(--motion-micro) var(--ease-smooth),
      color var(--motion-micro) var(--ease-smooth);
  }

  .share-btn:hover {
    border-color: var(--color-border-strong);
    background: rgba(201, 169, 110, 0.14);
  }

  :global(.share-btn.copied) {
    border-color: rgba(52, 211, 153, 0.55);
    color: #6ee7b7;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .article-cover {
    margin-top: 1.25rem;
    border-radius: var(--radius-inset);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-body {
    padding: 1.8rem 1.85rem;
  }

  :global(.code-wrap) {
    position: relative;
    margin: 1.2rem 0;
  }

  :global(.code-wrap pre) {
    margin: 0 !important;
    padding-top: 2.4rem !important;
  }

  :global(.code-copy-btn) {
    position: absolute;
    top: 0.55rem;
    right: 0.6rem;
    padding: 0.24rem 0.62rem;
    border-radius: var(--radius-tight);
    border: 1px solid var(--color-border-strong);
    background: rgba(201, 169, 110, 0.16);
    color: var(--color-primary-bright);
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--motion-micro) var(--ease-smooth),
      border-color var(--motion-micro) var(--ease-smooth);
  }

  :global(.code-copy-btn:hover) {
    background: rgba(201, 169, 110, 0.28);
  }

  :global(.code-copy-btn.copied) {
    background: rgba(52, 211, 153, 0.22);
    border-color: rgba(52, 211, 153, 0.55);
    color: #a7f3d0;
  }

  .article-footer {
    margin-top: 0.4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary-bright);
  }

  .back-arrow {
    transform: rotate(180deg);
  }

  .back-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.prose img) {
    cursor: zoom-in;
  }

  .img-lightbox {
    border: none;
    padding: 1rem;
    background: transparent;
    max-width: min(96vw, 1320px);
    max-height: 94dvh;
    margin: auto;
  }

  .img-lightbox::backdrop {
    background: rgba(8, 9, 14, 0.86);
    backdrop-filter: blur(6px);
  }

  .img-lightbox img {
    max-width: 100%;
    max-height: 86dvh;
    border-radius: var(--radius-inset);
    border: 1px solid var(--color-border-strong);
    box-shadow: 0 12px 20px -4px rgba(0, 0, 0, 0.65);
  }

  .lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-elevated);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color var(--motion-micro) var(--ease-smooth);
  }

  .lightbox-close:hover {
    border-color: var(--color-primary);
  }

  @media (max-width: 1120px) {
    .article-layout--with-toc {
      grid-template-columns: 1fr;
      max-width: 860px;
    }

    .desktop-toc-slot {
      display: none;
    }

    .mobile-toc-slot {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .article-header,
    .article-body {
      padding: 1.2rem;
    }

    .share-btn {
      min-height: 44px;
    }
  }
</style>
