---
import Comments from '@/components/Comments.astro';
import Icon from '@/components/Icon.astro';
import TableOfContents, { type TocHeading } from '@/components/TableOfContents.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDateVi, type CategoryKey } from '@/lib/posts';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: CategoryKey;
  categoryLabel: string;
  backHref: string;
  backLabel: string;
  cover?: string;
  headings?: TocHeading[];
  tags?: string[];
  metaBadges?: { label: string; value: string }[];
  readingMinutes?: number;
}

const {
  title,
  description,
  date,
  category,
  categoryLabel,
  backHref,
  backLabel,
  cover,
  headings = [],
  tags = [],
  metaBadges = [],
  readingMinutes,
} = Astro.props;

const hasToc = headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 1;
---

<BaseLayout title={title} description={description} ogType="article">
  <div id="read-progress" class="read-progress" aria-hidden="true"></div>

  <div class="container page-wrap">
    <div class:list={['article-layout', { 'article-layout--with-toc': hasToc }]}>
      <article class="article-shell">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Trang chủ</a>
          <Icon name="chevron-right" size={16} />
          <a href={backHref}>{backLabel}</a>
        </nav>

        <header class="article-header">
          <div class="article-kicker">
            <span class="cat-tag">
              <span class={`cat-dot cat-dot--${category}`} aria-hidden="true"></span>
              <span>{categoryLabel}</span>
            </span>
            {
              metaBadges.map((item) => (
                <span class="meta-inline">
                  <span class="meta-sep">·</span>
                  <span>{item.label}: {item.value}</span>
                </span>
              ))
            }
          </div>

          <h1 class="article-title">{title}</h1>
          <p class="article-summary">{description}</p>

          <div class="article-meta-row">
            <span class="meta-item num">
              <Icon name="calendar" size={16} />
              <span>{formatDateVi(date)}</span>
            </span>
            {readingMinutes && <span class="meta-item num">· {readingMinutes} phút đọc</span>}
            <button type="button" id="copy-share-link" class="share-btn">
              <Icon name="share" size={16} />
              <span id="copy-share-label">Sao chép link</span>
            </button>
          </div>

          {
            tags.length > 0 && (
              <div class="article-tags">
                {tags.map((tag) => (
                  <span class="tag-chip">{tag}</span>
                ))}
              </div>
            )
          }

          {
            cover && (
              <div class="article-cover">
                <img src={cover} alt={`Ảnh bài viết ${title}`} loading="eager" decoding="async" />
              </div>
            )
          }
        </header>

        <slot name="before-prose" />

        {hasToc && (
          <div class="mobile-toc-slot">
            <TableOfContents headings={headings} />
          </div>
        )}

        <div class="article-body surface prose">
          <slot />
        </div>

        <Comments />

        <div class="article-footer">
          <a href={backHref} class="back-link">
            <Icon name="arrow-right" size={16} class="back-arrow" />
            <span>Quay lại {backLabel}</span>
          </a>
        </div>
      </article>

      {hasToc && (
        <div class="desktop-toc-slot">
          <TableOfContents headings={headings} />
        </div>
      )}
    </div>
  </div>

  <dialog id="img-lightbox" class="img-lightbox" aria-label="Xem ảnh phóng to">
    <button type="button" id="img-lightbox-close" class="lightbox-close" aria-label="Đóng">
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>
    <img id="img-lightbox-target" src="" alt="Ảnh phóng to từ bài viết" />
  </dialog>
</BaseLayout>

<script is:inline>
  (() => {
    const progress = document.getElementById('read-progress');
    if (progress) {
      const updateProgress = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
        progress.style.width = `${pct}%`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    const shareBtn = document.getElementById('copy-share-link');
    const shareLabel = document.getElementById('copy-share-label');
    shareBtn?.addEventListener('click', async () => {
      if (!shareLabel) return;
      const orig = shareLabel.textContent;
      try {
        await navigator.clipboard.writeText(window.location.href);
        shareLabel.textContent = 'Đã chép';
        shareBtn.classList.add('copied');
      } catch {
        shareLabel.textContent = 'Không thể chép';
      }
      setTimeout(() => {
        shareLabel.textContent = orig;
        shareBtn.classList.remove('copied');
      }, 1800);
    });

    document.querySelectorAll('.prose pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.parentNode?.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy-btn';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        const text = pre.innerText || '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Đã chép';
          btn.classList.add('copied');
        } catch {
          btn.textContent = 'Lỗi';
        }
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 1600);
      });
      wrap.appendChild(btn);
    });

    const dialog = document.getElementById('img-lightbox');
    const target = document.getElementById('img-lightbox-target');
    const closeBtn = document.getElementById('img-lightbox-close');
    if (dialog && target) {
      document.querySelectorAll('.prose img').forEach((img) => {
        img.title = 'Nhấn để phóng to';
        img.addEventListener('click', () => {
          target.src = img.currentSrc || img.src;
          target.alt = img.alt || 'Ảnh bài viết phóng to';
          if (typeof dialog.showModal === 'function') dialog.showModal();
        });
      });

      closeBtn?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
  })();
</script>

<style>
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    z-index: 60;
    background-color: var(--accent);
    transition: width 80ms linear;
  }

  .article-layout {
    max-width: 820px;
    margin: 0 auto;
  }

  .article-layout--with-toc {
    max-width: 1120px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 248px;
    gap: var(--space-8);
    align-items: start;
  }

  .article-shell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .mobile-toc-slot {
    display: none;
  }

  .desktop-toc-slot {
    position: sticky;
    top: 80px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .breadcrumb a:hover {
    color: var(--text-primary);
  }

  .article-header {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .article-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .meta-inline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .article-title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .article-summary {
    margin: 0 0 var(--space-4);
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .article-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .share-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 36px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    background-color: var(--bg-card);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .share-btn:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
    background-color: var(--bg-raised);
  }

  :global(.share-btn.copied) {
    border-color: var(--data-positive);
    color: var(--data-positive);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .article-cover {
    margin-top: var(--space-5);
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--border);
    background-color: var(--bg-deepest);
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-body {
    padding: var(--space-6);
  }

  :global(.code-wrap) {
    position: relative;
    margin: var(--space-5) 0;
  }

  :global(.code-wrap pre) {
    margin: 0 !important;
    padding-top: var(--space-10) !important;
  }

  :global(.code-copy-btn) {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    min-height: 28px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-tag);
    border: 1px solid rgba(239, 233, 222, 0.16);
    background-color: #262421;
    color: #efe9de;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  :global(.code-copy-btn:hover) {
    border-color: rgba(239, 233, 222, 0.3);
  }

  :global(.code-copy-btn.copied) {
    border-color: var(--data-positive);
    color: var(--data-positive);
  }

  .article-footer {
    margin-top: var(--space-2);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease);
  }

  .back-arrow {
    transform: rotate(180deg);
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  :global(.prose img) {
    cursor: zoom-in;
  }

  .img-lightbox {
    border: none;
    padding: var(--space-4);
    background: transparent;
    max-width: min(96vw, 1320px);
    max-height: 94dvh;
    margin: auto;
  }

  .img-lightbox::backdrop {
    background: rgba(18, 17, 15, 0.88);
  }

  .img-lightbox img {
    max-width: 100%;
    max-height: 86dvh;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-hover);
    box-shadow: var(--shadow-float);
  }

  .lightbox-close {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-control);
    border: 1px solid rgba(239, 233, 222, 0.2);
    background-color: #1c1a18;
    color: #efe9de;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .lightbox-close:hover {
    border-color: rgba(239, 233, 222, 0.4);
  }

  @media (max-width: 1100px) {
    .article-layout--with-toc {
      grid-template-columns: 1fr;
      max-width: 820px;
    }

    .desktop-toc-slot {
      display: none;
    }

    .mobile-toc-slot {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .article-body {
      padding: var(--space-5);
    }

    .share-btn {
      min-height: 44px;
    }
  }
</style>
