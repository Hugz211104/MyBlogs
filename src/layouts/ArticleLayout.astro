---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDateVi, type CategoryKey } from '@/lib/posts';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: CategoryKey;
  categoryLabel: string;
  backHref: string;
  backLabel: string;
  cover?: string;
  tags?: string[];
  metaBadges?: { label: string; value: string }[];
  readingMinutes?: number;
}

const {
  title,
  description,
  date,
  category,
  categoryLabel,
  backHref,
  backLabel,
  cover,
  tags = [],
  metaBadges = [],
  readingMinutes,
} = Astro.props;
---

<BaseLayout title={title} description={description} ogType="article">
  <article class="article-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Trang chủ</a>
      <span>/</span>
      <a href={backHref}>{backLabel}</a>
    </nav>

    <header class="article-header card">
      <div class="article-badges">
        <span class={`badge badge--${category}`}>{categoryLabel}</span>
        {
          metaBadges.map((item) => (
            <span class="meta-chip">
              <strong>{item.label}:</strong> {item.value}
            </span>
          ))
        }
      </div>

      <h1 class="article-title">{title}</h1>
      <p class="article-summary">{description}</p>

      <div class="article-meta-row">
        <span>Ngày đăng: {formatDateVi(date)}</span>
        {readingMinutes && <span>· ~{readingMinutes} phút đọc</span>}
      </div>

      {
        tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <span class="tag-pill">#{tag}</span>
            ))}
          </div>
        )
      }

      {
        cover && (
          <div class="article-cover">
            <img src={cover} alt={title} loading="eager" decoding="async" />
          </div>
        )
      }
    </header>

    <slot name="before-prose" />

    <div class="article-body card prose">
      <slot />
    </div>

    <div class="article-footer">
      <a href={backHref} class="back-link">← Quay lại danh sách {backLabel}</a>
    </div>
  </article>

  <dialog id="img-lightbox" class="img-lightbox" aria-label="Xem ảnh phóng to">
    <button type="button" id="img-lightbox-close" class="lightbox-close" aria-label="Đóng">✕</button>
    <img id="img-lightbox-target" src="" alt="" />
  </dialog>
</BaseLayout>

<script is:inline>
  (() => {
    const dialog = document.getElementById('img-lightbox');
    const target = document.getElementById('img-lightbox-target');
    const closeBtn = document.getElementById('img-lightbox-close');
    if (!dialog || !target) return;

    document.querySelectorAll('.prose img').forEach((img) => {
      img.title = 'Bấm để phóng to';
      img.addEventListener('click', () => {
        target.src = img.currentSrc || img.src;
        target.alt = img.alt || '';
        if (typeof dialog.showModal === 'function') dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  })();
</script>

<style>
  .article-shell {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    color: var(--text-muted);
  }

  .breadcrumb a:hover {
    color: var(--accent-text);
  }

  .article-header {
    padding: 1.6rem 1.65rem;
  }

  .article-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.9rem;
  }

  .meta-chip {
    font-size: 0.78rem;
    padding: 0.24rem 0.65rem;
    border-radius: 999px;
    background: var(--bg-pill);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .meta-chip strong {
    color: var(--text);
  }

  .article-title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .article-summary {
    margin: 0 0 0.95rem;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .article-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.84rem;
    color: var(--text-subtle);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .article-cover {
    margin-top: 1.25rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-body {
    padding: 1.75rem 1.8rem;
  }

  .article-footer {
    margin-top: 0.4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .back-link:hover {
    text-decoration: underline;
  }

  :global(.prose img) {
    cursor: zoom-in;
  }

  .img-lightbox {
    border: none;
    padding: 1rem;
    background: transparent;
    max-width: min(96vw, 1320px);
    max-height: 94vh;
    margin: auto;
  }

  .img-lightbox::backdrop {
    background: rgba(8, 6, 16, 0.85);
    backdrop-filter: blur(4px);
  }

  .img-lightbox img {
    max-width: 100%;
    max-height: 86vh;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
  }

  .lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .article-header,
    .article-body {
      padding: 1.2rem;
    }
  }
</style>
