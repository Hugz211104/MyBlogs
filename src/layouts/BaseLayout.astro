---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { SITE } from '@/lib/site';
import '@/styles/tokens.css';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  home?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.defaultOgImage,
  ogType = 'website',
  home = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.subtitle}`;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const fullOgImage = new URL(ogImage, SITE.url).href;
---

<!doctype html>
<html
  lang="vi"
  data-type="software"
  data-radius="soft"
  data-ground="sage"
  data-buttons="pill"
  data-motion
  data-theme="dark"
  data-tone="dark"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="site-kind" content="software" />
    <meta name="page-type" content="software" />
    <meta name="theme-color" content="#161c1a" id="meta-theme-color" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={SITE.title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chivo:wght@400..700&family=Chivo+Mono:wght@400..500&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/assets/system.css" />
    <link rel="stylesheet" href="/assets/ui/base.css" />
    <link rel="stylesheet" href="/assets/ui/cards.css" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/backgrounds/backgrounds.css" />
    <link rel="stylesheet" href="/assets/layout/layout.css" />
    <link rel="stylesheet" href="/assets/icons/icon.css" />
    {
      home && (
        <>
          <link rel="stylesheet" href="/assets/ui/window/fragment.css" />
          <link rel="stylesheet" href="/assets/ui/terminal-run/fragment.css" />
          <link rel="stylesheet" href="/assets/ui/stat/fragment.css" />
          <link rel="stylesheet" href="/assets/diagrams/diagram.css" />
          <link rel="stylesheet" href="/assets/moments/word-highlight/moment.css" />
          <link rel="modulepreload" href="/assets/moments/moments.js" />
          <link rel="modulepreload" href="/assets/moments/lib.js" />
          <link rel="modulepreload" href="/assets/moments/word-highlight/moment.js" />
        </>
      )
    }

    <!-- Must stay after layout.css so --ly-scale: 0.96 and theme tokens override resets -->
    <style is:inline>
      :root,
      :root[data-theme='dark'] {
        --p-bg: #161c1a;
        --p-surface: #1f2725;
        --p-ink: #e3e2da;
        --p-muted: #8e948d;
        --p-accent: #9fc7b8;
        --p-accent-ink: #161c1a;
        --p-action: #9fc7b8;
        --p-action-ink: #161c1a;
        --p-inv-bg: #e3e2da;
        --p-inv-surface: #d3d2cb;
        --p-inv-ink: #161c1a;
        --p-inv-muted: #555a55;
        --p-inv-accent: #161c1a;
        --p-inv-accent-ink: #e3e2da;
        --p-inv-action: #161c1a;
        --p-inv-action-ink: #e3e2da;
        --font-display: 'Chivo', system-ui, sans-serif;
        --font-text: 'Chivo', system-ui, sans-serif;
        --font-mono: 'Chivo Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
        --display-weight: 400;
        --display-tracking: -0.035em;
        --display-tracking-xl: -0.04em;
        --ly-scale: 0.84;
      }

      :root[data-theme='light'] {
        --p-bg: #eef0f3;
        --p-surface: #e2e5ea;
        --p-ink: #0b0c0e;
        --p-muted: #5d6470;
        --p-accent: #1f2de6;
        --p-accent-ink: #ffffff;
        --p-action: #1f2de6;
        --p-action-ink: #ffffff;
        --p-inv-bg: #0b0c0e;
        --p-inv-surface: #17181a;
        --p-inv-ink: #eef0f3;
        --p-inv-muted: #8e8f92;
        --p-inv-accent: #eef0f3;
        --p-inv-accent-ink: #0b0c0e;
        --p-inv-action: #eef0f3;
        --p-inv-action-ink: #0b0c0e;
      }
    </style>

    <!-- Prevent theme flash & arm entrance + moment fallback before first paint -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        const theme = saved === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-tone', theme);
        const tc = document.getElementById('meta-theme-color');
        if (tc) tc.setAttribute('content', theme === 'light' ? '#eef0f3' : '#161c1a');
      } catch {}
      document.documentElement.classList.add('m-enter');
      setTimeout(() => document.documentElement.classList.add('m-enter-done'), 700);
    </script>
    <script is:inline src="/assets/backgrounds/backgrounds.js"></script>
    {
      home && (
        <script is:inline>
          document.documentElement.classList.add('mo-js');
          setTimeout(() => document.documentElement.classList.add('mo-safe'), 2500);
        </script>
      )
    }
  </head>
  <body class:list={[{ 'flow-page': !home }]}>
    <Header />

    {
      home ? (
        <main id="main">
          <slot />
        </main>
      ) : (
        <main id="main">
          <div class="flow-inner">
            <slot />
          </div>
        </main>
      )
    }

    <Footer home={home} />

    <script type="module" src="/assets/system.js"></script>
    <script type="module" src="/assets/motion/motion.js"></script>
    {
      home && (
        <>
          <script type="module" src="/assets/layout/layout.js"></script>
          <script type="module" src="/assets/diagrams/mount.js"></script>
        </>
      )
    }
  </body>
</html>
