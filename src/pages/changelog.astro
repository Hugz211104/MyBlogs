---
import Icon from '@/components/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const updates = [
  {
    version: 'v2.2',
    date: '20/11/2026',
    tag: 'Content & Mechanics',
    items: [
      'Đăng bài viết chuyên sâu Cơ Chế Sát Thương, Roll Đòn Đánh & Hệ Thống Chỉ Số WWM (9 phần, đầy đủ bảng tra cứu Lv.100–115, 7 biểu đồ kỹ thuật gốc và banner minh họa mới).',
    ],
  },
  {
    version: 'v2.1',
    date: '19/11/2026',
    tag: 'Content & Builds',
    items: [
      'Đăng bài build Hướng Dẫn Chi Tiết Build Dù Quạt Công (Sau Bản 2.4) — Cre: PreBox kèm banner cover riêng và 5 icon Tâm pháp gốc.',
    ],
  },
  {
    version: 'v2.0',
    date: '19/11/2026',
    tag: 'Cyber Midnight & Gold',
    items: [
      'Thiết kế lại toàn bộ frontend theo hệ thống Anti-AI Design với phong cách Glass Aurora + Bento Editorial trên Desktop & Mobile.',
      'Đóng băng hệ thống Design Token Cyber Midnight & Gold (Nền Obsidian #0b0d14, Vàng Imperial Gold #c9a96e, Tím Mystic Violet #a855f7, Cyan Tips & Emerald Tools) kèm chế độ Light Override.',
      'Chuyển sang bộ chữ Space Grotesk + Be Vietnam Pro (hỗ trợ đầy đủ dấu tiếng Việt) + JetBrains Mono và hệ thống icon SVG đồng bộ nét 1.8px.',
      'Nâng cấp bố cục trang chủ thành Asymmetric Bento Grid, bổ sung thanh điều hướng đáy (Bottom Tab Bar) chuẩn chạm >=44px trên thiết bị di động.',
    ],
  },
  {
    version: 'v1.3',
    date: '18/11/2026',
    tag: 'Interactive & UX',
    items: [
      'Thêm Mục lục tự động (Sticky TOC) + thanh tiến độ đọc cho toàn bộ bài viết dài.',
      'Thêm Máy tính tỷ lệ Hit Roll Where Winds Meet (/builds/calculator).',
      'Tạo ảnh cover riêng biệt cho từng bài Builds WWM kèm badge trạng thái và hiệu ứng glow theo danh mục.',
      'Thêm nút Copy cho mọi khối code, nút Chia sẻ link và khu vực Bình luận (Utterances) dưới mỗi bài.',
      'Thêm bộ lọc nhanh theo vai trò/chủ đề trên trang /builds và góc kênh YouTube/TikTok.',
    ],
  },
  {
    version: 'v1.2',
    date: '18/11/2026',
    tag: 'Content & Tools',
    items: [
      'Thêm bài build Giáo Án Tà Đạo – Healer Hỏa Quyền Lv100 với 10 ảnh gốc độ phân giải cao.',
      'Thêm tool CodeLoader — Tool Nhập Code Where Winds Meet kèm link tải trực tiếp và SHA-256 thật.',
      'Gắn liên kết kênh YouTube @MUSICandANIMEVN và TikTok @cachephoabruh1.',
    ],
  },
  {
    version: 'v1.1',
    date: '18/11/2026',
    tag: 'Where Winds Meet',
    items: [
      'Đồng bộ 4 tài liệu Where Winds Meet từ Google Docs: Điều Chỉnh Cân Bằng 2.4, Vô Danh By Hưng, Song Thương Preview, Hướng Dẫn Chỉ Số.',
      'Nâng cấp ảnh từ Google Docs lên bản gốc sắc nét và thêm Lightbox phóng to khi bấm vào ảnh.',
    ],
  },
  {
    version: 'v1.0',
    date: '18/11/2026',
    tag: 'Launch',
    items: [
      'Khởi tạo Hưng’s Blog bằng Astro + TypeScript + Content Collections, giao diện Dark/Light mode mặc định tối.',
      'Thêm bài tip LawBot NTTU FastAPI + PhoBERT và tool Sonar TTS Helper.',
      'Deploy lên Cloudflare Workers Static Assets tại myblogs.nhokhungtg182.workers.dev.',
    ],
  },
];
---

<BaseLayout
  title="Nhật ký cập nhật"
  description="Lịch sử cập nhật tính năng, bài viết và công cụ trên Hưng's Blog."
>
  <section class="changelog-shell">
    <div class="card cl-hero">
      <span class="badge badge--tips">
        <Icon name="history" size={14} />
        <span>Changelog</span>
      </span>
      <h1 class="cl-title">Nhật ký cập nhật Hưng's Blog</h1>
      <p class="cl-desc">Theo dõi các thay đổi mới nhất về giao diện, tài liệu Where Winds Meet và tool tự build.</p>
    </div>

    <div class="cl-list reveal-stagger">
      {
        updates.map((u) => (
          <article class="card cl-item">
            <div class="cl-head">
              <span class="cl-ver">{u.version}</span>
              <span class="badge badge--builds">{u.tag}</span>
              <span class="cl-date">{u.date}</span>
            </div>
            <ul class="cl-points">
              {u.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .changelog-shell {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .cl-hero {
    padding: 1.65rem 1.75rem;
    background:
      radial-gradient(ellipse 55% 90% at 95% 15%, rgba(56, 189, 248, 0.14), transparent 60%),
      var(--color-surface);
  }

  .cl-title {
    margin: 0.7rem 0 0.35rem;
    font-size: var(--size-2xl);
    color: var(--color-text);
  }

  .cl-desc {
    margin: 0;
    color: var(--color-text-muted);
  }

  .cl-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cl-item {
    padding: 1.35rem 1.55rem;
  }

  .cl-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }

  .cl-ver {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--color-primary-bright);
  }

  .cl-date {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-subtle);
  }

  .cl-points {
    margin: 0;
    padding-left: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .cl-points li {
    margin-bottom: 0.4rem;
  }

  @media (max-width: 640px) {
    .cl-hero,
    .cl-item {
      padding: 1.2rem;
    }
  }
</style>
