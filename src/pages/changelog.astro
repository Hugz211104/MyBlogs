---
import BaseLayout from '@/layouts/BaseLayout.astro';

const updates = [
  {
    version: 'v3.0',
    date: '21/11/2026',
    tag: 'Unslop Redesign',
    items: [
      'Thiết kế lại toàn bộ frontend theo phương pháp unslop: bỏ nền kính mờ blur, gradient hai màu, spotlight chuột, hào quang phát sáng và emoji trang trí.',
      'Chuyển sang bảng màu Warm Ink (#161513) ở chế độ tối và giấy lụa ấm (#f7f4ee) ở chế độ sáng, dùng duy nhất một điểm nhấn đồng trầm (#c8964b / #9c6d24).',
      'Thay cặp chữ bằng Newsreader (tiêu đề), Be Vietnam Pro (giao diện & bài đọc) và JetBrains Mono (số liệu tabular-nums).',
      'Xây lại Hero trang chủ với cảnh tĩnh bàn làm việc 16:9 không chữ, tiêu đề HTML thật cùng bản xem trước trực tiếp Máy tính Sát Thương Lv.100.',
    ],
  },
  {
    version: 'v2.3',
    date: '20/11/2026',
    tag: 'Damage Engine v2',
    items: [
      'Nâng cấp /builds/calculator thành Máy Tính Sát Thương & Hit Roll WWM v2: Kháng Phán Định 85% (Lv.100 Raid), nền 65% Chính Xác, hệ số thực chiến 1.50x Crit & 1.35x Hội Ý, Bẫy Trần Ẩn, Chuyển đổi Sượt K, Ba Đường Ray, khóa Tiểu >= Đại, độ dốc Xuyên Giáp, ngưỡng pha Tràn Hội Ý và La bàn ưu tiên chỉ số.',
    ],
  },
  {
    version: 'v2.2',
    date: '20/11/2026',
    tag: 'Content & Mechanics',
    items: [
      'Đăng bài viết chuyên sâu Cơ Chế Sát Thương, Roll Đòn Đánh & Hệ Thống Chỉ Số WWM (9 phần, bảng tra cứu Lv.100–115 và 7 biểu đồ kỹ thuật).',
    ],
  },
  {
    version: 'v2.1',
    date: '19/11/2026',
    tag: 'Content & Builds',
    items: [
      'Đăng bài build Hướng Dẫn Chi Tiết Build Dù Quạt Công (Sau Bản 2.4) — Cre: PreBox kèm banner cover và 5 ảnh Tâm pháp.',
    ],
  },
  {
    version: 'v2.0',
    date: '19/11/2026',
    tag: 'Design Refresh',
    items: [
      'Đồng bộ giao diện đáp ứng Desktop & Mobile với thanh điều hướng đáy cho điện thoại.',
    ],
  },
  {
    version: 'v1.3',
    date: '18/11/2026',
    tag: 'Interactive & UX',
    items: [
      'Thêm Mục lục tự động (Sticky TOC) + thanh tiến độ đọc, nút Copy khối code, Chia sẻ link và Bình luận Utterances.',
    ],
  },
  {
    version: 'v1.2',
    date: '18/11/2026',
    tag: 'Content & Tools',
    items: [
      'Thêm bài build Giáo Án Tà Đạo – Healer Hỏa Quyền Lv100 và tool CodeLoader kèm SHA-256.',
    ],
  },
  {
    version: 'v1.1',
    date: '18/11/2026',
    tag: 'Where Winds Meet',
    items: [
      'Đồng bộ 4 tài liệu Where Winds Meet từ Google Docs kèm Lightbox phóng to ảnh.',
    ],
  },
  {
    version: 'v1.0',
    date: '18/11/2026',
    tag: 'Launch',
    items: [
      'Khởi tạo Hưng’s Blog bằng Astro + TypeScript và deploy lên Cloudflare Workers Static Assets.',
    ],
  },
];
---

<BaseLayout
  title="Nhật ký cập nhật"
  description="Lịch sử cập nhật tính năng, bài viết và công cụ trên Hưng's Blog."
>
  <div class="container page-wrap">
    <section class="changelog-shell">
      <header class="cl-header">
        <span class="cat-tag">
          <span class="cat-dot cat-dot--builds" aria-hidden="true"></span>
          <span>Lịch sử phát hành</span>
        </span>
        <h1 class="cl-title">Nhật ký cập nhật</h1>
        <p class="cl-desc">Theo dõi các thay đổi về giao diện, tài liệu Where Winds Meet và công cụ trên blog.</p>
      </header>

      <div class="cl-list enter-group">
        {
          updates.map((u) => (
            <article class="surface cl-item">
              <div class="cl-meta">
                <span class="cl-ver num">{u.version}</span>
                <span class="cl-date num">{u.date}</span>
                <span class="tag-chip">{u.tag}</span>
              </div>
              <ul class="cl-points">
                {u.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .changelog-shell {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .cl-header {
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .cl-title {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .cl-desc {
    margin: 0;
    color: var(--text-secondary);
  }

  .cl-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cl-item {
    padding: var(--space-5) var(--space-6);
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }

  .cl-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
  }

  .cl-ver {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--accent-text);
  }

  .cl-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  .cl-points {
    margin: 0;
    padding-left: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .cl-points li {
    margin-bottom: var(--space-2);
  }

  .cl-points li:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 680px) {
    .cl-item {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-5);
    }

    .cl-meta {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    .cl-date {
      margin-bottom: 0;
    }
  }
</style>
