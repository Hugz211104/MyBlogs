---
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllUnifiedPosts } from '@/lib/posts';

const posts = (await getAllUnifiedPosts()).filter((p) => p.category === 'builds');
const filters = [
  { key: 'all', label: 'Tất cả' },
  { key: 'dps', label: 'DPS' },
  { key: 'healer', label: 'Healer' },
  { key: 'patch 2.4', label: 'Patch Notes' },
  { key: 'chỉ số', label: 'Chỉ số / Cơ chế' },
];
---

<BaseLayout
  title="Build game — Where Winds Meet"
  description="Khung build nhân vật, tâm pháp, chỉ số và điều chỉnh cân bằng Where Winds Meet — ngắn gọn, trực quan và có công cụ tính Hit Roll."
>
  <section class="cat-hero card">
    <div class="cat-hero-top">
      <div>
        <span class="badge badge--builds">
          <Icon name="builds" size={14} />
          <span>Builds · Where Winds Meet</span>
        </span>
        <h1 class="cat-title">Build game &amp; Cẩm nang WWM</h1>
        <p class="cat-desc">
          Tổng hợp giáo án DPS, Healer Hỏa Quyền, Patch Notes cân bằng và hệ thống chỉ số Where Winds Meet.
        </p>
        <div class="cat-count">Tổng cộng {posts.length} tài liệu</div>
      </div>

      <a href="/builds/calculator" class="calc-cta card-interactive">
        <span class="calc-cta-icon" aria-hidden="true">
          <Icon name="calculator" size={22} />
        </span>
        <div>
          <strong>Máy tính Hit Roll WWM</strong>
          <span>Test tỷ lệ Số Cam / Vàng / Xám</span>
        </div>
        <Icon name="arrow-right" size={17} class="calc-cta-arrow" />
      </a>
    </div>

    <div class="filter-bar" role="group" aria-label="Lọc bài viết theo chủ đề">
      {
        filters.map((f, idx) => (
          <button
            type="button"
            class:list={['filter-pill', { active: idx === 0 }]}
            data-filter={f.key}
          >
            {f.label}
          </button>
        ))
      }
    </div>
  </section>

  <div class="posts-grid reveal-stagger" id="builds-grid">
    {posts.map((post, idx) => <PostCard post={post} featured={idx === 0 && posts.length > 1} />)}
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = Array.from(document.querySelectorAll('.filter-pill'));
    const cards = Array.from(document.querySelectorAll('#builds-grid .post-card'));
    if (buttons.length === 0 || cards.length === 0) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = (btn.getAttribute('data-filter') || 'all').toLowerCase();
        buttons.forEach((b) => b.classList.toggle('active', b === btn));

        cards.forEach((card) => {
          if (key === 'all') {
            card.style.display = '';
            return;
          }
          const tags = (card.getAttribute('data-tags') || '').toLowerCase();
          const role = (card.getAttribute('data-role') || '').toLowerCase();
          const match = tags.includes(key) || role.includes(key);
          card.style.display = match ? '' : 'none';
        });
      });
    });
  })();
</script>

<style>
  .cat-hero {
    padding: 1.65rem 1.8rem;
    margin-bottom: 1.65rem;
    background:
      radial-gradient(ellipse 55% 90% at 95% 15%, rgba(201, 169, 110, 0.18), transparent 60%),
      radial-gradient(ellipse 45% 80% at 15% 100%, rgba(168, 85, 247, 0.12), transparent 55%),
      var(--color-surface);
  }

  .cat-hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .cat-title {
    margin: 0.75rem 0 0.4rem;
    font-size: var(--size-2xl);
    color: var(--color-text);
  }

  .cat-desc {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .cat-count {
    margin-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary-bright);
  }

  .calc-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 60px;
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-inset);
    background: linear-gradient(135deg, rgba(201, 169, 110, 0.18), rgba(168, 85, 247, 0.14));
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-gold-glow);
    transition:
      transform var(--motion-micro) var(--ease-spring),
      border-color var(--motion-micro) var(--ease-smooth);
  }

  .calc-cta:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }

  .calc-cta-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-control);
    background: rgba(201, 169, 110, 0.16);
    border: 1px solid var(--color-border-strong);
    color: var(--color-primary-bright);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .calc-cta div {
    display: flex;
    flex-direction: column;
    line-height: 1.28;
  }

  .calc-cta strong {
    font-family: var(--font-heading);
    font-size: 0.94rem;
    color: var(--color-text);
  }

  .calc-cta span {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .calc-cta-arrow {
    color: var(--color-primary-bright);
    margin-left: 0.25rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .filter-pill {
    min-height: 38px;
    padding: 0.42rem 0.95rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border);
    background: var(--color-inset);
    color: var(--color-text-muted);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--motion-micro) var(--ease-smooth),
      color var(--motion-micro) var(--ease-smooth),
      border-color var(--motion-micro) var(--ease-smooth);
  }

  .filter-pill:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .filter-pill.active {
    background: linear-gradient(135deg, #b89149, #7c3aed);
    color: #ffffff;
    border-color: transparent;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  @media (max-width: 760px) {
    .cat-hero {
      padding: 1.25rem;
    }

    .filter-pill {
      min-height: 44px;
    }
  }

  @media (max-width: 680px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
