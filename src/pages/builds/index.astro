---
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllUnifiedPosts } from '@/lib/posts';

const posts = (await getAllUnifiedPosts()).filter((p) => p.category === 'builds');
const filters = [
  { key: 'all', label: 'Tất cả' },
  { key: 'dps', label: 'DPS' },
  { key: 'healer', label: 'Healer' },
  { key: 'patch 2.4', label: 'Patch 2.4' },
  { key: 'chỉ số', label: 'Chỉ số và Cơ chế' },
];
---

<BaseLayout
  title="Build game — Where Winds Meet"
  description="Giáo án build nhân vật, tâm pháp, cơ chế chỉ số và điều chỉnh cân bằng Where Winds Meet."
>
  <div class="container page-wrap">
    <header class="builds-header">
      <div class="builds-head-top">
        <div>
          <span class="cat-tag">
            <span class="cat-dot cat-dot--builds" aria-hidden="true"></span>
            <span>Where Winds Meet</span>
          </span>
          <h1 class="builds-title">Build game và Cẩm nang WWM</h1>
          <p class="builds-desc">
            Tổng hợp giáo án DPS, Healer Hỏa Quyền, Patch Notes cân bằng và phân tích hệ thống chỉ số thực chiến.
          </p>
        </div>

        <a href="/builds/calculator" class="btn-secondary">
          <Icon name="calculator" size={16} />
          <span>Máy tính sát thương</span>
        </a>
      </div>

      <div class="builds-controls">
        <div class="filter-bar" role="group" aria-label="Lọc bài viết theo chủ đề">
          {
            filters.map((f, idx) => (
              <button
                type="button"
                class:list={['filter-tab', { active: idx === 0 }]}
                data-filter={f.key}
              >
                {f.label}
              </button>
            ))
          }
        </div>
        <span class="builds-count num">{posts.length} bài viết</span>
      </div>
    </header>

    <div class="posts-grid enter-group" id="builds-grid">
      {posts.map((post, idx) => <PostCard post={post} featured={idx === 0 && posts.length > 1} />)}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = Array.from(document.querySelectorAll('.filter-tab'));
    const cards = Array.from(document.querySelectorAll('#builds-grid .post-card'));
    if (buttons.length === 0 || cards.length === 0) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = (btn.getAttribute('data-filter') || 'all').toLowerCase();
        buttons.forEach((b) => b.classList.toggle('active', b === btn));

        cards.forEach((card) => {
          if (key === 'all') {
            card.style.display = '';
            return;
          }
          const tags = (card.getAttribute('data-tags') || '').toLowerCase();
          const role = (card.getAttribute('data-role') || '').toLowerCase();
          const match = tags.includes(key) || role.includes(key);
          card.style.display = match ? '' : 'none';
        });
      });
    });
  })();
</script>

<style>
  .builds-header {
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .builds-head-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .builds-title {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.15;
    color: var(--text-primary);
  }

  .builds-desc {
    margin: 0;
    color: var(--text-secondary);
    max-width: 60ch;
  }

  .builds-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-tab {
    height: 36px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    background-color: var(--bg-card);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 400;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .filter-tab:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .filter-tab.active {
    background-color: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    border-color: transparent;
    font-weight: 500;
  }

  .builds-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 760px) {
    .filter-tab {
      min-height: 44px;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
