---
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllUnifiedPosts } from '@/lib/posts';

const posts = (await getAllUnifiedPosts()).filter((p) => p.category === 'builds');
const filters = [
  { key: 'all', label: 'Tất cả' },
  { key: 'dps', label: 'DPS' },
  { key: 'healer', label: 'Healer' },
  { key: 'patch 2.4', label: 'Patch Notes' },
  { key: 'chỉ số', label: 'Chỉ số / Cơ chế' },
];
---

<BaseLayout
  title="Build game — Where Winds Meet"
  description="Khung build nhân vật, tâm pháp, chỉ số và điều chỉnh cân bằng Where Winds Meet — ngắn gọn, trực quan và có công cụ tính Hit Roll."
>
  <section class="cat-hero card">
    <div class="cat-hero-top">
      <div>
        <span class="badge badge--builds">🎮 Builds · Where Winds Meet</span>
        <h1 class="cat-title">Build game &amp; Cẩm nang WWM</h1>
        <p class="cat-desc">
          Tổng hợp giáo án DPS, Healer Hỏa Quyền, Patch Notes cân bằng và hệ thống chỉ số Where Winds Meet.
        </p>
        <div class="cat-count">Tổng cộng {posts.length} tài liệu</div>
      </div>

      <a href="/builds/calculator" class="calc-cta">
        <span class="calc-cta-icon">🧮</span>
        <div>
          <strong>Máy tính Hit Roll WWM</strong>
          <span>Test tỷ lệ Số Cam / Vàng / Xám</span>
        </div>
        <span class="calc-cta-arrow">→</span>
      </a>
    </div>

    <div class="filter-bar" role="group" aria-label="Lọc bài viết theo chủ đề">
      {
        filters.map((f, idx) => (
          <button
            type="button"
            class:list={['filter-pill', { active: idx === 0 }]}
            data-filter={f.key}
          >
            {f.label}
          </button>
        ))
      }
    </div>
  </section>

  <div class="posts-grid" id="builds-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = Array.from(document.querySelectorAll('.filter-pill'));
    const cards = Array.from(document.querySelectorAll('#builds-grid .post-card'));
    if (buttons.length === 0 || cards.length === 0) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = (btn.getAttribute('data-filter') || 'all').toLowerCase();
        buttons.forEach((b) => b.classList.toggle('active', b === btn));

        cards.forEach((card) => {
          if (key === 'all') {
            card.style.display = '';
            return;
          }
          const tags = (card.getAttribute('data-tags') || '').toLowerCase();
          const role = (card.getAttribute('data-role') || '').toLowerCase();
          const match = tags.includes(key) || role.includes(key);
          card.style.display = match ? '' : 'none';
        });
      });
    });
  })();
</script>

<style>
  .cat-hero {
    padding: 1.55rem 1.7rem;
    margin-bottom: 1.65rem;
    background:
      radial-gradient(circle at 90% 20%, rgba(139, 92, 246, 0.2), transparent 48%),
      var(--bg-card);
  }

  .cat-hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .cat-title {
    margin: 0.7rem 0 0.4rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
  }

  .cat-desc {
    margin: 0;
    color: var(--text-muted);
    max-width: 60ch;
  }

  .cat-count {
    margin-top: 0.75rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .calc-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 1.1rem;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.24), rgba(168, 85, 247, 0.14));
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-glow);
    transition: transform 0.16s ease, border-color 0.16s ease;
  }

  .calc-cta:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .calc-cta-icon {
    font-size: 1.6rem;
  }

  .calc-cta div {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .calc-cta strong {
    font-size: 0.94rem;
    color: var(--text);
  }

  .calc-cta span {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .calc-cta-arrow {
    font-weight: 700;
    color: var(--accent-text);
    margin-left: 0.35rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .filter-pill {
    padding: 0.42rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-pill);
    color: var(--text-muted);
    font-size: 0.83rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }

  .filter-pill:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .filter-pill.active {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #ffffff;
    border-color: transparent;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }

  @media (max-width: 960px) {
    .posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
