---
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllUnifiedPosts, getPopularTags } from '@/lib/posts';
import { SITE } from '@/lib/site';

const allPosts = await getAllUnifiedPosts();
const latestPosts = allPosts.slice(0, 9);
const popularTags = getPopularTags(allPosts, 8);
const totalMinutes = allPosts.reduce((sum, post) => sum + post.readingMinutes, 0);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <!-- Hero Banner -->
  <section class="hero card">
    <img src="/images/hero-banner.jpg" alt="" class="hero-bg" fetchpriority="high" />
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <h1 class="hero-title">
        Chào mừng đến với
        <span class="hero-highlight">{SITE.title}!</span>
      </h1>
      <p class="hero-subtitle">
        Một góc nhỏ chia sẻ về lập trình, build game, công nghệ và những dự án cá nhân của mình ✨
      </p>
      <div class="hero-cta-row">
        <a href="#latest-posts" class="btn-primary">
          Khám phá ngay <span aria-hidden="true">→</span>
        </a>
        <div class="hero-quick-links">
          <a href="/tips" class="quick-pill">Tips dự án</a>
          <a href="/builds" class="quick-pill">Build game</a>
          <a href="/tools" class="quick-pill">Tools</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content + Sidebar -->
  <div class="home-layout" id="latest-posts">
    <section class="home-main">
      <div class="section-heading">
        <h2 class="section-title">Bài viết mới nhất</h2>
        <div class="section-cats">
          <a href="/tips" class="section-link">Tips</a>
          <a href="/builds" class="section-link">Builds</a>
          <a href="/tools" class="section-link">Tools →</a>
        </div>
      </div>

      <div class="latest-grid">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <aside class="home-sidebar" aria-label="Thông tin thêm">
      <!-- About Me -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <span class="sidebar-icon" aria-hidden="true">👤</span>
          Về tôi
        </h2>
        <div class="about-row">
          <img src="/favicon.svg" alt={SITE.author} width="54" height="54" class="about-avatar" />
          <p class="about-text">{SITE.about}</p>
        </div>
        <blockquote class="about-quote">“{SITE.quote}”</blockquote>
      </section>

      <!-- Popular Tags -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <span class="sidebar-icon" aria-hidden="true">🏷️</span>
          Thẻ phổ biến
        </h2>
        <div class="tag-cloud">
          {
            popularTags.map((tag) => (
              <button type="button" class="tag-pill tag-search-btn" data-tag={tag}>
                {tag}
              </button>
            ))
          }
        </div>
      </section>

      <!-- Quick Stats -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <span class="sidebar-icon" aria-hidden="true">📊</span>
          Thống kê nhanh
        </h2>
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-value">{allPosts.length}</span>
            <span class="stat-label">Bài viết</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">~{totalMinutes}</span>
            <span class="stat-label">phút đọc</span>
          </div>
        </div>
        <div class="stats-thanks">💜 Cảm ơn bạn đã ghé thăm!</div>
      </section>
    </aside>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    document.querySelectorAll('.tag-search-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || '';
        const modal = document.getElementById('search-modal');
        const input = document.getElementById('search-input');
        if (!modal || !input || typeof modal.showModal !== 'function') return;
        modal.showModal();
        input.value = tag;
        input.dispatchEvent(new Event('input'));
        setTimeout(() => input.focus(), 20);
      });
    });
  })();
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 290px;
    display: flex;
    align-items: center;
    padding: 2.25rem 2.4rem;
    margin-bottom: 2rem;
    border-radius: 20px;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      95deg,
      rgba(17, 13, 30, 0.96) 0%,
      rgba(22, 17, 40, 0.88) 44%,
      rgba(22, 17, 40, 0.35) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 530px;
    color: #f8f7ff;
  }

  .hero-title {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 3.6vw, 2.55rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.025em;
  }

  .hero-highlight {
    display: block;
    background: linear-gradient(90deg, #c084fc, #818cf8);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    margin: 0 0 1.45rem;
    font-size: 0.98rem;
    color: #d7d2ee;
    line-height: 1.6;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .quick-pill {
    padding: 0.48rem 0.85rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    color: #e9e4ff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    transition: background-color 0.18s ease;
  }

  .quick-pill:hover {
    background: rgba(139, 92, 246, 0.35);
  }

  /* Two-column layout */
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1.5rem;
    align-items: start;
  }

  .section-cats {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.05rem;
  }

  /* Sidebar */
  .home-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-card {
    padding: 1.15rem 1.2rem;
  }

  .sidebar-heading {
    margin: 0 0 0.85rem;
    font-size: 0.98rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
  }

  .sidebar-icon {
    font-size: 1rem;
  }

  .about-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .about-avatar {
    border-radius: 14px;
    flex-shrink: 0;
    border: 1px solid var(--border-strong);
  }

  .about-text {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .about-quote {
    margin: 0.95rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    font-style: italic;
    font-size: 0.83rem;
    color: var(--text-subtle);
    text-align: center;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag-search-btn {
    cursor: pointer;
    font-family: inherit;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  .stat-item {
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    background: var(--bg-pill);
    border: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .stat-value {
    font-weight: 750;
    font-size: 1.05rem;
    color: var(--accent-text);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .stats-thanks {
    margin-top: 0.75rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  @media (max-width: 1060px) {
    .home-layout {
      grid-template-columns: 1fr;
    }

    .home-sidebar {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .latest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-sidebar {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .hero {
      padding: 1.65rem 1.35rem;
      min-height: 240px;
    }

    .latest-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
