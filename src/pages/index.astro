---
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllUnifiedPosts, getPopularTags } from '@/lib/posts';
import { SITE } from '@/lib/site';

const allPosts = await getAllUnifiedPosts();
const latestPosts = allPosts.slice(0, 9);
const popularTags = getPopularTags(allPosts, 8);
const totalMinutes = allPosts.reduce((sum, post) => sum + post.readingMinutes, 0);

const categoryCounts = {
  tips: allPosts.filter((p) => p.category === 'tips').length,
  builds: allPosts.filter((p) => p.category === 'builds').length,
  tools: allPosts.filter((p) => p.category === 'tools').length,
};
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <!-- Asymmetric Bento Hero Section -->
  <section class="hero-bento reveal-stagger" aria-label="Nổi bật">
    <a
      href="#latest-posts"
      class="hero-banner-card card card-interactive"
      aria-label="Chào mừng đến với Hưng's Blog! Khám phá ngay"
    >
      <img
        src="/images/hero/hero-banner.webp"
        alt="Chào mừng đến với Hưng's Blog! Một góc nhỏ chia sẻ về lập trình, game, công nghệ và những dự án cá nhân của mình"
        class="hero-banner-img"
        fetchpriority="high"
      />
    </a>

    <div class="hero-side-stack">
      <a href="/builds/calculator" class="bento-calc card card-interactive">
        <div class="bento-calc-top">
          <span class="badge badge--builds">
            <Icon name="builds" size={13} />
            <span>Where Winds Meet</span>
          </span>
          <span class="bento-calc-icon" aria-hidden="true">
            <Icon name="calculator" size={20} />
          </span>
        </div>
        <h2 class="bento-calc-title">Máy tính Hit Roll WWM</h2>
        <p class="bento-calc-desc">
          Mô phỏng tỷ lệ Số Cam (Affinity), Số Vàng (Crit) &amp; Số Xám theo Resistance Boss Lv100.
        </p>
        <span class="bento-calc-cta">
          <span>Mở bộ mô phỏng</span>
          <Icon name="arrow-right" size={15} />
        </span>
      </a>

      <div class="bento-dir card">
        <div class="bento-dir-head">
          <span>Khám phá chuyên mục</span>
          <span class="bento-dir-total">{allPosts.length} bài</span>
        </div>
        <div class="bento-dir-links">
          <a href="/tips" class="bento-dir-link">
            <Icon name="tips" size={16} />
            <span>Tips</span>
            <span class="bento-dir-count">{categoryCounts.tips}</span>
          </a>
          <a href="/builds" class="bento-dir-link">
            <Icon name="builds" size={16} />
            <span>Builds</span>
            <span class="bento-dir-count">{categoryCounts.builds}</span>
          </a>
          <a href="/tools" class="bento-dir-link">
            <Icon name="tools" size={16} />
            <span>Tools</span>
            <span class="bento-dir-count">{categoryCounts.tools}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content + Sidebar -->
  <div class="home-layout" id="latest-posts">
    <section class="home-main">
      <div class="section-heading">
        <h2 class="section-title">Bài viết mới nhất</h2>
        <div class="section-cats">
          <a href="/tips" class="section-link">Tips</a>
          <a href="/builds" class="section-link">Builds</a>
          <a href="/tools" class="section-link">
            <span>Tools</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      <div class="latest-grid reveal-stagger">
        {latestPosts.map((post, idx) => <PostCard post={post} featured={idx === 0} />)}
      </div>

      <!-- Interactive Highlights & Creator Channels -->
      <section class="spotlight-section">
        <div class="section-heading">
          <h2 class="section-title">Tiện ích &amp; Kênh sáng tạo</h2>
          <a href="/changelog" class="section-link">
            <span>Nhật ký cập nhật</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <div class="spotlight-grid reveal-stagger">
          <a href="/builds/calculator" class="card card-interactive spot-card spot-card--calc">
            <span class="spot-icon-box spot-icon-box--gold" aria-hidden="true">
              <Icon name="calculator" size={20} />
            </span>
            <div>
              <h3>Máy tính Hit Roll WWM</h3>
              <p>Nhập Precision, Crit, Affinity &amp; cấp Resistance để mô phỏng tỷ lệ Số Cam / Vàng / Xám.</p>
            </div>
          </a>

          <a
            href={SITE.socials.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="card card-interactive spot-card spot-card--yt"
          >
            <span class="spot-icon-box spot-icon-box--violet" aria-hidden="true">
              <Icon name="youtube" size={20} />
            </span>
            <div>
              <h3>YouTube · @MUSICandANIMEVN</h3>
              <p>Góc nhạc, anime và video chia sẻ giải trí — ghé ủng hộ một lượt đăng ký nhé.</p>
            </div>
          </a>

          <a
            href={SITE.socials.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            class="card card-interactive spot-card spot-card--tt"
          >
            <span class="spot-icon-box spot-icon-box--cyan" aria-hidden="true">
              <Icon name="tiktok" size={20} />
            </span>
            <div>
              <h3>TikTok · @cachephoabruh1</h3>
              <p>Highlight ngắn, meme game và những khoảnh khắc Where Winds Meet hằng ngày.</p>
            </div>
          </a>
        </div>
      </section>
    </section>

    <aside class="home-sidebar" aria-label="Thông tin thêm">
      <!-- About Me -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <Icon name="user" size={16} class="sidebar-icon" />
          <span>Về tôi</span>
        </h2>
        <div class="about-row">
          <img
            src="/images/brand/profile-avatar.webp"
            alt={`Ảnh đại diện của ${SITE.author}`}
            width="60"
            height="60"
            class="about-avatar"
          />
          <p class="about-text">{SITE.about}</p>
        </div>
        <blockquote class="about-quote">“{SITE.quote}”</blockquote>
        <div class="about-socials">
          <a href={SITE.socials.youtube} target="_blank" rel="noopener noreferrer" class="about-social-pill">
            <Icon name="youtube" size={14} />
            <span>YouTube</span>
          </a>
          <a href={SITE.socials.tiktok} target="_blank" rel="noopener noreferrer" class="about-social-pill">
            <Icon name="tiktok" size={14} />
            <span>TikTok</span>
          </a>
          <a href={SITE.socials.discord} target="_blank" rel="noopener noreferrer" class="about-social-pill">
            <Icon name="discord" size={14} />
            <span>Discord</span>
          </a>
          <a href={SITE.socials.github} target="_blank" rel="noopener noreferrer" class="about-social-pill">
            <Icon name="github" size={14} />
            <span>GitHub</span>
          </a>
        </div>
      </section>

      <!-- Categories -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <Icon name="folder" size={16} class="sidebar-icon" />
          <span>Danh mục</span>
        </h2>
        <div class="cat-list">
          <a href="/tips" class="cat-item">
            <span class="cat-icon-badge cat-icon-badge--tips" aria-hidden="true">
              <Icon name="tips" size={16} />
            </span>
            <div class="cat-meta">
              <span class="cat-name">Tips</span>
              <span class="cat-sub">Mẹo &amp; thủ thuật ({categoryCounts.tips})</span>
            </div>
            <Icon name="chevron-right" size={16} class="cat-arrow" />
          </a>

          <a href="/builds" class="cat-item">
            <span class="cat-icon-badge cat-icon-badge--builds" aria-hidden="true">
              <Icon name="builds" size={16} />
            </span>
            <div class="cat-meta">
              <span class="cat-name">Builds</span>
              <span class="cat-sub">Where Winds Meet ({categoryCounts.builds})</span>
            </div>
            <Icon name="chevron-right" size={16} class="cat-arrow" />
          </a>

          <a href="/tools" class="cat-item">
            <span class="cat-icon-badge cat-icon-badge--tools" aria-hidden="true">
              <Icon name="tools" size={16} />
            </span>
            <div class="cat-meta">
              <span class="cat-name">Tools</span>
              <span class="cat-sub">Công cụ hữu ích ({categoryCounts.tools})</span>
            </div>
            <Icon name="chevron-right" size={16} class="cat-arrow" />
          </a>

          <a href="/builds/calculator" class="cat-item">
            <span class="cat-icon-badge cat-icon-badge--calc" aria-hidden="true">
              <Icon name="calculator" size={16} />
            </span>
            <div class="cat-meta">
              <span class="cat-name">Hit Roll Calc</span>
              <span class="cat-sub">Tính chỉ số WWM</span>
            </div>
            <Icon name="chevron-right" size={16} class="cat-arrow" />
          </a>
        </div>
      </section>

      <!-- Popular Tags -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <Icon name="tag" size={16} class="sidebar-icon" />
          <span>Thẻ phổ biến</span>
        </h2>
        <div class="tag-cloud">
          {
            popularTags.map((tag) => (
              <button type="button" class="tag-pill tag-search-btn" data-tag={tag}>
                {tag}
              </button>
            ))
          }
        </div>
      </section>

      <!-- Quick Stats -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <Icon name="chart" size={16} class="sidebar-icon" />
          <span>Thống kê nhanh</span>
        </h2>
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-value">{allPosts.length}</span>
            <span class="stat-label">Bài viết</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">~{totalMinutes}</span>
            <span class="stat-label">phút đọc</span>
          </div>
        </div>
        <div class="stats-thanks">
          <span>Cảm ơn bạn đã ghé thăm!</span>
          <a href="/changelog" class="stats-cl-link">
            <span>Changelog</span>
            <Icon name="arrow-right" size={13} />
          </a>
        </div>
      </section>
    </aside>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    document.querySelectorAll('.tag-search-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || '';
        const modal = document.getElementById('search-modal');
        const input = document.getElementById('search-input');
        if (!modal || !input || typeof modal.showModal !== 'function') return;
        modal.showModal();
        input.value = tag;
        input.dispatchEvent(new Event('input'));
        setTimeout(() => input.focus(), 20);
      });
    });
  })();
</script>

<style>
  /* Asymmetric Hero Bento */
  .hero-bento {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(290px, 0.85fr);
    gap: 1.1rem;
    align-items: stretch;
    margin-bottom: 2.2rem;
  }

  .hero-banner-card {
    display: flex;
    align-items: center;
    overflow: hidden;
    border-radius: var(--radius-shell);
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-glass);
  }

  .hero-banner-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-side-stack {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }

  .bento-calc {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    background:
      radial-gradient(ellipse 90% 80% at 100% 0%, rgba(168, 85, 247, 0.16), transparent 62%),
      radial-gradient(ellipse 70% 70% at 0% 100%, rgba(201, 169, 110, 0.14), transparent 58%),
      var(--color-surface);
  }

  .bento-calc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .bento-calc-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-control);
    background: rgba(201, 169, 110, 0.15);
    border: 1px solid var(--color-border-strong);
    color: var(--color-primary-bright);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .bento-calc-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .bento-calc-desc {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .bento-calc-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.84rem;
    font-weight: 650;
    color: var(--color-primary-bright);
  }

  .bento-dir {
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .bento-dir-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .bento-dir-total {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-primary-bright);
  }

  .bento-dir-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .bento-dir-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-height: 62px;
    padding: 0.5rem 0.4rem;
    border-radius: var(--radius-inset);
    background: var(--color-inset);
    border: 1px solid var(--color-border);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition:
      border-color var(--motion-micro) var(--ease-smooth),
      color var(--motion-micro) var(--ease-smooth),
      background-color var(--motion-micro) var(--ease-smooth);
  }

  .bento-dir-link:hover {
    border-color: var(--color-border-strong);
    color: var(--color-primary-bright);
    background: rgba(201, 169, 110, 0.12);
  }

  .bento-dir-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-subtle);
  }

  /* Two-column editorial layout */
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 1.5rem;
    align-items: start;
  }

  .section-cats {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .spotlight-section {
    margin-top: 2.35rem;
  }

  .spotlight-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 1rem;
  }

  .spot-card {
    padding: 1.15rem;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .spot-icon-box {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-control);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }

  .spot-icon-box--gold {
    background: var(--badge-builds-bg);
    border-color: var(--badge-builds-border);
    color: var(--badge-builds-text);
  }

  .spot-icon-box--violet {
    background: rgba(168, 85, 247, 0.14);
    border-color: var(--color-border-violet);
    color: var(--color-secondary);
  }

  .spot-icon-box--cyan {
    background: var(--badge-tips-bg);
    border-color: var(--badge-tips-border);
    color: var(--badge-tips-text);
  }

  .spot-card h3 {
    margin: 0 0 0.3rem;
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .spot-card p {
    margin: 0;
    font-size: 0.81rem;
    line-height: 1.52;
    color: var(--color-text-muted);
  }

  .spot-card--calc:hover {
    border-color: var(--color-border-strong);
  }

  .spot-card--yt:hover {
    border-color: var(--color-border-violet);
  }

  .spot-card--tt:hover {
    border-color: var(--badge-tips-border);
  }

  /* Sticky Sidebar */
  .home-sidebar {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-card {
    padding: 1.2rem;
  }

  .sidebar-heading {
    margin: 0 0 0.9rem;
    font-size: 0.98rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
  }

  .sidebar-icon {
    color: var(--color-primary);
  }

  .about-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .about-avatar {
    border-radius: var(--radius-pill);
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--color-primary);
    box-shadow: var(--shadow-gold-glow);
  }

  .about-text {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.52;
  }

  .about-quote {
    margin: 0.95rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-style: italic;
    font-size: 0.83rem;
    color: var(--color-text-subtle);
    text-align: center;
  }

  .about-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 0.9rem;
  }

  .about-social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    min-height: 36px;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    font-size: 0.76rem;
    font-weight: 600;
    background: var(--color-inset);
    border: 1px solid var(--color-border);
    color: var(--color-primary-bright);
    transition:
      border-color var(--motion-micro) var(--ease-smooth),
      background-color var(--motion-micro) var(--ease-smooth);
  }

  .about-social-pill:hover {
    border-color: var(--color-border-strong);
    background: rgba(201, 169, 110, 0.14);
  }

  .cat-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .cat-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 50px;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-inset);
    background: var(--color-inset);
    border: 1px solid var(--color-border);
    transition:
      border-color var(--motion-micro) var(--ease-smooth),
      background-color var(--motion-micro) var(--ease-smooth);
  }

  .cat-item:hover {
    border-color: var(--color-border-strong);
    background: rgba(201, 169, 110, 0.1);
  }

  .cat-icon-badge {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-tight);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cat-icon-badge--tips {
    background: var(--badge-tips-bg);
    color: var(--badge-tips-text);
  }

  .cat-icon-badge--builds {
    background: var(--badge-builds-bg);
    color: var(--badge-builds-text);
  }

  .cat-icon-badge--tools {
    background: var(--badge-tools-bg);
    color: var(--badge-tools-text);
  }

  .cat-icon-badge--calc {
    background: rgba(168, 85, 247, 0.16);
    color: var(--color-secondary);
  }

  .cat-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .cat-name {
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--color-text);
  }

  .cat-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .cat-arrow {
    margin-left: auto;
    color: var(--color-text-subtle);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag-search-btn {
    cursor: pointer;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  .stat-item {
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-control);
    background: var(--color-inset);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .stat-value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-primary-bright);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .stats-thanks {
    margin-top: 0.8rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .stats-cl-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-primary-bright);
  }

  .stats-cl-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

