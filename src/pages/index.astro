---
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllUnifiedPosts, getPopularTags } from '@/lib/posts';
import { SITE } from '@/lib/site';

const allPosts = await getAllUnifiedPosts();
const latestPosts = allPosts.slice(0, 9);
const popularTags = getPopularTags(allPosts, 8);
const totalMinutes = allPosts.reduce((sum, post) => sum + post.readingMinutes, 0);

const categoryCounts = {
  tips: allPosts.filter((p) => p.category === 'tips').length,
  builds: allPosts.filter((p) => p.category === 'builds').length,
  tools: allPosts.filter((p) => p.category === 'tools').length,
};
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <!-- Hero Stage (Seamless Warm Ink Scene + Live Calculator Preview) -->
  <section class="hero-stage" aria-label="Giới thiệu">
    <div class="hero-backdrop" aria-hidden="true">
      <img
        src="/images/hero/hero-unslop-scene.jpg"
        alt=""
        class="hero-scene-img"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-mask"></div>
    </div>

    <div class="container hero-inner">
      <div class="hero-copy enter-group">
        <p class="hero-eyebrow">{SITE.subtitle}</p>
        <h1 class="hero-title">Ghi chú build đồ, cơ chế sát thương và tool tự viết</h1>
        <p class="hero-sub">
          Tổng hợp giáo án thực chiến Where Winds Meet, bộ tính sát thương Ba Đường Ray và các tiện ích Windows nhỏ gọn.
        </p>

        <div class="hero-actions">
          <a href="#latest-posts" class="hero-btn-primary">Đọc bài mới nhất</a>
          <a href="/builds/calculator" class="hero-btn-secondary">
            <span>Mở máy tính sát thương</span>
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>

      <!-- Product Preview Rising From Bottom Edge (Real Lv.100 Verified Numbers) -->
      <a href="/builds/calculator" class="hero-preview" aria-label="Xem trước Máy tính Sát Thương và Hit Roll WWM">
        <div class="preview-bar">
          <div class="preview-title-group">
            <span class="preview-dot" aria-hidden="true"></span>
            <span class="preview-title">Mô phỏng Raid Lv.100 · Minh Kim · Ảnh</span>
          </div>
          <span class="preview-meta num">Kháng Phán Định 85% · DEF 498</span>
        </div>

        <div class="preview-hitbar" aria-hidden="true">
          <span class="ph-seg ph-aff" style="width: 45%"></span>
          <span class="ph-seg ph-crit" style="width: 55%"></span>
        </div>

        <div class="preview-metrics">
          <div class="pm-item">
            <span class="pm-lbl">Hội Ý (Cam · 45.0%)</span>
            <strong class="pm-val num">40,600</strong>
          </div>
          <div class="pm-item">
            <span class="pm-lbl">Chí Mạng TB (Vàng · 55.0%)</span>
            <strong class="pm-val num">28,292</strong>
          </div>
          <div class="pm-item">
            <span class="pm-lbl">Kỳ vọng mỗi đòn</span>
            <strong class="pm-val pm-val--accent num">33,831</strong>
          </div>
          <div class="pm-item">
            <span class="pm-lbl">Tỉ lệ Sàn/Trần r</span>
            <strong class="pm-val num">44.0%</strong>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- Main Editorial Layout + Sidebar -->
  <div class="container home-body" id="latest-posts">
    <div class="home-layout">
      <div class="home-main">
        <div class="section-head">
          <h2 class="section-heading">Bài viết mới nhất</h2>
          <div class="section-links">
            <a href="/tips" class="section-action">Tips</a>
            <a href="/builds" class="section-action">Builds</a>
            <a href="/tools" class="section-action">
              <span>Tools</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>

        <div class="latest-grid enter-group">
          {latestPosts.map((post, idx) => <PostCard post={post} featured={idx === 0} />)}
        </div>

        <section class="channels-section" aria-label="Tiện ích và kênh liên kết">
          <div class="section-head">
            <h2 class="section-heading">Công cụ và kênh sáng tạo</h2>
            <a href="/changelog" class="section-action">
              <span>Nhật ký cập nhật</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </div>

          <div class="channels-grid">
            <a href="/builds/calculator" class="surface surface-interactive ch-card">
              <div class="ch-head">
                <span class="ch-num num">01</span>
                <Icon name="arrow-right" size={16} class="ch-arrow" />
              </div>
              <h3>Máy tính Hit Roll &amp; Sát thương WWM</h3>
              <p>Mô phỏng Ba Đường Ray, Xuyên Giáp, ngưỡng pha Tràn Hội Ý và la bàn ưu tiên chỉ số.</p>
            </a>

            <a
              href={SITE.socials.youtube}
              target="_blank"
              rel="noopener noreferrer"
              class="surface surface-interactive ch-card"
            >
              <div class="ch-head">
                <span class="ch-num num">02</span>
                <Icon name="arrow-right" size={16} class="ch-arrow" />
              </div>
              <h3>YouTube · @MUSICandANIMEVN</h3>
              <p>Video hướng dẫn tool, nhạc và nội dung giải trí trên kênh cá nhân.</p>
            </a>

            <a
              href={SITE.socials.tiktok}
              target="_blank"
              rel="noopener noreferrer"
              class="surface surface-interactive ch-card"
            >
              <div class="ch-head">
                <span class="ch-num num">03</span>
                <Icon name="arrow-right" size={16} class="ch-arrow" />
              </div>
              <h3>TikTok · @cachephoabruh1</h3>
              <p>Clip ngắn và những khoảnh khắc chơi Where Winds Meet hằng ngày.</p>
            </a>
          </div>
        </section>
      </div>

      <aside class="home-sidebar" aria-label="Thông tin blog">
        <section class="surface side-card">
          <h2 class="side-heading">Tác giả</h2>
          <div class="about-row">
            <img
              src="/images/brand/profile-avatar.webp"
              alt={`Ảnh đại diện của ${SITE.author}`}
              width="52"
              height="52"
              class="about-avatar"
            />
            <p class="about-text">{SITE.about}</p>
          </div>
          <p class="about-quote">{SITE.quote}</p>

          <div class="side-list" role="list">
            <a href={SITE.socials.youtube} target="_blank" rel="noopener noreferrer" class="side-row">
              <Icon name="youtube" size={16} />
              <span>YouTube</span>
              <span class="side-row-meta">@MUSICandANIMEVN</span>
            </a>
            <a href={SITE.socials.tiktok} target="_blank" rel="noopener noreferrer" class="side-row">
              <Icon name="tiktok" size={16} />
              <span>TikTok</span>
              <span class="side-row-meta">@cachephoabruh1</span>
            </a>
            <a href={SITE.socials.discord} target="_blank" rel="noopener noreferrer" class="side-row">
              <Icon name="discord" size={16} />
              <span>Discord</span>
              <span class="side-row-meta">Tham gia</span>
            </a>
            <a href={SITE.socials.github} target="_blank" rel="noopener noreferrer" class="side-row">
              <Icon name="github" size={16} />
              <span>GitHub</span>
              <span class="side-row-meta">Mã nguồn</span>
            </a>
          </div>
        </section>

        <section class="surface side-card">
          <h2 class="side-heading">Chuyên mục</h2>
          <div class="side-list">
            <a href="/tips" class="side-row">
              <Icon name="tips" size={16} />
              <span>Tips kỹ thuật</span>
              <span class="side-row-meta num">{categoryCounts.tips}</span>
            </a>
            <a href="/builds" class="side-row">
              <Icon name="builds" size={16} />
              <span>Build WWM</span>
              <span class="side-row-meta num">{categoryCounts.builds}</span>
            </a>
            <a href="/tools" class="side-row">
              <Icon name="tools" size={16} />
              <span>Tiện ích Windows</span>
              <span class="side-row-meta num">{categoryCounts.tools}</span>
            </a>
            <a href="/builds/calculator" class="side-row">
              <Icon name="calculator" size={16} />
              <span>Máy tính Sát thương</span>
              <span class="side-row-meta">v2</span>
            </a>
          </div>
        </section>

        <section class="surface side-card">
          <h2 class="side-heading">Chủ đề phổ biến</h2>
          <div class="tag-cloud">
            {
              popularTags.map((tag) => (
                <button type="button" class="tag-chip tag-search-btn" data-tag={tag}>
                  {tag}
                </button>
              ))
            }
          </div>
        </section>

        <section class="surface side-card">
          <h2 class="side-heading">Lưu trữ</h2>
          <div class="stats-pair">
            <div class="stat-col">
              <strong class="stat-num num">{allPosts.length}</strong>
              <span class="stat-lbl">Bài đã đăng</span>
            </div>
            <div class="stat-col">
              <strong class="stat-num num">{totalMinutes}</strong>
              <span class="stat-lbl">Phút đọc tổng</span>
            </div>
          </div>
          <a href="/changelog" class="changelog-link">
            <span>Xem lịch sử cập nhật</span>
            <Icon name="chevron-right" size={16} />
          </a>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    document.querySelectorAll('.tag-search-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || '';
        const modal = document.getElementById('search-modal');
        const input = document.getElementById('search-input');
        if (!modal || !input || typeof modal.showModal !== 'function') return;
        modal.showModal();
        input.value = tag;
        input.dispatchEvent(new Event('input'));
        setTimeout(() => input.focus(), 20);
      });
    });
  })();
</script>

<style>
  /* Hero Stage (Always warm dark #161513 ink surface so still-life artwork blends edge-to-edge) */
  .hero-stage {
    position: relative;
    background-color: #161513;
    color: #efe9de;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-scene-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
    display: block;
  }

  .hero-mask {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #161513 0%, #161513 42%, rgba(22, 21, 19, 0.25) 75%, rgba(22, 21, 19, 0.1) 100%),
      linear-gradient(180deg, rgba(22, 21, 19, 0.45) 0%, transparent 25%, rgba(22, 21, 19, 0.72) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: var(--space-16);
    padding-bottom: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .hero-copy {
    max-width: 600px;
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #8a847a;
  }

  .hero-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: #efe9de;
  }

  .hero-sub {
    margin: 0 0 var(--space-6);
    font-size: 1.125rem;
    line-height: 1.6;
    color: #aaa398;
    max-width: 34rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-control);
    background-color: #efe9de;
    color: #12110f;
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .hero-btn-primary:hover {
    opacity: 0.9;
  }

  .hero-btn-primary:active {
    transform: scale(0.98);
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-control);
    border: 1px solid rgba(239, 233, 222, 0.14);
    background-color: rgba(28, 26, 24, 0.85);
    color: #efe9de;
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .hero-btn-secondary:hover {
    border-color: rgba(239, 233, 222, 0.28);
    background-color: #262421;
  }

  /* Live Preview Rising From Bottom Edge */
  .hero-preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 680px;
    padding: var(--space-4) var(--space-5);
    background-color: #1c1a18;
    border: 1px solid rgba(239, 233, 222, 0.12);
    border-bottom: none;
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    color: #efe9de;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .hero-preview:hover {
    background-color: #22201d;
    border-color: rgba(239, 233, 222, 0.2);
  }

  .preview-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .preview-title-group {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .preview-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: #c8964b;
  }

  .preview-title {
    font-size: var(--text-xs);
    font-weight: 500;
    color: #efe9de;
  }

  .preview-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: #8a847a;
  }

  .preview-hitbar {
    height: 6px;
    border-radius: var(--radius-tag);
    overflow: hidden;
    display: flex;
    gap: 2px;
    background-color: #262421;
  }

  .ph-seg {
    height: 100%;
    display: block;
  }

  .ph-aff {
    background-color: #d97736;
  }

  .ph-crit {
    background-color: #d6a65c;
  }

  .preview-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .pm-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pm-lbl {
    font-size: 12px;
    color: #8a847a;
  }

  .pm-val {
    font-size: 1.25rem;
    font-weight: 500;
    color: #efe9de;
  }

  .pm-val--accent {
    color: #d6a65c;
  }

  /* Main Layout */
  .home-body {
    padding-top: var(--space-10);
  }

  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 272px;
    gap: var(--space-8);
    align-items: start;
  }

  .section-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .channels-section {
    margin-top: var(--space-12);
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .ch-card {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ch-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  .ch-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-text);
  }

  .ch-card h3 {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-primary);
  }

  .ch-card p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Quiet Editorial Sidebar */
  .home-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .side-card {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .side-heading {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
  }

  .about-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .about-avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-control);
    object-fit: cover;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .about-text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .about-quote {
    margin: 0;
    padding: var(--space-2) 0 var(--space-3);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .side-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .side-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 36px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-control);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .side-row :global(.ui-icon) {
    color: var(--text-muted);
  }

  .side-row:hover {
    color: var(--text-primary);
    background-color: var(--bg-raised);
  }

  .side-row-meta {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-search-btn {
    cursor: pointer;
  }

  .stats-pair {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .stat-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-num {
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--text-primary);
  }

  .stat-lbl {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .changelog-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-control);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .changelog-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-raised);
  }

  @media (max-width: 1020px) {
    .home-layout {
      grid-template-columns: 1fr;
    }

    .home-sidebar {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .channels-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .hero-inner {
      padding-top: var(--space-10);
      gap: var(--space-8);
    }

    .hero-mask {
      background: linear-gradient(180deg, #161513 0%, rgba(22, 21, 19, 0.85) 55%, rgba(22, 21, 19, 0.92) 100%);
    }

    .preview-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .latest-grid,
    .home-sidebar {
      grid-template-columns: 1fr;
    }

    .side-row,
    .changelog-link,
    .tag-search-btn {
      min-height: 44px;
    }
  }
</style>
