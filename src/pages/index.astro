---
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllUnifiedPosts, getPopularTags } from '@/lib/posts';
import { SITE } from '@/lib/site';

const allPosts = await getAllUnifiedPosts();
const latestPosts = allPosts.slice(0, 9);
const popularTags = getPopularTags(allPosts, 8);
const totalMinutes = allPosts.reduce((sum, post) => sum + post.readingMinutes, 0);

const categoryCounts = {
  tips: allPosts.filter((p) => p.category === 'tips').length,
  builds: allPosts.filter((p) => p.category === 'builds').length,
  tools: allPosts.filter((p) => p.category === 'tools').length,
};
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <!-- Hero Banner -->
  <section class="hero-section">
    <a href="#latest-posts" class="hero-banner-card card" aria-label="Chào mừng đến với Hưng's Blog! Khám phá ngay">
      <img
        src="/images/hero/hero-banner.webp"
        alt="Chào mừng đến với Hưng's Blog! Một góc nhỏ chia sẻ về lập trình, game, công nghệ và những dự án cá nhân của mình"
        class="hero-banner-img"
        fetchpriority="high"
      />
    </a>
  </section>

  <!-- Main Content + Sidebar -->
  <div class="home-layout" id="latest-posts">
    <section class="home-main">
      <div class="section-heading">
        <h2 class="section-title">Bài viết mới nhất</h2>
        <div class="section-cats">
          <a href="/tips" class="section-link">Tips</a>
          <a href="/builds" class="section-link">Builds</a>
          <a href="/tools" class="section-link">Tools →</a>
        </div>
      </div>

      <div class="latest-grid">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <aside class="home-sidebar" aria-label="Thông tin thêm">
      <!-- About Me -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <span class="sidebar-icon" aria-hidden="true">👤</span>
          Về tôi
        </h2>
        <div class="about-row">
          <img
            src="/images/brand/profile-avatar.webp"
            alt={SITE.author}
            width="60"
            height="60"
            class="about-avatar"
          />
          <p class="about-text">{SITE.about}</p>
        </div>
        <blockquote class="about-quote">“{SITE.quote}”</blockquote>
      </section>

      <!-- Categories -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <span class="sidebar-icon" aria-hidden="true">📂</span>
          Danh mục
        </h2>
        <div class="cat-list">
          <a href="/tips" class="cat-item">
            <span class="cat-icon">💡</span>
            <div class="cat-meta">
              <span class="cat-name">Tips</span>
              <span class="cat-sub">Mẹo &amp; thủ thuật ({categoryCounts.tips})</span>
            </div>
            <span class="cat-arrow">›</span>
          </a>
          <a href="/builds" class="cat-item">
            <span class="cat-icon">🎮</span>
            <div class="cat-meta">
              <span class="cat-name">Builds</span>
              <span class="cat-sub">Where Winds Meet ({categoryCounts.builds})</span>
            </div>
            <span class="cat-arrow">›</span>
          </a>
          <a href="/tools" class="cat-item">
            <span class="cat-icon">🛠️</span>
            <div class="cat-meta">
              <span class="cat-name">Tools</span>
              <span class="cat-sub">Công cụ hữu ích ({categoryCounts.tools})</span>
            </div>
            <span class="cat-arrow">›</span>
          </a>
        </div>
      </section>

      <!-- Popular Tags -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <span class="sidebar-icon" aria-hidden="true">🏷️</span>
          Thẻ phổ biến
        </h2>
        <div class="tag-cloud">
          {
            popularTags.map((tag) => (
              <button type="button" class="tag-pill tag-search-btn" data-tag={tag}>
                {tag}
              </button>
            ))
          }
        </div>
      </section>

      <!-- Quick Stats -->
      <section class="card sidebar-card">
        <h2 class="sidebar-heading">
          <span class="sidebar-icon" aria-hidden="true">📊</span>
          Thống kê nhanh
        </h2>
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-value">{allPosts.length}</span>
            <span class="stat-label">Bài viết</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">~{totalMinutes}</span>
            <span class="stat-label">phút đọc</span>
          </div>
        </div>
        <div class="stats-thanks">💜 Cảm ơn bạn đã ghé thăm!</div>
      </section>
    </aside>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    document.querySelectorAll('.tag-search-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || '';
        const modal = document.getElementById('search-modal');
        const input = document.getElementById('search-input');
        if (!modal || !input || typeof modal.showModal !== 'function') return;
        modal.showModal();
        input.value = tag;
        input.dispatchEvent(new Event('input'));
        setTimeout(() => input.focus(), 20);
      });
    });
  })();
</script>

<style>
  /* Hero Banner */
  .hero-section {
    margin-bottom: 2rem;
  }

  .hero-banner-card {
    display: block;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-card), var(--shadow-glow);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .hero-banner-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .hero-banner-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Two-column layout */
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1.5rem;
    align-items: start;
  }

  .section-cats {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.05rem;
  }

  /* Sidebar */
  .home-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-card {
    padding: 1.15rem 1.2rem;
  }

  .sidebar-heading {
    margin: 0 0 0.85rem;
    font-size: 0.98rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
  }

  .sidebar-icon {
    font-size: 1rem;
  }

  .about-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .about-avatar {
    border-radius: 999px;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--accent);
    box-shadow: var(--shadow-glow);
  }

  .about-text {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .about-quote {
    margin: 0.95rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    font-style: italic;
    font-size: 0.83rem;
    color: var(--text-subtle);
    text-align: center;
  }

  .cat-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .cat-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.75rem;
    border-radius: 12px;
    background: var(--bg-pill);
    border: 1px solid var(--border);
    transition: border-color 0.16s ease, background-color 0.16s ease;
  }

  .cat-item:hover {
    border-color: var(--border-strong);
    background: var(--accent-soft);
  }

  .cat-icon {
    font-size: 1.15rem;
  }

  .cat-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .cat-name {
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--text);
  }

  .cat-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .cat-arrow {
    margin-left: auto;
    color: var(--text-subtle);
    font-size: 1.15rem;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag-search-btn {
    cursor: pointer;
    font-family: inherit;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  .stat-item {
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    background: var(--bg-pill);
    border: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .stat-value {
    font-weight: 750;
    font-size: 1.05rem;
    color: var(--accent-text);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .stats-thanks {
    margin-top: 0.75rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  @media (max-width: 1060px) {
    .home-layout {
      grid-template-columns: 1fr;
    }

    .home-sidebar {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .latest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-sidebar {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 580px) {
    .latest-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
