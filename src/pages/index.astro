---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllUnifiedPosts } from '@/lib/posts';

const allPosts = await getAllUnifiedPosts();
const recentPosts = allPosts.slice(0, 4);

const featuredCards = [
  {
    href: '/tools/vh-translator',
    tag: 'Tools · Windows 10/11',
    title: 'Tool dịch màn hình VH Translator v1.1.0',
    summary: 'Dịch 2 luồng, SSE streaming và cache rapidfuzz ở 45 ms.',
    cta: 'Xem công cụ và tải',
    image: '/images/thumbs/tools-vh-translator.webp',
    alt: 'Giao diện tool dịch màn hình VH Translator',
  },
  {
    href: '/builds/wwm-quick-guide-tieng-viet',
    tag: 'Builds · 11 Lưu Phái',
    title: 'Cẩm nang game Quick WWM Guide Tiếng Việt',
    summary: 'Checklist tân thủ, 11 lưu phái WWM và cách đổi Ngũ Duy.',
    cta: 'Đọc cẩm nang tân thủ',
    image: '/images/thumbs/builds-quick-guide-wwm.webp',
    alt: 'Ảnh bìa cẩm nang Quick WWM Guide bản tiếng Việt',
  },
  {
    href: '/builds/wwm-pha-truc-draught',
    tag: 'Builds · Patch 2.4',
    title: 'Build game Phá Trúc - Draught (Quyền Say)',
    summary: 'Build Min vượt Max ở Say 200 điểm đạt 98k DPS.',
    cta: 'Xem giáo án và video',
    image: '/images/thumbs/builds-pha-truc-draught.webp',
    alt: 'Ảnh bìa build Phá Trúc Draught Where Winds Meet',
  },
  {
    href: '/builds/wwm-co-che-sat-thuong',
    tag: 'Cơ chế · Lv.100–115',
    title: 'Cơ chế sát thương Where Winds Meet và Roll Hai Bể',
    summary: 'Kháng Phán Định 85% và bảng Ba Đường Ray Bậc 100.',
    cta: 'Đọc phân tích chỉ số',
    image: '/images/thumbs/builds-co-che-sat-thuong.webp',
    alt: 'Ảnh bìa bài phân tích cơ chế sát thương Where Winds Meet',
  },
];

const hitRollDiagramSpec = JSON.stringify({
  layout: 'lanes',
  curve: 'curve',
  motion: { pulse: 'none' },
  alt: 'Sơ đồ Bàn Tròn Hai Bể: Chính Xác đi qua Hai Bể Roll để chia Hội Ý, Chí Mạng hoặc Thường vào Ba Đường Ray.',
  input: {
    label: 'Chính Xác',
    icon: 'ui:swords',
    sub: 'Kháng 85%',
    kindCompact: 'pill',
  },
  core: {
    label: 'Hai Bể',
    icon: 'ui:cpu',
    kindCompact: 'pill',
  },
  lanes: [
    {
      label: 'Hội Ý',
      icon: 'ui:zap',
      done: true,
      sub: '1.35x Max',
      kindCompact: 'pill',
    },
    {
      label: 'Chí Mạng',
      icon: 'ui:trophy',
      done: true,
      sub: '1.50x TB',
      kindCompact: 'pill',
    },
    {
      label: 'Thường',
      icon: 'ui:layers',
      done: true,
      sub: 'Min đến Max',
      kindCompact: 'pill',
    },
  ],
  output: {
    label: 'Đường Ray',
    icon: 'ui:chart-column',
    done: true,
    kindCompact: 'pill',
  },
});

const statusCodeMap: Record<string, { abbr: string; tone: string }> = {
  builds: { abbr: 'WW', tone: '1' },
  tools: { abbr: 'TL', tone: '2' },
  tips: { abbr: 'TP', tone: '4' },
};
---

<BaseLayout home={true}>
  <!-- Screen 1: Collage Hero -->
  <section class="hero hero--collage" data-enter aria-labelledby="hero-title">
    <div class="wrap">
      <div class="grid hero__grid hero-text">
        <div class="hero__text span-5">
          <p class="hero-notice">
            Mới phát hành: <strong>VH Translator v1.1.0</strong> · Hit Roll Lv.100
          </p>

          <h1 id="hero-title">Dịch màn hình game và cẩm nang WWM</h1>

          <p class="hero__lead">
            Dịch game 2 luồng bằng PP-OCRv5, SSE streaming ở 45 ms và mô phỏng chỉ số Raid Bậc 100 theo Hai Bể Roll.
          </p>

          <div class="btn-row">
            <a href="/builds/calculator" class="btn btn--primary">Mở Hit Roll</a>
            <a href="/tools/vh-translator" class="btn btn--secondary">Xem VH Translator</a>
          </div>
        </div>

        <div class="hero__art span-6 start-7">
          <div class="hero__fx" data-fx="silk-folds" data-fx-seed="27" aria-hidden="true"></div>

          <div class="ly-piece ly-piece--main">
            <div class="ui ui-panel ui-win hero-win" data-ui="window">
              <div class="ui-win__bar">
                <span class="ui-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="ui-win__crumb">
                  VH Translator <i>/</i> <b>Cửa sổ game</b>
                </span>
                <span class="ui-spacer"></span>
                <span class="ui-win__search" aria-hidden="true">
                  <span class="ui-win__ph">Borderless</span>
                  <span class="ui-kbd">F8</span>
                </span>
              </div>

              <div class="ui-win__body hero-win__body">
                <nav class="ui-win__side" aria-hidden="true">
                  <span class="ui-win__nav is-on">Theo cửa sổ<em>3</em></span>
                  <span class="ui-win__nav">PP-OCRv5<em>v1</em></span>
                  <span class="ui-win__nav">Windows OCR<em>v11</em></span>
                  <span class="ui-win__label">Vùng cắt</span>
                  <span class="ui-win__nav"><span class="ui-win__hash">#</span>Hội thoại</span>
                  <span class="ui-win__nav"><span class="ui-win__hash">#</span>Phụ đề dưới</span>
                </nav>

                <div class="ui-win__main">
                  <div class="ui-win__cols" aria-hidden="true">
                    <span>Tựa game</span>
                    <span>Cấu hình OCR</span>
                    <span>Trạng thái</span>
                    <span class="ly-cut-hide">Độ trễ</span>
                  </div>
                  <ul class="ui-win__rows">
                    <li class="ui-win__row" data-row>
                      <span class="ui-avatar" data-tone="1">WW</span>
                      <span class="ui-win__who">Where Winds</span>
                      <span class="ui-win__sub">Chat 44%</span>
                      <span class="ui-win__st is-work" data-st>Đang dịch</span>
                      <span class="ui-win__age ly-cut-hide">45 ms</span>
                    </li>
                    <li class="ui-win__row" data-row>
                      <span class="ui-avatar" data-tone="2">ST</span>
                      <span class="ui-win__who">Sea of Thieves</span>
                      <span class="ui-win__sub">PP-OCRv5</span>
                      <span class="ui-win__st is-done" data-st>Sẵn sàng</span>
                      <span class="ui-win__age ly-cut-hide">62 ms</span>
                    </li>
                    <li class="ui-win__row" data-row>
                      <span class="ui-avatar" data-tone="4">EL</span>
                      <span class="ui-win__who">Elden Ring</span>
                      <span class="ui-win__sub">Sub 38%</span>
                      <span class="ui-win__st is-done" data-st>Đã gắn</span>
                      <span class="ui-win__age ly-cut-hide">38 ms</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="ly-piece ly-piece--note">
            <div class="ui ui-panel ui-stat" data-ui="stat">
              <div class="ui-stat__head">
                <div class="ui-stat__top">
                  <span class="ui-stat__label">Độ trễ HTTP/2</span>
                  <span class="ui-stat__range">Windows 10/11</span>
                </div>
                <div class="ui-stat__line">
                  <span class="ui-stat__num" data-stat-num>45 ms</span>
                  <span class="ui-chip ui-chip--plain ui-stat__delta">SHA-256</span>
                  <span class="ui-stat__sub">WDA_EXCLUDE</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Screen 2: App Frame Workspace Showcase (1H) -->
  <section class="section" id="workspace" aria-labelledby="workspace-h">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <h2 id="workspace-h">
            Kho cẩm nang Where Winds Meet và tool.<span class="muted"> Đọc toàn bộ ghi chú từ một thư mục thống nhất.</span>
          </h2>
        </div>
        <a class="link" href="/builds">Mở danh mục bài viết</a>
      </div>

      <div class="frame fill bg-field bg-bleed workspace-panel" data-visual>
        <div class="ui ui-panel ui-win workspace-win" data-ui="window">
          <div class="ui-win__bar">
            <span class="ui-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="ui-win__crumb">Hưng's Blog <i>/</i> <b>Bài mới</b></span>
            <span class="ui-spacer"></span>
            <span class="ui-meta">{allPosts.length}</span>
          </div>

          <div class="ui-win__body workspace-win__body">
            <div class="ui-win__main">
              <div class="ui-win__cols" aria-hidden="true">
                <span>Mục</span>
                <span>Bài viết mới nhất</span>
                <span>Trạng thái</span>
                <span>Đọc</span>
              </div>
              <ul class="ui-win__rows">
                {
                  recentPosts.map((post, idx) => {
                    const st = statusCodeMap[post.category] ?? statusCodeMap.builds;
                    return (
                      <li class="ui-win__row" data-row>
                        <span class="ui-avatar" data-tone={st.tone}>{st.abbr}</span>
                        <span class="ui-win__who">{post.categoryLabel}</span>
                        <a href={post.url} class="ui-win__sub workspace-row-link">{post.title}</a>
                        <span class:list={['ui-win__st', idx === 0 ? 'is-work' : 'is-done']} data-st>
                          {idx === 0 ? 'Mới nhất' : post.metaLabel}
                        </span>
                        <span class="ui-win__age num">{post.readingMinutes}p</span>
                      </li>
                    );
                  })
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Screen 3–4 (2H): Features 2x2 Editorial Guides & Tools -->
  <section class="section g2" id="guides" aria-labelledby="guides-h">
    <div class="wrap">
      <div class="group">
        <div class="section-head">
          <h2 id="guides-h">
            Cẩm nang WWM và tool.<span class="muted"> Tài liệu kiểm chứng thực tế.</span>
          </h2>
        </div>

        <div class="grid guides-grid">
          {
            featuredCards.slice(0, 2).map((item) => (
              <article class="card card--row span-6 guide-card">
                <div class="guide-card__top">
                  <span class="cat-tag">{item.tag}</span>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <a class="link" href={item.href}>{item.cta}</a>
                </div>
                <div class="panel panel--photo guide-panel">
                  <img src={item.image} alt={item.alt} width="680" height="382" loading="lazy" decoding="sync" />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div class="group">
        <div class="grid guides-grid">
          {
            featuredCards.slice(2, 4).map((item) => (
              <article class="card card--row span-6 guide-card">
                <div class="guide-card__top">
                  <span class="cat-tag">{item.tag}</span>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <a class="link" href={item.href}>{item.cta}</a>
                </div>
                <div class="panel panel--photo guide-panel">
                  <img src={item.image} alt={item.alt} width="680" height="382" loading="lazy" decoding="sync" />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Screen 5 (1H): Split Text Left + Diagram -->
  <section class="section bg-dots" id="calculator-flow" aria-labelledby="calc-flow-h">
    <div class="wrap">
      <div class="grid split-grid">
        <div class="span-5 split-col">
          <div class="section-head">
            <h2 id="calc-flow-h">
              Máy tính Hit Roll Where Winds Meet.<span class="muted"> Mô phỏng Bậc 100.</span>
            </h2>
          </div>

          <p class="split-copy">
            Chính Xác miễn kháng ở nền 65% để đóng Sượt Xám. Theo log 1.500 lần thử Bậc 100, Hội Ý (Cam 1.35x) đạt cố định 40,600 sát thương, Chí Mạng (Vàng 1.50x) đạt trung bình 28,292 và tối đa 33,831 qua Ba Đường Ray.
          </p>

          <div class="split-col__end">
            <a class="link" href="/builds/calculator">Kiểm tra bảng chỉ số trên máy tính</a>
          </div>
        </div>

        <div class="span-6 start-7">
          <div class="frame frame--split calc-diagram-frame">
            <div class="dg" data-icon-base="/assets/icons/" data-diagram={hitRollDiagramSpec}></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Screen 6 (1H): Statement Moment (word-highlight) -->
  <section class="section statement-sec" id="statement" data-moment="word-highlight" aria-label="Nguyên tắc biên tập">
    <div class="wrap statement-wrap">
      <p class="mo-wh__text">
        Mọi hướng dẫn game Where Winds Meet đều kiểm chứng qua <strong>log Raid Bậc 100</strong>, công bố bảng số gốc và gắn mã SHA-256 cho từng tool Windows.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-win {
    width: 100%;
  }

  .hero-win .ui-win__bar,
  .hero-win .ui-win__main {
    padding-right: var(--ly-cut-room, 48px);
  }

  .hero-win__body {
    min-height: 248px;
  }

  .hero-win .ui-win__st.is-done {
    color: #364038;
  }

  .hero__fx {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__art > .ly-piece {
    z-index: 1;
  }

  .hero__art > .ly-piece--note {
    z-index: 2;
  }

  .workspace-panel {
    --ratio: 0px;
    width: 100%;
    padding: clamp(20px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .workspace-panel::before {
    display: none;
  }

  .workspace-win {
    align-self: stretch;
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
    min-width: 0;
    --fx-bg: var(--p-surface, #1f2725);
    --fx-surface: var(--p-bg, #161c1a);
    --fx-ink: var(--p-ink, #e3e2da);
    --fx-muted: #b8bfb8;
    --fx-accent: var(--p-accent, #9fc7b8);
    --fx-accent-ink: var(--p-accent-ink, #161c1a);
  }

  .workspace-win__body {
    grid-template-columns: 1fr;
    min-height: 224px;
  }

  .workspace-win .ui-win__cols,
  .workspace-win .ui-win__row {
    grid-template-columns: 24px 56px minmax(0, 1fr) 128px 34px;
  }

  .workspace-row-link {
    display: block;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--u-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .workspace-row-link:hover {
    color: var(--u-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .guides-grid {
    align-items: start;
  }

  .guide-card {
    --c-pad: 20px;
    padding: var(--c-pad);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 12px;
    transition:
      transform var(--m-in, 150ms) var(--ease),
      border-color var(--m-in, 150ms) var(--ease);
  }

  .guide-card:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
  }

  .guide-card__top {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }

  .guide-card__top h3 {
    margin: 0;
    font-family: var(--font-text);
    font-size: var(--t-card);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  .guide-card__top p {
    margin: 0;
    font-size: var(--t-body);
    color: var(--ink);
    max-width: 48ch;
  }

  @media (min-width: 1024px) {
    .guide-card__top h3 {
      min-height: 2.5em;
    }

    .guide-card__top p {
      min-height: 2.6em;
    }
  }

  .guide-panel {
    --p-h: 0px;
    min-height: 0;
    position: relative;
    flex: none;
    padding: 0;
    margin-top: 4px;
    margin-bottom: 0;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .guide-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--m-in, 150ms) var(--ease);
  }

  .guide-card:hover .guide-panel img {
    transform: scale(1.03);
  }

  .split-grid {
    align-items: center;
  }

  .split-copy {
    color: var(--ink);
    font-size: var(--t-lead);
    line-height: 1.5;
    max-width: 44ch;
  }

  #calculator-flow {
    --g-screen: 100svh;
  }

  .calc-diagram-frame {
    min-height: 360px;
  }

  #calculator-flow .dg:not(:hover) :is(.dg-node, .dg-row, .dg-st, .dg-check, .dg-line, .dg-e, .dg-cap) {
    transition: none !important;
    animation: none !important;
  }

  .statement-sec > .wrap {
    display: grid;
    align-content: center;
  }

  @media (max-width: 1023px) {
    .split-grid {
      row-gap: var(--s-5);
    }
  }

  @media (max-width: 639px) {
    .workspace-panel {
      padding: var(--s-3);
    }

    .workspace-win .ui-win__bar {
      gap: 8px;
      padding: 0 10px;
    }

    .workspace-win .ui-win__cols {
      display: none;
    }

    .workspace-win .ui-win__row {
      grid-template-columns: 24px minmax(0, 1fr) auto;
      grid-template-rows: auto;
      height: auto;
      min-height: 44px;
      padding: 8px 12px;
      gap: 0 10px;
    }

    .workspace-win .ui-win__cols span:nth-child(2),
    .workspace-win .ui-win__cols span:nth-child(3),
    .workspace-win .ui-win__who,
    .workspace-win .ui-win__st {
      display: none;
    }

    .workspace-win .ui-win__avatar,
    .workspace-win .ui-avatar {
      grid-row: auto;
    }

    .workspace-win .workspace-row-link {
      grid-column: 2;
      grid-row: 1;
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      line-height: 1.35;
    }

    .workspace-win .ui-win__age {
      display: block;
      grid-column: 3;
      grid-row: 1;
    }

    .guide-card {
      --c-pad: 14px;
      padding: var(--c-pad);
      gap: 10px;
    }

    .guide-card__top p {
      font-size: 16px;
      line-height: 1.4;
    }

    .guide-panel {
      --p-h: 0px;
      flex: none;
      min-height: 0;
      aspect-ratio: 3 / 1;
    }

    .calc-diagram-frame {
      --ratio: 0px;
      min-height: 380px;
      padding: var(--s-4);
    }
  }
</style>
