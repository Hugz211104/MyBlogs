---
interface Props {
  title: string;
  version: string;
  os: string[];
  youtubeId: string;
  driveUrl: string;
  sha256: string;
  filename?: string;
  githubReleaseUrl?: string;
}

const {
  title,
  version,
  os,
  youtubeId,
  driveUrl,
  sha256,
  filename = `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${version}.zip`,
  githubReleaseUrl,
} = Astro.props;

const thumbUrl = `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`;
const psCommand = `Get-FileHash -Algorithm SHA256 ".\\${filename}"`;
const unixCommand = `sha256sum "${filename}"`;
const macCommand = `shasum -a 256 "${filename}"`;
const unixBlock = `${unixCommand}\n# macOS: ${macCommand}`;
---

<section class="download-box card" aria-label="Tải về và hướng dẫn">
  <!-- 1. Lazy-load YouTube Video -->
  <div class="dl-section">
    <div class="dl-heading">
      <span class="dl-step">1</span>
      <div>
        <h2 class="dl-title">Video hướng dẫn nhanh</h2>
        <p class="dl-sub">Ảnh xem trước tải nhẹ — chỉ nạp trình phát YouTube khi bạn bấm Play.</p>
      </div>
    </div>

    <div class="yt-facade" data-yt-id={youtubeId}>
      <img
        src={thumbUrl}
        alt={`Video hướng dẫn ${title}`}
        loading="lazy"
        decoding="async"
        class="yt-thumb"
      />
      <button type="button" class="yt-play-btn" aria-label={`Phát video hướng dẫn ${title}`}>
        <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
          <path
            d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3S12.8.3 7.5 1.7a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z"
            fill="#7c3aed"
            fill-opacity="0.92"
          />
          <path d="M27 34V14l18 10-18 10Z" fill="#ffffff" />
        </svg>
        <span class="yt-play-label">Bấm để phát video hướng dẫn</span>
      </button>
    </div>
  </div>

  <!-- 2. Primary Download (Google Drive + notice) -->
  <div class="dl-section">
    <div class="dl-heading">
      <span class="dl-step">2</span>
      <div>
        <h2 class="dl-title">Tải bản phát hành ({version})</h2>
        <p class="dl-sub">Hỗ trợ: {os.join(' · ')} — Không lưu tệp nhị phân trong repo Git.</p>
      </div>
    </div>

    <div class="dl-actions">
      <a href={driveUrl} target="_blank" rel="noopener noreferrer" class="btn-primary dl-btn-main">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" x2="12" y1="15" y2="3" />
        </svg>
        Tải từ Google Drive
      </a>

      {
        githubReleaseUrl && (
          <a href={githubReleaseUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            GitHub Releases
          </a>
        )
      }
    </div>

    <div class="dl-notice" role="note">
      <strong>Lưu ý khi tải:</strong> Nếu Google Drive hiện cảnh báo <em>"Không thể quét virus tệp này"</em> hoặc Windows SmartScreen cảnh báo file tự build chưa ký số, bạn có thể bấm <strong>Vẫn tải xuống</strong> rồi đối chiếu mã <strong>SHA-256</strong> bên dưới trước khi chạy. Hoặc ưu tiên tải qua <strong>GitHub Releases</strong> nếu có bản mirror chính thức.
    </div>
  </div>

  <!-- 3. SHA-256 Hash & Verification Commands -->
  <div class="dl-section">
    <div class="dl-heading">
      <span class="dl-step">3</span>
      <div>
        <h2 class="dl-title">Kiểm tra toàn vẹn tệp (SHA-256)</h2>
        <p class="dl-sub">Đối chiếu đúng chuỗi hash bên dưới để chắc chắn file tải về không bị sửa đổi.</p>
      </div>
    </div>

    <div class="hash-card">
      <div class="hash-row">
        <code class="hash-value" id="tool-sha256">{sha256}</code>
        <button type="button" class="copy-btn" data-copy={sha256}>
          Sao chép hash
        </button>
      </div>
    </div>

    <div class="cmd-grid">
      <div class="cmd-block">
        <div class="cmd-header">
          <span>Windows PowerShell</span>
          <button type="button" class="copy-btn copy-btn--sm" data-copy={psCommand}>Copy</button>
        </div>
        <pre class="cmd-pre"><code set:text={psCommand} /></pre>
      </div>

      <div class="cmd-block">
        <div class="cmd-header">
          <span>Linux / macOS</span>
          <button type="button" class="copy-btn copy-btn--sm" data-copy={unixCommand}>Copy</button>
        </div>
        <pre class="cmd-pre"><code set:text={unixBlock} /></pre>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    document.querySelectorAll('.yt-facade').forEach((wrapper) => {
      const btn = wrapper.querySelector('.yt-play-btn');
      btn?.addEventListener('click', () => {
        const ytId = wrapper.getAttribute('data-yt-id');
        if (!ytId) return;
        const iframe = document.createElement('iframe');
        iframe.src =
          'https://www.youtube-nocookie.com/embed/' +
          encodeURIComponent(ytId) +
          '?autoplay=1&rel=0';
        iframe.title = 'YouTube video player';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'yt-iframe';
        wrapper.innerHTML = '';
        wrapper.appendChild(iframe);
      });
    });

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Đã chép ✓';
          btn.classList.add('copied');
        } catch {
          btn.textContent = 'Không thể chép';
        }
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('copied');
        }, 1800);
      });
    });
  })();
</script>

<style>
  .download-box {
    padding: 1.4rem;
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dl-section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .dl-section + .dl-section {
    padding-top: 1.35rem;
    border-top: 1px solid var(--border);
  }

  .dl-heading {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .dl-step {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid var(--border-strong);
    color: var(--accent-text);
    font-weight: 700;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .dl-title {
    margin: 0;
    font-size: 1.06rem;
    font-weight: 700;
  }

  .dl-sub {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* YouTube lazy-load facade */
  .yt-facade {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #0b0813;
    border: 1px solid var(--border);
  }

  .yt-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.84);
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .yt-facade:hover .yt-thumb {
    transform: scale(1.02);
    filter: brightness(0.95);
  }

  .yt-play-btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: radial-gradient(circle, rgba(15, 13, 24, 0.25), rgba(15, 13, 24, 0.55));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    cursor: pointer;
    color: #ffffff;
  }

  .yt-play-label {
    font-size: 0.84rem;
    font-weight: 600;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    background: rgba(15, 13, 24, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  :global(.yt-iframe) {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Download actions */
  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.68rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--bg-pill);
    color: var(--accent-text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .btn-secondary:hover {
    background: var(--accent-soft);
  }

  .dl-notice {
    padding: 0.85rem 1rem;
    border-radius: 10px;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  /* Hash verification */
  .hash-card {
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
  }

  .hash-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hash-value {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.82rem;
    color: #c4b5fd;
    word-break: break-all;
  }

  .copy-btn {
    border: 1px solid rgba(167, 139, 250, 0.35);
    background: rgba(139, 92, 246, 0.22);
    color: #ede9fe;
    border-radius: 8px;
    padding: 0.38rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.16s ease;
  }

  .copy-btn:hover {
    background: rgba(139, 92, 246, 0.38);
  }

  :global(.copy-btn.copied) {
    background: rgba(16, 185, 129, 0.28);
    border-color: rgba(16, 185, 129, 0.55);
    color: #a7f3d0;
  }

  .copy-btn--sm {
    padding: 0.22rem 0.55rem;
    font-size: 0.72rem;
  }

  .cmd-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .cmd-block {
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  .cmd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid rgba(167, 139, 250, 0.14);
    font-size: 0.76rem;
    font-weight: 600;
    color: #a8a0c6;
  }

  .cmd-pre {
    margin: 0;
    padding: 0.7rem 0.75rem;
    font-size: 0.78rem;
    color: #e2e8f0;
    overflow-x: auto;
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .cmd-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
