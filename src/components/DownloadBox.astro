---
import Icon from '@/components/Icon.astro';

interface Props {
  title: string;
  version: string;
  os: string[];
  youtubeId?: string;
  driveUrl: string;
  sha256: string;
  videoPreview?: string;
  filename?: string;
  githubReleaseUrl?: string;
}

const {
  title,
  version,
  os,
  youtubeId,
  driveUrl,
  sha256,
  videoPreview,
  filename = `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${version}.zip`,
  githubReleaseUrl,
} = Astro.props;

const hasVideo = Boolean(youtubeId);
const thumbUrl = videoPreview ?? (youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : '');
const hasBakedPlay = Boolean(videoPreview);
const isGoogleDrive = /drive\.google\.com|drive\.usercontent\.google\.com/i.test(driveUrl);
const fileExt = filename.includes('.') ? filename.split('.').pop()?.toLowerCase() : '';
const primaryDownloadLabel = isGoogleDrive
  ? 'Tải từ Google Drive'
  : fileExt
    ? `Tải trực tiếp (.${fileExt})`
    : 'Tải trực tiếp';
const downloadStep = hasVideo ? '02' : '01';
const hashStep = hasVideo ? '03' : '02';
const psCommand = `Get-FileHash -Algorithm SHA256 ".\\${filename}"`;
const unixCommand = `sha256sum "${filename}"`;
const macCommand = `shasum -a 256 "${filename}"`;
const unixBlock = `${unixCommand}\n# macOS: ${macCommand}`;
---

<section class="download-box surface" aria-label="Tải về và hướng dẫn">
  {
    hasVideo && youtubeId && (
      <div class="dl-section">
        <div class="dl-heading">
          <span class="dl-step num">01</span>
          <div>
            <h2 class="dl-title">Video hướng dẫn sử dụng</h2>
            <p class="dl-sub">Trình phát YouTube chỉ nạp khi bạn nhấn phát</p>
          </div>
        </div>

        <div class="yt-facade" data-yt-id={youtubeId}>
          <img
            src={thumbUrl}
            alt={`Video hướng dẫn ${title}`}
            loading="lazy"
            decoding="async"
            class="yt-thumb"
          />
          <button
            type="button"
            class:list={['yt-play-btn', { 'yt-play-btn--subtle': hasBakedPlay }]}
            aria-label={`Phát video hướng dẫn ${title}`}
          >
            {!hasBakedPlay && (
              <span class="yt-play-mark">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <polygon points="6 4 20 12 6 20 6 4" />
                </svg>
                <span>Phát video hướng dẫn</span>
              </span>
            )}
          </button>
        </div>
      </div>
    )
  }

  <div class="dl-section">
    <div class="dl-heading">
      <span class="dl-step num">{downloadStep}</span>
      <div>
        <h2 class="dl-title">Tải bản phát hành {version}</h2>
        <p class="dl-sub">Hệ điều hành hỗ trợ: {os.join(' · ')}</p>
      </div>
    </div>

    <div class="dl-actions">
      <a href={driveUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
        <Icon name="download" size={16} />
        <span>{primaryDownloadLabel}</span>
      </a>

      {
        githubReleaseUrl && (
          <a href={githubReleaseUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <Icon name="github" size={16} />
            <span>GitHub Releases</span>
          </a>
        )
      }
    </div>

    <div class="dl-notice" role="note">
      <Icon name="shield" size={16} />
      <p>
        Nếu trình duyệt, Google Drive hoặc Windows SmartScreen hiển thị cảnh báo tệp chưa ký số, bạn hãy chọn Vẫn giữ / Vẫn tải xuống rồi đối chiếu mã SHA-256 bên dưới trước khi chạy.
      </p>
    </div>
  </div>

  <div class="dl-section">
    <div class="dl-heading">
      <span class="dl-step num">{hashStep}</span>
      <div>
        <h2 class="dl-title">Kiểm tra toàn vẹn SHA-256</h2>
        <p class="dl-sub">Đối chiếu đúng chuỗi hash dưới đây sau khi tải</p>
      </div>
    </div>

    <div class="hash-card">
      <code class="hash-value num" id="tool-sha256">{sha256}</code>
      <button type="button" class="copy-btn" data-copy={sha256}>
        Sao chép hash
      </button>
    </div>

    <div class="cmd-grid">
      <div class="cmd-block">
        <div class="cmd-header">
          <span>Windows PowerShell</span>
          <button type="button" class="copy-btn copy-btn--sm" data-copy={psCommand}>Copy</button>
        </div>
        <pre class="cmd-pre"><code set:text={psCommand} /></pre>
      </div>

      <div class="cmd-block">
        <div class="cmd-header">
          <span>Linux / macOS</span>
          <button type="button" class="copy-btn copy-btn--sm" data-copy={unixCommand}>Copy</button>
        </div>
        <pre class="cmd-pre"><code set:text={unixBlock} /></pre>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    document.querySelectorAll('.yt-facade').forEach((wrapper) => {
      const btn = wrapper.querySelector('.yt-play-btn');
      btn?.addEventListener('click', () => {
        const ytId = wrapper.getAttribute('data-yt-id');
        if (!ytId) return;
        const iframe = document.createElement('iframe');
        iframe.src =
          'https://www.youtube-nocookie.com/embed/' +
          encodeURIComponent(ytId) +
          '?autoplay=1&rel=0';
        iframe.title = 'YouTube video player';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'yt-iframe';
        wrapper.innerHTML = '';
        wrapper.appendChild(iframe);
      });
    });

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Đã chép';
          btn.classList.add('copied');
        } catch {
          btn.textContent = 'Lỗi chép';
        }
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('copied');
        }, 1800);
      });
    });
  })();
</script>

<style>
  .download-box {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .dl-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .dl-section + .dl-section {
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .dl-heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .dl-step {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent-text);
    width: 24px;
    flex-shrink: 0;
  }

  .dl-title {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text-primary);
  }

  .dl-sub {
    margin: 4px 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .yt-facade {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-control);
    overflow: hidden;
    background-color: var(--bg-deepest);
    border: 1px solid var(--border);
  }

  .yt-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt-play-btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: rgba(18, 17, 15, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease);
  }

  .yt-play-btn:hover {
    background: rgba(18, 17, 15, 0.2);
  }

  .yt-play-btn--subtle {
    background: transparent;
  }

  .yt-play-btn--subtle:hover {
    background: transparent;
  }

  .yt-play-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-control);
    background-color: #161513;
    border: 1px solid rgba(239, 233, 222, 0.16);
    color: #efe9de;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  :global(.yt-iframe) {
    width: 100%;
    height: 100%;
    border: none;
  }

  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .dl-notice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    background-color: var(--bg-deepest);
    border-radius: 0 var(--radius-control) var(--radius-control) 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .dl-notice p {
    margin: 0;
  }

  .dl-notice :global(.ui-icon) {
    color: var(--text-muted);
    margin-top: 2px;
  }

  .hash-card {
    background-color: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hash-value {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #efe9de;
    word-break: break-all;
  }

  .copy-btn {
    min-height: 32px;
    padding: 0 var(--space-3);
    border: 1px solid rgba(239, 233, 222, 0.16);
    background-color: #262421;
    color: #efe9de;
    border-radius: var(--radius-tag);
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .copy-btn:hover {
    border-color: rgba(239, 233, 222, 0.3);
  }

  :global(.copy-btn.copied) {
    border-color: var(--data-positive);
    color: var(--data-positive);
  }

  .copy-btn--sm {
    min-height: 28px;
    padding: 0 var(--space-2);
  }

  .cmd-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .cmd-block {
    background-color: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    overflow: hidden;
  }

  .cmd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid rgba(239, 233, 222, 0.08);
    font-size: var(--text-xs);
    color: #aaa398;
  }

  .cmd-pre {
    margin: 0;
    padding: var(--space-3);
    font-family: var(--font-mono);
    font-size: 13px;
    color: #efe9de;
    overflow-x: auto;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .download-box {
      padding: var(--space-5);
    }

    .cmd-grid {
      grid-template-columns: 1fr;
    }

    .copy-btn {
      min-height: 44px;
    }

    .copy-btn--sm {
      min-height: 36px;
    }
  }
</style>
