---
import Icon from '@/components/Icon.astro';

interface Props {
  title: string;
  version: string;
  os: string[];
  youtubeId?: string;
  driveUrl: string;
  sha256: string;
  videoPreview?: string;
  filename?: string;
  githubReleaseUrl?: string;
}

const {
  title,
  version,
  os,
  youtubeId,
  driveUrl,
  sha256,
  videoPreview,
  filename = `${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${version}.zip`,
  githubReleaseUrl,
} = Astro.props;

const hasVideo = Boolean(youtubeId);
const thumbUrl = videoPreview ?? (youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : '');
const hasBakedPlay = Boolean(videoPreview);
const downloadStep = hasVideo ? 2 : 1;
const hashStep = hasVideo ? 3 : 2;
const psCommand = `Get-FileHash -Algorithm SHA256 ".\\${filename}"`;
const unixCommand = `sha256sum "${filename}"`;
const macCommand = `shasum -a 256 "${filename}"`;
const unixBlock = `${unixCommand}\n# macOS: ${macCommand}`;
---

<section class="download-box card" aria-label="Tải về và hướng dẫn">
  <!-- Lazy-load YouTube Video (when youtubeId is provided) -->
  {
    hasVideo && youtubeId && (
      <div class="dl-section">
        <div class="dl-heading">
          <span class="dl-step">{1}</span>
          <div>
            <h2 class="dl-title">Video hướng dẫn nhanh</h2>
            <p class="dl-sub">Ảnh xem trước tải nhẹ — chỉ nạp trình phát YouTube khi bạn bấm Play.</p>
          </div>
        </div>

        <div class="yt-facade" data-yt-id={youtubeId}>
          <img
            src={thumbUrl}
            alt={`Video hướng dẫn sử dụng ${title}`}
            loading="lazy"
            decoding="async"
            class:list={['yt-thumb', { 'yt-thumb--raw': hasBakedPlay }]}
          />
          <button
            type="button"
            class:list={['yt-play-btn', { 'yt-play-btn--subtle': hasBakedPlay }]}
            aria-label={`Phát video hướng dẫn ${title}`}
          >
            {!hasBakedPlay && (
              <>
                <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
                  <path
                    d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3S12.8.3 7.5 1.7a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z"
                    fill="#c9a96e"
                    fill-opacity="0.94"
                  />
                  <path d="M27 34V14l18 10-18 10Z" fill="#0b0d14" />
                </svg>
                <span class="yt-play-label">Bấm để phát video hướng dẫn</span>
              </>
            )}
          </button>
        </div>
      </div>
    )
  }

  <!-- Primary Download (Google Drive + notice) -->
  <div class="dl-section">
    <div class="dl-heading">
      <span class="dl-step">{downloadStep}</span>
      <div>
        <h2 class="dl-title">Tải bản phát hành ({version})</h2>
        <p class="dl-sub">Hỗ trợ: {os.join(' · ')} — Không lưu tệp nhị phân trong repo Git.</p>
      </div>
    </div>

    <div class="dl-actions">
      <a href={driveUrl} target="_blank" rel="noopener noreferrer" class="btn-primary dl-btn-main">
        <Icon name="download" size={18} />
        <span>Tải từ Google Drive</span>
      </a>

      {
        githubReleaseUrl && (
          <a href={githubReleaseUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <Icon name="github" size={17} />
            <span>GitHub Releases</span>
          </a>
        )
      }
    </div>

    <div class="dl-notice" role="note">
      <Icon name="shield" size={18} class="dl-notice-icon" />
      <p>
        <strong>Lưu ý khi tải:</strong> Nếu Google Drive hiện cảnh báo{' '}
        <em>"Không thể quét virus tệp này"</em> hoặc Windows SmartScreen cảnh báo file tự build chưa ký số, bạn
        có thể bấm <strong>Vẫn tải xuống</strong> rồi đối chiếu mã <strong>SHA-256</strong> bên dưới trước
        khi chạy. Hoặc ưu tiên tải qua <strong>GitHub Releases</strong> nếu có bản mirror chính thức.
      </p>
    </div>
  </div>

  <!-- SHA-256 Hash & Verification Commands -->
  <div class="dl-section">
    <div class="dl-heading">
      <span class="dl-step">{hashStep}</span>
      <div>
        <h2 class="dl-title">Kiểm tra toàn vẹn tệp (SHA-256)</h2>
        <p class="dl-sub">Đối chiếu đúng chuỗi hash bên dưới để chắc chắn file tải về không bị sửa đổi.</p>
      </div>
    </div>

    <div class="hash-card">
      <div class="hash-row">
        <code class="hash-value" id="tool-sha256">{sha256}</code>
        <button type="button" class="copy-btn" data-copy={sha256}>
          Sao chép hash
        </button>
      </div>
    </div>

    <div class="cmd-grid">
      <div class="cmd-block">
        <div class="cmd-header">
          <span>Windows PowerShell</span>
          <button type="button" class="copy-btn copy-btn--sm" data-copy={psCommand}>Copy</button>
        </div>
        <pre class="cmd-pre"><code set:text={psCommand} /></pre>
      </div>

      <div class="cmd-block">
        <div class="cmd-header">
          <span>Linux / macOS</span>
          <button type="button" class="copy-btn copy-btn--sm" data-copy={unixCommand}>Copy</button>
        </div>
        <pre class="cmd-pre"><code set:text={unixBlock} /></pre>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    document.querySelectorAll('.yt-facade').forEach((wrapper) => {
      const btn = wrapper.querySelector('.yt-play-btn');
      btn?.addEventListener('click', () => {
        const ytId = wrapper.getAttribute('data-yt-id');
        if (!ytId) return;
        const iframe = document.createElement('iframe');
        iframe.src =
          'https://www.youtube-nocookie.com/embed/' +
          encodeURIComponent(ytId) +
          '?autoplay=1&rel=0';
        iframe.title = 'YouTube video player';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'yt-iframe';
        wrapper.innerHTML = '';
        wrapper.appendChild(iframe);
      });
    });

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Đã chép';
          btn.classList.add('copied');
        } catch {
          btn.textContent = 'Không thể chép';
        }
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('copied');
        }, 1800);
      });
    });
  })();
</script>

<style>
  .download-box {
    padding: 1.5rem;
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dl-section {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .dl-section + .dl-section {
    padding-top: 1.35rem;
    border-top: 1px solid var(--color-border);
  }

  .dl-heading {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .dl-step {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    background: rgba(201, 169, 110, 0.16);
    border: 1px solid var(--color-border-strong);
    color: var(--color-primary-bright);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.84rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .dl-title {
    margin: 0;
    font-size: 1.06rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .dl-sub {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* YouTube lazy-load facade */
  .yt-facade {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-inset);
    overflow: hidden;
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
  }

  .yt-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.84);
    transition:
      transform var(--motion-state) var(--ease-smooth),
      filter var(--motion-state) var(--ease-smooth);
  }

  .yt-thumb--raw {
    filter: brightness(0.98);
  }

  .yt-facade:hover .yt-thumb {
    transform: scale(1.02);
    filter: brightness(0.98);
  }

  .yt-play-btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: radial-gradient(circle, rgba(11, 13, 20, 0.2), rgba(11, 13, 20, 0.56));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    cursor: pointer;
    color: #ffffff;
  }

  .yt-play-btn--subtle {
    background: transparent;
  }

  .yt-play-label {
    font-size: 0.84rem;
    font-weight: 600;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background: rgba(11, 13, 20, 0.78);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);
  }

  :global(.yt-iframe) {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Download actions */
  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.65rem 1.15rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border-strong);
    background: var(--color-inset);
    color: var(--color-primary-bright);
    font-weight: 600;
    font-size: 0.9rem;
    transition:
      background-color var(--motion-micro) var(--ease-smooth),
      border-color var(--motion-micro) var(--ease-smooth);
  }

  .btn-secondary:hover {
    background: rgba(201, 169, 110, 0.14);
    border-color: var(--color-primary);
  }

  .dl-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-inset);
    background: rgba(201, 169, 110, 0.08);
    border: 1px solid var(--color-border-strong);
    font-size: 0.86rem;
    color: var(--color-text-muted);
    line-height: 1.58;
  }

  .dl-notice p {
    margin: 0;
  }

  .dl-notice-icon {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* Hash verification */
  .hash-card {
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-inset);
    padding: 0.8rem 0.95rem;
  }

  .hash-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hash-value {
    font-family: var(--font-mono);
    font-size: 0.81rem;
    color: var(--color-primary-bright);
    word-break: break-all;
  }

  .copy-btn {
    min-height: 36px;
    border: 1px solid var(--color-border-strong);
    background: rgba(201, 169, 110, 0.14);
    color: var(--color-primary-bright);
    border-radius: var(--radius-tight);
    padding: 0.35rem 0.78rem;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background-color var(--motion-micro) var(--ease-smooth),
      border-color var(--motion-micro) var(--ease-smooth),
      color var(--motion-micro) var(--ease-smooth);
  }

  .copy-btn:hover {
    background: rgba(201, 169, 110, 0.25);
    border-color: var(--color-primary);
  }

  :global(.copy-btn.copied) {
    background: rgba(52, 211, 153, 0.22);
    border-color: rgba(52, 211, 153, 0.55);
    color: #a7f3d0;
  }

  .copy-btn--sm {
    min-height: 30px;
    padding: 0.2rem 0.6rem;
    font-size: 0.73rem;
  }

  .cmd-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .cmd-block {
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-inset);
    overflow: hidden;
  }

  .cmd-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.48rem 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 600;
    color: #a9a4b8;
  }

  .cmd-pre {
    margin: 0;
    padding: 0.75rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: #f3efe6;
    overflow-x: auto;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .download-box {
      padding: 1.15rem;
    }

    .cmd-grid {
      grid-template-columns: 1fr;
    }

    .copy-btn {
      min-height: 44px;
    }
  }
</style>
