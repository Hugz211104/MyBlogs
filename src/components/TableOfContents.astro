---
import Icon from '@/components/Icon.astro';

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  tocItems.length > 1 && (
    <>
      <!-- Mobile collapsible TOC -->
      <details class="toc-mobile card">
        <summary class="toc-mobile-summary">
          <span class="toc-summary-label">
            <Icon name="toc" size={16} />
            <span>Mục lục bài viết ({tocItems.length} mục)</span>
          </span>
          <Icon name="chevron-down" size={16} class="toc-chevron" />
        </summary>
        <ul class="toc-list">
          {tocItems.map((h) => (
            <li class:list={['toc-item', { 'toc-item--sub': h.depth === 3 }]}>
              <a href={`#${h.slug}`} class="toc-link">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <!-- Desktop sticky sidebar TOC -->
      <aside class="toc-desktop card" aria-label="Mục lục bài viết">
        <div class="toc-title">
          <Icon name="toc" size={16} />
          <span>Mục lục</span>
        </div>
        <nav>
          <ul class="toc-list" id="toc-desktop-list">
            {tocItems.map((h) => (
              <li class:list={['toc-item', { 'toc-item--sub': h.depth === 3 }]}>
                <a href={`#${h.slug}`} class="toc-link" data-toc-slug={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    </>
  )
}

<script is:inline>
  (() => {
    const links = Array.from(document.querySelectorAll('[data-toc-slug]'));
    if (links.length === 0) return;

    const headingEls = links
      .map((l) => document.getElementById(l.getAttribute('data-toc-slug') || ''))
      .filter(Boolean);

    if (headingEls.length === 0) return;

    const setActive = (id) => {
      links.forEach((link) => {
        const match = link.getAttribute('data-toc-slug') === id;
        link.classList.toggle('active', match);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
            break;
          }
        }
      },
      { rootMargin: '-88px 0px -68% 0px', threshold: 0.1 }
    );

    headingEls.forEach((el) => observer.observe(el));
    setActive(headingEls[0].id);
  })();
</script>

<style>
  .toc-mobile {
    display: none;
    padding: 0.65rem 1rem;
  }

  .toc-mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }

  .toc-summary-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .toc-chevron {
    color: var(--color-text-muted);
    transition: transform var(--motion-micro) var(--ease-smooth);
  }

  .toc-mobile[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-mobile .toc-list {
    margin-top: 0.65rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--color-border);
  }

  .toc-desktop {
    position: sticky;
    top: 88px;
    padding: 1.05rem 1rem;
    max-height: calc(100dvh - 110px);
    overflow-y: auto;
  }

  .toc-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 700;
    margin-bottom: 0.7rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .toc-item--sub {
    padding-left: 0.75rem;
  }

  .toc-link {
    display: block;
    padding: 0.35rem 0.55rem;
    border-radius: var(--radius-tight);
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    border-left: 2px solid transparent;
    transition:
      color var(--motion-micro) var(--ease-smooth),
      background-color var(--motion-micro) var(--ease-smooth),
      border-color var(--motion-micro) var(--ease-smooth);
  }

  .toc-link:hover {
    color: var(--color-text);
    background: rgba(201, 169, 110, 0.1);
  }

  :global(.toc-link.active) {
    color: var(--color-primary-bright);
    background: rgba(201, 169, 110, 0.14);
    border-left-color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 1120px) {
    .toc-desktop {
      display: none;
    }

    .toc-mobile {
      display: block;
    }
  }
</style>
