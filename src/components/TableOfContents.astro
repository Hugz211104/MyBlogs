---
import Icon from '@/components/Icon.astro';

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  tocItems.length > 1 && (
    <>
      <details class="toc-mobile surface">
        <summary class="toc-mobile-summary">
          <span class="toc-summary-label">
            <Icon name="toc" size={16} />
            <span>Mục lục ({tocItems.length} phần)</span>
          </span>
          <Icon name="chevron-down" size={16} class="toc-chevron" />
        </summary>
        <ul class="toc-list">
          {tocItems.map((h) => (
            <li class:list={['toc-item', { 'toc-item--sub': h.depth === 3 }]}>
              <a href={`#${h.slug}`} class="toc-link">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <aside class="toc-desktop surface" aria-label="Mục lục bài viết">
        <div class="toc-title">
          <Icon name="toc" size={16} />
          <span>Mục lục</span>
        </div>
        <nav>
          <ul class="toc-list" id="toc-desktop-list">
            {tocItems.map((h) => (
              <li class:list={['toc-item', { 'toc-item--sub': h.depth === 3 }]}>
                <a href={`#${h.slug}`} class="toc-link" data-toc-slug={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    </>
  )
}

<script is:inline>
  (() => {
    const links = Array.from(document.querySelectorAll('[data-toc-slug]'));
    if (links.length === 0) return;

    const headingEls = links
      .map((l) => document.getElementById(l.getAttribute('data-toc-slug') || ''))
      .filter(Boolean);

    if (headingEls.length === 0) return;

    const setActive = (id) => {
      links.forEach((link) => {
        const match = link.getAttribute('data-toc-slug') === id;
        link.classList.toggle('active', match);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
            break;
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0.1 }
    );

    headingEls.forEach((el) => observer.observe(el));
    setActive(headingEls[0].id);
  })();
</script>

<style>
  .toc-mobile {
    display: none;
    padding: var(--space-2) var(--space-4);
  }

  .toc-mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }

  .toc-summary-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
  }

  .toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .toc-chevron {
    color: var(--text-muted);
    transition: transform var(--dur-fast) var(--ease);
  }

  .toc-mobile[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-mobile .toc-list {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    padding-bottom: var(--space-2);
    border-top: 1px solid var(--border);
  }

  .toc-desktop {
    position: sticky;
    top: 80px;
    padding: var(--space-4);
    max-height: calc(100dvh - 104px);
    overflow-y: auto;
  }

  .toc-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .toc-item--sub {
    padding-left: var(--space-3);
  }

  .toc-link {
    display: flex;
    align-items: center;
    min-height: 32px;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-tag);
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-muted);
    border-left: 2px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .toc-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-raised);
  }

  :global(.toc-link.active) {
    color: var(--text-primary);
    background-color: var(--bg-raised);
    border-left-color: var(--accent);
    font-weight: 500;
  }

  @media (max-width: 1100px) {
    .toc-desktop {
      display: none;
    }

    .toc-mobile {
      display: block;
    }
  }
</style>
