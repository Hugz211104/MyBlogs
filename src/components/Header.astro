---
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/lib/icons';
import { getAllUnifiedPosts } from '@/lib/posts';
import { SITE } from '@/lib/site';

const pathname = Astro.url.pathname;

const navItems: { href: string; label: string; icon: IconName; match: (p: string) => boolean }[] = [
  { href: '/', label: 'Trang chủ', icon: 'home', match: (p) => p === '/' },
  { href: '/tips', label: 'Tips', icon: 'tips', match: (p) => p.startsWith('/tips') },
  {
    href: '/builds',
    label: 'Builds',
    icon: 'builds',
    match: (p) => p.startsWith('/builds') && !p.startsWith('/builds/calculator'),
  },
  { href: '/tools', label: 'Tools', icon: 'tools', match: (p) => p.startsWith('/tools') },
  {
    href: '/builds/calculator',
    label: 'Hit Roll',
    icon: 'calculator',
    match: (p) => p.startsWith('/builds/calculator'),
  },
];

const allPosts = await getAllUnifiedPosts();
const searchIndex = allPosts.map((p) => ({
  title: p.title,
  summary: p.summary,
  url: p.url,
  category: p.categoryLabel,
  meta: p.metaLabel,
  tags: p.tags,
}));
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={SITE.title}>
      <svg class="brand-mark" viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
        <path d="M12 6.5 L14.2 12 L12 17.5 L9.8 12 Z" fill="var(--accent)" />
      </svg>
      <span class="brand-name">{SITE.title}</span>
    </a>

    <nav class="main-nav" aria-label="Điều hướng chính">
      {
        navItems.map((item) => {
          const active = item.match(pathname);
          return (
            <a
              href={item.href}
              class:list={['nav-link', { active }]}
              aria-current={active ? 'page' : undefined}
            >
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <div class="header-actions">
      <button
        type="button"
        id="theme-toggle"
        class="action-btn"
        aria-label="Chuyển giao diện sáng hoặc tối"
        title="Sáng / Tối"
      >
        <span class="theme-icon theme-icon--sun" aria-hidden="true">
          <Icon name="sun" size={16} />
        </span>
        <span class="theme-icon theme-icon--moon" aria-hidden="true">
          <Icon name="moon" size={16} />
        </span>
      </button>

      <button
        type="button"
        id="search-trigger"
        class="search-trigger"
        aria-label="Tìm kiếm bài viết (Ctrl+K)"
        title="Tìm bài viết (Ctrl+K)"
      >
        <Icon name="search" size={16} />
        <span class="search-label">Tìm bài</span>
        <span class="kbd-pair" aria-hidden="true">
          <kbd class="kbd">Ctrl</kbd>
          <kbd class="kbd">K</kbd>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Bottom Navigation -->
<nav class="mobile-tab-bar" aria-label="Điều hướng di động">
  {
    navItems.map((item) => {
      const active = item.match(pathname);
      return (
        <a
          href={item.href}
          class:list={['mobile-tab-item', { active }]}
          aria-current={active ? 'page' : undefined}
        >
          <Icon name={item.icon} size={16} />
          <span>{item.label}</span>
        </a>
      );
    })
  }
</nav>

<!-- Search Modal (Ctrl/Cmd + K) -->
<dialog id="search-modal" class="search-modal" aria-label="Tìm kiếm bài viết">
  <div class="search-dialog-box">
    <div class="search-input-row">
      <Icon name="search" size={16} />
      <input
        id="search-input"
        type="search"
        placeholder="Tìm bài viết"
        autocomplete="off"
      />
      <button type="button" id="search-close" class="kbd" aria-label="Đóng tìm kiếm">Esc</button>
    </div>
    <ul id="search-results" class="search-results"></ul>
  </div>
</dialog>

<script define:vars={{ searchIndex }}>
  (() => {
    const toggleBtn = document.getElementById('theme-toggle');
    toggleBtn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });

    const modal = document.getElementById('search-modal');
    const trigger = document.getElementById('search-trigger');
    const closeBtn = document.getElementById('search-close');
    const input = document.getElementById('search-input');
    const resultsEl = document.getElementById('search-results');

    const normalize = (str) =>
      str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

    function renderResults(query) {
      if (!resultsEl) return;
      const q = normalize(query.trim());
      const matches = q
        ? searchIndex.filter((item) => {
            const hay = normalize(
              `${item.title} ${item.summary} ${item.category} ${item.meta} ${item.tags.join(' ')}`
            );
            return hay.includes(q);
          })
        : searchIndex.slice(0, 6);

      if (matches.length === 0) {
        resultsEl.innerHTML = `<li class="search-empty">Không tìm thấy bài viết nào cho "${query}"</li>`;
        return;
      }

      resultsEl.innerHTML = '';
      matches.forEach((item) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = item.url;
        a.className = 'search-item';

        const catSpan = document.createElement('span');
        catSpan.className = 'search-cat';
        catSpan.textContent = item.category;

        const box = document.createElement('div');
        box.className = 'search-item-body';
        const titleDiv = document.createElement('div');
        titleDiv.className = 'search-title';
        titleDiv.textContent = item.title;
        const summaryDiv = document.createElement('div');
        summaryDiv.className = 'search-summary';
        summaryDiv.textContent = item.summary;

        box.appendChild(titleDiv);
        box.appendChild(summaryDiv);
        a.appendChild(catSpan);
        a.appendChild(box);
        li.appendChild(a);
        resultsEl.appendChild(li);
      });
    }

    function openSearch() {
      if (!modal) return;
      renderResults('');
      if (typeof modal.showModal === 'function') modal.showModal();
      setTimeout(() => input?.focus(), 20);
    }

    trigger?.addEventListener('click', openSearch);
    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    input?.addEventListener('input', (e) => renderResults(e.target.value));
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearch();
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: var(--bg-page);
    border-bottom: 1px solid var(--border);
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .brand-mark {
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-control);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-secondary);
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-card);
  }

  .nav-link.active {
    color: var(--text-primary);
    font-weight: 500;
    background-color: var(--bg-raised);
    box-shadow: var(--highlight-top);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .action-btn {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    background-color: var(--bg-card);
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .action-btn:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  /* Show moon when light, sun when dark (indicates click target) */
  :global([data-theme='dark']) .theme-icon--moon,
  :global(:root:not([data-theme='light'])) .theme-icon--moon {
    display: none;
  }
  :global([data-theme='light']) .theme-icon--sun {
    display: none;
  }

  .search-trigger {
    height: 36px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    background-color: var(--bg-card);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .search-trigger:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .kbd-pair {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-left: var(--space-1);
  }

  .mobile-tab-bar {
    display: none;
  }

  /* Search Dialog */
  .search-modal {
    border: none;
    padding: 0;
    background: transparent;
    width: min(560px, calc(100vw - 32px));
    margin: 12dvh auto auto;
    color: var(--text-primary);
  }

  .search-modal::backdrop {
    background: rgba(18, 17, 15, 0.72);
  }

  .search-dialog-box {
    background-color: var(--bg-card);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-panel);
    overflow: hidden;
    box-shadow: var(--shadow-float);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
  }

  .search-input-row input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text-primary);
    font-size: var(--text-base);
  }

  .search-input-row input::placeholder {
    color: var(--text-muted);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    max-height: 360px;
    overflow-y: auto;
  }

  :global(.search-item) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-control);
    transition: background-color var(--dur-fast) var(--ease);
  }

  :global(.search-item:hover) {
    background-color: var(--bg-raised);
  }

  :global(.search-cat) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-text);
    width: 56px;
    flex-shrink: 0;
    padding-top: 2px;
  }

  :global(.search-title) {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  :global(.search-summary) {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-empty) {
    padding: var(--space-6);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 820px) {
    .kbd-pair,
    .search-label {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .main-nav {
      display: none;
    }

    .action-btn,
    .search-trigger {
      min-width: 44px;
      height: 44px;
    }

    .search-trigger {
      padding: 0 var(--space-3);
    }

    .mobile-tab-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-1);
      padding: var(--space-2) var(--space-2) calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
      background-color: var(--bg-deepest);
      border-top: 1px solid var(--border);
    }

    .mobile-tab-item {
      min-height: 44px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      border-radius: var(--radius-control);
      font-size: 11px;
      font-weight: 400;
      color: var(--text-muted);
      transition:
        color var(--dur-fast) var(--ease),
        background-color var(--dur-fast) var(--ease);
    }

    .mobile-tab-item.active {
      color: var(--text-primary);
      font-weight: 500;
      background-color: var(--bg-raised);
    }
  }
</style>
