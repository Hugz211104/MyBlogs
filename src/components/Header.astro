---
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/lib/icons';
import { getAllUnifiedPosts } from '@/lib/posts';
import { SITE } from '@/lib/site';

const pathname = Astro.url.pathname;

const navItems: { href: string; label: string; icon: IconName; match: (p: string) => boolean }[] = [
  { href: '/', label: 'Trang chủ', icon: 'home', match: (p) => p === '/' },
  { href: '/tips', label: 'Tips', icon: 'tips', match: (p) => p.startsWith('/tips') },
  {
    href: '/builds',
    label: 'Builds',
    icon: 'builds',
    match: (p) => p.startsWith('/builds') && !p.startsWith('/builds/calculator'),
  },
  { href: '/tools', label: 'Tools', icon: 'tools', match: (p) => p.startsWith('/tools') },
  {
    href: '/builds/calculator',
    label: 'Hit Roll',
    icon: 'calculator',
    match: (p) => p.startsWith('/builds/calculator'),
  },
];

const allPosts = await getAllUnifiedPosts();
const searchIndex = allPosts.map((p) => ({
  title: p.title,
  summary: p.summary,
  url: p.url,
  category: p.categoryLabel,
  meta: p.metaLabel,
  tags: p.tags,
}));
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={SITE.title}>
      <img
        src="/images/brand/mascot-logo.webp"
        alt="Logo mèo đeo tai nghe của Hưng's Blog"
        width="40"
        height="40"
        class="brand-logo"
      />
      <div class="brand-text">
        <span class="brand-name">{SITE.title}</span>
        <span class="brand-sub">{SITE.subtitle}</span>
      </div>
    </a>

    <nav class="main-nav" aria-label="Điều hướng chính">
      {
        navItems.map((item) => {
          const active = item.match(pathname);
          return (
            <a
              href={item.href}
              class:list={['nav-link', { active }]}
              aria-current={active ? 'page' : undefined}
            >
              <Icon name={item.icon} size={17} />
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <div class="header-actions">
      <button
        type="button"
        id="theme-toggle"
        class="theme-pill"
        aria-label="Chuyển chế độ sáng hoặc tối"
        title="Chuyển Sáng / Tối"
      >
        <span class="theme-opt theme-opt--light" aria-hidden="true">
          <Icon name="sun" size={15} />
        </span>
        <span class="theme-opt theme-opt--dark" aria-hidden="true">
          <Icon name="moon" size={15} />
        </span>
      </button>

      <button
        type="button"
        id="search-trigger"
        class="icon-btn"
        aria-label="Tìm kiếm bài viết (Ctrl+K)"
        title="Tìm kiếm (Ctrl+K)"
      >
        <Icon name="search" size={18} />
        <span class="kbd-hint">Ctrl K</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Bottom Tab Bar (Thumb-zone accessible, >= 44px touch targets) -->
<nav class="mobile-tab-bar" aria-label="Điều hướng nhanh trên di động">
  {
    navItems.map((item) => {
      const active = item.match(pathname);
      return (
        <a
          href={item.href}
          class:list={['mobile-tab-item', { active }]}
          aria-current={active ? 'page' : undefined}
        >
          <Icon name={item.icon} size={20} />
          <span>{item.label}</span>
        </a>
      );
    })
  }
</nav>

<dialog id="search-modal" class="search-modal" aria-label="Tìm kiếm bài viết">
  <div class="search-dialog-box">
    <div class="search-input-row">
      <Icon name="search" size={18} />
      <input
        id="search-input"
        type="search"
        placeholder="Tìm bài viết, tag, project, Where Winds Meet..."
        autocomplete="off"
      />
      <button type="button" id="search-close" class="search-esc">ESC</button>
    </div>
    <ul id="search-results" class="search-results"></ul>
  </div>
</dialog>

<script id="search-index-data" type="application/json" set:html={JSON.stringify(searchIndex)} />

<script is:inline>
  (() => {
    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', () => {
      const html = document.documentElement;
      const next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      html.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });

    const modal = document.getElementById('search-modal');
    const trigger = document.getElementById('search-trigger');
    const closeBtn = document.getElementById('search-close');
    const input = document.getElementById('search-input');
    const resultsEl = document.getElementById('search-results');
    const rawData = document.getElementById('search-index-data')?.textContent || '[]';
    const items = JSON.parse(rawData);

    function renderResults(query) {
      if (!resultsEl) return;
      const q = query.trim().toLowerCase();
      const filtered = q
        ? items.filter(
            (i) =>
              i.title.toLowerCase().includes(q) ||
              i.summary.toLowerCase().includes(q) ||
              i.meta.toLowerCase().includes(q) ||
              i.tags.some((t) => t.toLowerCase().includes(q))
          )
        : items;

      if (filtered.length === 0) {
        resultsEl.innerHTML = '<li class="search-empty">Không tìm thấy bài viết phù hợp.</li>';
        return;
      }

      resultsEl.innerHTML = filtered
        .map(
          (i) =>
            `<li>
              <a href="${i.url}" class="search-item">
                <span class="search-cat">${i.category}</span>
                <div>
                  <div class="search-title">${i.title}</div>
                  <div class="search-summary">${i.summary}</div>
                </div>
              </a>
            </li>`
        )
        .join('');
    }

    function openSearch() {
      if (!modal || typeof modal.showModal !== 'function') return;
      modal.showModal();
      renderResults('');
      setTimeout(() => input?.focus(), 20);
    }

    trigger?.addEventListener('click', openSearch);
    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    input?.addEventListener('input', (e) => renderResults(e.target.value));
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearch();
      }
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: color-mix(in srgb, var(--color-bg) 78%, transparent);
    border-bottom: 1px solid var(--color-border);
    box-shadow: inset 0 -1px 0 rgba(201, 169, 110, 0.08);
  }

  .header-inner {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    min-height: 44px;
  }

  .brand-logo {
    border-radius: var(--radius-control);
    object-fit: cover;
    border: 1px solid var(--color-border-strong);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.04rem;
    letter-spacing: -0.02em;
  }

  .brand-sub {
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem;
    border-radius: var(--radius-inset);
    background: var(--color-inset);
    border: 1px solid var(--color-border);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 36px;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-control);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition:
      color var(--motion-micro) var(--ease-smooth),
      background-color var(--motion-micro) var(--ease-smooth),
      box-shadow var(--motion-micro) var(--ease-smooth);
  }

  .nav-link:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link.active {
    color: #ffffff;
    background: linear-gradient(135deg, #b89149, #8b5cf6);
    box-shadow: var(--shadow-gold-glow);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .theme-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 40px;
    padding: 0.25rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border);
    background: var(--color-inset);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: border-color var(--motion-micro) var(--ease-smooth);
  }

  .theme-pill:hover {
    border-color: var(--color-border-strong);
  }

  .theme-opt {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-tight);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color var(--motion-micro) var(--ease-smooth),
      color var(--motion-micro) var(--ease-smooth);
  }

  :global([data-theme='dark']) .theme-opt--dark,
  :global(:root:not([data-theme='light'])) .theme-opt--dark {
    background: var(--color-primary);
    color: #0b0d14;
  }

  :global([data-theme='light']) .theme-opt--light {
    background: var(--color-primary);
    color: #ffffff;
  }

  .icon-btn {
    min-width: 44px;
    min-height: 40px;
    padding: 0 0.7rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border);
    background: var(--color-inset);
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    cursor: pointer;
    transition:
      border-color var(--motion-micro) var(--ease-smooth),
      color var(--motion-micro) var(--ease-smooth);
  }

  .icon-btn:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .kbd-hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.12rem 0.38rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-border);
    color: var(--color-text-subtle);
  }

  /* Mobile Bottom Tab Bar */
  .mobile-tab-bar {
    display: none;
  }

  /* Search modal */
  .search-modal {
    border: none;
    padding: 0;
    background: transparent;
    width: min(600px, calc(100vw - 2rem));
    margin: 10dvh auto auto;
    color: var(--color-text);
  }

  .search-modal::backdrop {
    background: rgba(7, 8, 14, 0.78);
    backdrop-filter: blur(6px);
  }

  .search-dialog-box {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-shell);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.95rem 1.15rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .search-input-row input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--color-text);
    font-size: 1rem;
  }

  .search-esc {
    min-height: 32px;
    border: 1px solid var(--color-border);
    background: var(--color-inset);
    color: var(--color-text-muted);
    border-radius: var(--radius-tight);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    max-height: 360px;
    overflow-y: auto;
  }

  :global(.search-item) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-control);
    transition: background-color var(--motion-micro) var(--ease-smooth);
  }

  :global(.search-item:hover) {
    background: rgba(201, 169, 110, 0.12);
  }

  :global(.search-cat) {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.18rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--badge-builds-bg);
    color: var(--badge-builds-text);
    border: 1px solid var(--badge-builds-border);
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  :global(.search-title) {
    font-weight: 650;
    font-size: 0.94rem;
    color: var(--color-text);
  }

  :global(.search-summary) {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
  }

  :global(.search-empty) {
    padding: 1.5rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .kbd-hint {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .main-nav {
      display: none;
    }

    .icon-btn,
    .theme-pill {
      min-height: 44px;
      min-width: 44px;
    }

    .mobile-tab-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 2px;
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px));
      background: color-mix(in srgb, var(--color-bg-elevated) 88%, transparent);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid var(--color-border);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .mobile-tab-item {
      min-height: 48px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      border-radius: var(--radius-control);
      font-size: 0.68rem;
      font-weight: 600;
      color: var(--color-text-muted);
      transition:
        color var(--motion-micro) var(--ease-smooth),
        background-color var(--motion-micro) var(--ease-smooth);
    }

    .mobile-tab-item.active {
      color: var(--color-primary-bright);
      background: rgba(201, 169, 110, 0.14);
    }
  }
</style>
