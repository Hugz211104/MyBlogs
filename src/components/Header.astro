---
import { getAllUnifiedPosts } from '@/lib/posts';
import { SITE } from '@/lib/site';

const pathname = Astro.url.pathname;
const allPosts = await getAllUnifiedPosts();

const buildPosts = allPosts.filter((p) => p.category === 'builds').slice(0, 2);
const toolPosts = allPosts.filter((p) => p.category === 'tools').slice(0, 2);

const searchIndex = allPosts.map((p) => ({
  title: p.title,
  summary: p.summary,
  url: p.url,
  category: p.categoryLabel,
  meta: p.metaLabel,
  tags: p.tags,
}));

const isTips = pathname.startsWith('/tips');
const isBuilds = pathname.startsWith('/builds') && !pathname.startsWith('/builds/calculator');
const isTools = pathname.startsWith('/tools');
const isChangelog = pathname.startsWith('/changelog');
---

<header class="nav">
  <a class="skip-link" href="#main">Chuyển tới nội dung chính</a>
  <div class="wrap nav__bar">
    <a href="/" class="nav__logo" aria-label={SITE.title}>
      <span class="mark" data-mark="arc" aria-hidden="true"></span>
      <span>{SITE.title}</span>
    </a>

    <nav class="nav__links" aria-label="Điều hướng chính">
      <div class="nav__item">
        <a href="/tips" class="nav__link" aria-current={isTips ? 'page' : undefined}>Tips</a>
      </div>

      <div class="nav__item">
        <a
          href="/builds"
          class="nav__link"
          aria-current={isBuilds ? 'page' : undefined}
        >
          Builds
          <svg class="chev" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" />
          </svg>
        </a>
        <div class="nav__menu">
          <div class="wrap">
            <div class="grid">
              {
                buildPosts.map((post) => {
                  const thumb = post.cover.replace('/images/posts/', '/images/thumbs/');
                  return (
                    <a href={post.url} class="menu-card span-4">
                      <div class="panel panel--top nav-thumb-panel">
                        <img src={thumb} alt={post.title} width="680" height="382" loading="lazy" decoding="async" />
                      </div>
                      <strong>{post.title}</strong>
                      <span class="muted">{post.metaLabel}</span>
                    </a>
                  );
                })
              }
              <div class="menu-col span-4">
                <span class="t-label">Where Winds Meet</span>
                <a href="/builds">
                  Tất cả giáo án
                  <span>DPS, Healer và Patch Notes 2.4</span>
                </a>
                <a href="/builds/wwm-co-che-sat-thuong">
                  Cơ chế sát thương
                  <span>Roll Hai Bể, Bội Số và Phán Định</span>
                </a>
                <a href="/builds/calculator">
                  Máy tính Hit Roll
                  <span>Mô phỏng thực chiến Lv.100</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="nav__item">
        <a
          href="/tools"
          class="nav__link"
          aria-current={isTools ? 'page' : undefined}
        >
          Tools
          <svg class="chev" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" />
          </svg>
        </a>
        <div class="nav__menu">
          <div class="wrap">
            <div class="grid">
              {
                toolPosts.map((post) => {
                  const thumb = post.cover.replace('/images/posts/', '/images/thumbs/');
                  return (
                    <a href={post.url} class="menu-card span-4">
                      <div class="panel panel--top nav-thumb-panel">
                        <img src={thumb} alt={post.title} width="680" height="382" loading="lazy" decoding="async" />
                      </div>
                      <strong>{post.title}</strong>
                      <span class="muted">{post.metaLabel}</span>
                    </a>
                  );
                })
              }
              <div class="menu-col span-4">
                <span class="t-label">Windows & Mã nguồn</span>
                <a href="/tools">
                  Danh sách công cụ
                  <span>Bản cài đặt kèm SHA-256 đối chiếu</span>
                </a>
                <a href="/changelog">
                  Nhật ký phát hành
                  <span>Lịch sử cập nhật từng phiên bản</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="nav__item">
        <a href="/changelog" class="nav__link" aria-current={isChangelog ? 'page' : undefined}>Changelog</a>
      </div>
    </nav>

    <div class="nav__actions">
      <button
        type="button"
        id="search-trigger"
        class="nav-tool"
        aria-label="Tìm kiếm bài viết (Ctrl+K)"
        title="Tìm bài viết (Ctrl+K)"
      >
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" />
          <path d="m10.5 10.5 3 3" stroke-linecap="round" />
        </svg>
        <span class="nav-tool__label">Tìm bài</span>
      </button>

      <button
        type="button"
        id="theme-toggle"
        class="nav-tool nav-tool--icon"
        aria-label="Chuyển giao diện sáng hoặc tối"
        title="Sáng / Tối"
      >
        <svg class="theme-icon theme-icon--sun" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="8" cy="8" r="3" />
          <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1" stroke-linecap="round" />
        </svg>
        <svg class="theme-icon theme-icon--moon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M13.5 9.8A5.5 5.5 0 0 1 6.2 2.5a5.5 5.5 0 1 0 7.3 7.3Z" stroke-linejoin="round" />
        </svg>
      </button>

      <a href="/builds/calculator" class="btn btn--primary">Mở Hit Roll</a>
    </div>

    <button type="button" class="nav__toggle" aria-expanded="false" aria-label="Mở menu"></button>
  </div>
</header>

<dialog id="search-modal" class="search-modal" aria-label="Tìm kiếm bài viết">
  <div class="search-dialog-box">
    <div class="search-input-row">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5" />
        <path d="m10.5 10.5 3 3" stroke-linecap="round" />
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Tìm bài viết, lưu phái, công cụ"
        autocomplete="off"
      />
      <button type="button" id="search-close" class="kbd" aria-label="Đóng tìm kiếm">Esc</button>
    </div>
    <ul id="search-results" class="search-results"></ul>
  </div>
</dialog>

<script define:vars={{ searchIndex }}>
  (() => {
    const toggleBtn = document.getElementById('theme-toggle');
    toggleBtn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      document.documentElement.setAttribute('data-tone', next);
      const tc = document.getElementById('meta-theme-color');
      if (tc) tc.setAttribute('content', next === 'light' ? '#eef0f3' : '#161c1a');
      try {
        localStorage.setItem('theme', next);
      } catch {}
      if (window.tasteBackgrounds?.detect) window.tasteBackgrounds.detect();
    });

    const modal = document.getElementById('search-modal');
    const trigger = document.getElementById('search-trigger');
    const closeBtn = document.getElementById('search-close');
    const input = document.getElementById('search-input');
    const resultsEl = document.getElementById('search-results');

    const normalize = (str) =>
      str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

    function renderResults(query) {
      if (!resultsEl) return;
      const q = normalize(query.trim());
      const matches = q
        ? searchIndex.filter((item) => {
            const hay = normalize(
              `${item.title} ${item.summary} ${item.category} ${item.meta} ${item.tags.join(' ')}`
            );
            return hay.includes(q);
          })
        : searchIndex.slice(0, 6);

      if (matches.length === 0) {
        resultsEl.innerHTML = `<li class="search-empty">Không tìm thấy bài viết nào phù hợp.</li>`;
        return;
      }

      resultsEl.innerHTML = '';
      matches.forEach((item) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = item.url;
        a.className = 'search-item';

        const catSpan = document.createElement('span');
        catSpan.className = 'search-cat';
        catSpan.textContent = item.category;

        const box = document.createElement('div');
        box.className = 'search-item-body';
        const titleDiv = document.createElement('div');
        titleDiv.className = 'search-title';
        titleDiv.textContent = item.title;
        const summaryDiv = document.createElement('div');
        summaryDiv.className = 'search-summary';
        summaryDiv.textContent = item.summary;

        box.appendChild(titleDiv);
        box.appendChild(summaryDiv);
        a.appendChild(catSpan);
        a.appendChild(box);
        li.appendChild(a);
        resultsEl.appendChild(li);
      });
    }

    function openSearch() {
      if (!modal) return;
      const navEl = document.querySelector('.nav');
      if (navEl?.classList.contains('is-open')) {
        navEl.classList.remove('is-open');
        document.body.classList.remove('nav-locked');
      }
      renderResults('');
      if (typeof modal.showModal === 'function') modal.showModal();
      setTimeout(() => input?.focus(), 20);
    }

    trigger?.addEventListener('click', openSearch);
    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    input?.addEventListener('input', (e) => renderResults(e.target.value));
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearch();
      }
    });
  })();
</script>

<style>
  .nav-thumb-panel {
    --p-h: 0px;
    min-height: 0;
    position: relative;
    overflow: hidden;
    padding: 0;
  }

  .nav-thumb-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .menu-card strong {
    font-size: var(--t-body, 1rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  .nav-tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border-radius: var(--r-pill, 999px);
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    font-size: var(--t-small, 0.875rem);
    cursor: pointer;
    transition:
      border-color var(--dur, 150ms) var(--ease),
      color var(--dur, 150ms) var(--ease);
  }

  .nav-tool--icon {
    width: 36px;
    padding: 0;
  }

  .nav-tool:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  :global([data-theme='dark']) .theme-icon--moon,
  :global(:root:not([data-theme='light'])) .theme-icon--moon {
    display: none;
  }

  :global([data-theme='light']) .theme-icon--sun {
    display: none;
  }

  /* Search Dialog */
  .search-modal {
    border: none;
    padding: 0;
    background: transparent;
    width: min(560px, calc(100vw - 32px));
    margin: 12dvh auto auto;
    color: var(--text-primary);
  }

  .search-modal::backdrop {
    background: rgba(10, 14, 13, 0.72);
  }

  .search-dialog-box {
    background-color: var(--bg-card);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-panel);
    overflow: hidden;
    box-shadow: var(--shadow-float);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
  }

  .search-input-row input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text-primary);
    font-size: var(--text-base);
  }

  .search-input-row input::placeholder {
    color: var(--text-muted);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    max-height: 360px;
    overflow-y: auto;
  }

  :global(.search-item) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-control);
    transition: background-color var(--dur-fast) var(--ease);
  }

  :global(.search-item:hover) {
    background-color: var(--bg-raised);
  }

  :global(.search-cat) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-text);
    width: 56px;
    flex-shrink: 0;
    padding-top: 2px;
  }

  :global(.search-title) {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  :global(.search-summary) {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-empty) {
    padding: var(--space-6);
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 1023px) {
    :global(.nav.is-open .nav__actions) .nav-tool {
      width: 100%;
      height: 44px;
    }
  }
</style>
