---
import Icon from '@/components/Icon.astro';
---

<section class="calc-card card" aria-label="Máy tính Hit Roll Where Winds Meet">
  <div class="calc-header">
    <div>
      <span class="badge badge--builds">
        <Icon name="calculator" size={14} />
        <span>Interactive Simulator</span>
      </span>
      <h2 class="calc-title">Máy tính Tỷ lệ Đòn Đánh (Hit Roll) WWM</h2>
      <p class="calc-sub">
        Mô phỏng xác suất nhảy <strong>Số Cam (Affinity)</strong>, <strong>Số Vàng (Crit)</strong>,
        <strong>Số Trắng (Normal)</strong> và <strong>Số Xám (Sượt / Abrasion)</strong> theo cấp Resistance của Boss.
      </p>
    </div>

    <div class="calc-presets">
      <button type="button" class="preset-btn" data-preset="vodanh">Preset: Vô Danh</button>
      <button type="button" class="preset-btn" data-preset="healer">Preset: Hỏa Quyền</button>
      <button type="button" class="preset-btn" data-preset="newbie">Preset: Tân Thủ</button>
    </div>
  </div>

  <div class="calc-inputs">
    <label class="field">
      <span>Precision Rate (%) <small>Mục tiêu: 100%</small></span>
      <input type="number" id="in-prec" min="0" max="100" step="0.5" value="98" />
    </label>

    <label class="field">
      <span>Raw Crit Rate (%) <small>Trong bảng chỉ số</small></span>
      <input type="number" id="in-crit" min="0" max="200" step="0.5" value="65" />
    </label>

    <label class="field">
      <span>Direct Crit Rate (%) <small>Tâm pháp (tối đa 20%)</small></span>
      <input type="number" id="in-dcrit" min="0" max="30" step="0.5" value="5" />
    </label>

    <label class="field">
      <span>Raw Affinity Rate (%) <small>Trong bảng chỉ số</small></span>
      <input type="number" id="in-aff" min="0" max="150" step="0.5" value="45" />
    </label>

    <label class="field">
      <span>Direct Affinity Rate (%) <small>Tâm pháp + Bộ đồ</small></span>
      <input type="number" id="in-daff" min="0" max="30" step="0.5" value="15.8" />
    </label>

    <label class="field">
      <span>Cấp độ / Kháng (Resistance)</span>
      <select id="in-res">
        <option value="0">Lv ≤ 80 (0% Resistance)</option>
        <option value="0.15">Lv 81–85 (15% Resistance)</option>
        <option value="0.30">Lv 86–90 (30% Resistance)</option>
        <option value="0.45">Lv 91–95 (45% Resistance)</option>
        <option value="0.65" selected>Lv 96–100 (65% Resistance)</option>
      </select>
    </label>
  </div>

  <div class="calc-results">
    <div class="stacked-bar" aria-label="Biểu đồ phân bổ tỷ lệ đòn đánh">
      <div id="bar-aff" class="seg seg-aff" title="Affinity (Số Cam)"></div>
      <div id="bar-crit" class="seg seg-crit" title="Critical (Số Vàng)"></div>
      <div id="bar-norm" class="seg seg-norm" title="Normal (Số Trắng)"></div>
      <div id="bar-abr" class="seg seg-abr" title="Abrasion (Số Xám)"></div>
    </div>

    <div class="stat-cards">
      <div class="res-box res-aff">
        <span class="res-label">
          <span class="hit-dot hit-dot--aff" aria-hidden="true"></span>
          Số Cam (Affinity)
        </span>
        <strong class="res-val" id="out-aff">0%</strong>
        <small id="sub-aff">Trần Raw: 40% + Direct</small>
      </div>

      <div class="res-box res-crit">
        <span class="res-label">
          <span class="hit-dot hit-dot--crit" aria-hidden="true"></span>
          Số Vàng (Crit)
        </span>
        <strong class="res-val" id="out-crit">0%</strong>
        <small id="sub-crit">Trần Raw: 80% + Direct</small>
      </div>

      <div class="res-box res-norm">
        <span class="res-label">
          <span class="hit-dot hit-dot--norm" aria-hidden="true"></span>
          Số Trắng (Normal)
        </span>
        <strong class="res-val" id="out-norm">0%</strong>
        <small>Đòn thường</small>
      </div>

      <div class="res-box res-abr">
        <span class="res-label">
          <span class="hit-dot hit-dot--abr" aria-hidden="true"></span>
          Số Xám (Sượt)
        </span>
        <strong class="res-val" id="out-abr">0%</strong>
        <small>Ép về Min Attack</small>
      </div>
    </div>

    <div class="calc-advice" id="calc-advice"></div>
  </div>
</section>

<script is:inline>
  (() => {
    const ids = ['in-prec', 'in-crit', 'in-dcrit', 'in-aff', 'in-daff', 'in-res'];
    const els = Object.fromEntries(ids.map((id) => [id, document.getElementById(id)]));
    if (!els['in-prec']) return;

    const presets = {
      vodanh: { prec: 95, crit: 55, dcrit: 0, aff: 66, daff: 15.8, res: '0.65' },
      healer: { prec: 98, crit: 95, dcrit: 12, aff: 15, daff: 0, res: '0.65' },
      newbie: { prec: 82, crit: 40, dcrit: 0, aff: 18, daff: 0, res: '0.30' },
    };

    const clamp = (v, min, max) => Math.max(min, Math.min(max, v));

    function update() {
      const prec = clamp(parseFloat(els['in-prec'].value) || 0, 0, 100) / 100;
      const rawCrit = Math.max(0, parseFloat(els['in-crit'].value) || 0);
      const dCrit = clamp(parseFloat(els['in-dcrit'].value) || 0, 0, 30);
      const rawAff = Math.max(0, parseFloat(els['in-aff'].value) || 0);
      const dAff = clamp(parseFloat(els['in-daff'].value) || 0, 0, 30);
      const res = parseFloat(els['in-res'].value) || 0;

      const effectiveRawAff = Math.min(40, rawAff / (1 + res));
      const finalAff = clamp(effectiveRawAff + dAff, 0, 100) / 100;

      const effectiveRawCrit = Math.min(80, rawCrit / (1 + res));
      const finalCrit = clamp(effectiveRawCrit + dCrit, 0, 100) / 100;

      // Affinity resolves first, then Precision gates Crit vs Abrasion
      const actualAff = finalAff;
      const availableNonAff = Math.max(0, 1 - actualAff);
      const actualCrit = prec * Math.min(finalCrit, availableNonAff);
      const abrasion = (1 - prec) * availableNonAff;
      const normal = Math.max(0, 1 - actualAff - actualCrit - abrasion);

      const pct = (n) => `${(n * 100).toFixed(1)}%`;

      document.getElementById('out-aff').textContent = pct(actualAff);
      document.getElementById('out-crit').textContent = pct(actualCrit);
      document.getElementById('out-norm').textContent = pct(normal);
      document.getElementById('out-abr').textContent = pct(abrasion);

      document.getElementById('sub-aff').textContent =
        `Sau kháng: ${effectiveRawAff.toFixed(1)}% + ${dAff.toFixed(1)}% Direct`;
      document.getElementById('sub-crit').textContent =
        `Sau kháng: ${effectiveRawCrit.toFixed(1)}% + ${dCrit.toFixed(1)}% Direct`;

      document.getElementById('bar-aff').style.width = `${actualAff * 100}%`;
      document.getElementById('bar-crit').style.width = `${actualCrit * 100}%`;
      document.getElementById('bar-norm').style.width = `${normal * 100}%`;
      document.getElementById('bar-abr').style.width = `${abrasion * 100}%`;

      const notes = [];
      if (prec < 0.98) {
        notes.push({
          tag: 'Chú ý',
          tone: 'warn',
          text: `Precision đang ở ${(prec * 100).toFixed(1)}% — vẫn còn ${pct(abrasion)} đòn bị Sượt (Số Xám) ép về Min Attack.`,
        });
      } else if (prec === 1) {
        notes.push({
          tag: 'Tối ưu',
          tone: 'ok',
          text: 'Precision 100%: Đã triệt tiêu hoàn toàn đòn Sượt (Số Xám).',
        });
      }
      if (normal > 0.02) {
        notes.push({
          tag: 'Gợi ý',
          tone: 'info',
          text: `Còn ${pct(normal)} đòn trắng — có thể bù thêm Crit/Affinity hoặc Direct % từ Tâm pháp.`,
        });
      } else {
        notes.push({
          tag: 'Meta',
          tone: 'ok',
          text: 'Tỷ lệ Số Cam + Số Vàng đã đạt ngưỡng tối ưu gần như tuyệt đối.',
        });
      }
      if (res >= 0.45 && dCrit + dAff < 10) {
        notes.push({
          tag: 'Endgame',
          tone: 'gold',
          text: 'Ở khung Lv 91–100 (Kháng 45%–65%), nên ưu tiên Đột phá Tâm pháp lấy Direct Crit / Direct Affinity vì không bị chia kháng.',
        });
      }

      const adviceBox = document.getElementById('calc-advice');
      if (adviceBox) {
        adviceBox.innerHTML = '';
        notes.forEach((n) => {
          const line = document.createElement('div');
          line.className = 'advice-row';
          const badge = document.createElement('span');
          badge.className = `advice-tag advice-tag--${n.tone}`;
          badge.textContent = n.tag;
          const span = document.createElement('span');
          span.textContent = n.text;
          line.appendChild(badge);
          line.appendChild(span);
          adviceBox.appendChild(line);
        });
      }
    }

    ids.forEach((id) => {
      els[id]?.addEventListener('input', update);
      els[id]?.addEventListener('change', update);
    });

    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-preset');
        const p = presets[key];
        if (!p) return;
        els['in-prec'].value = p.prec;
        els['in-crit'].value = p.crit;
        els['in-dcrit'].value = p.dcrit;
        els['in-aff'].value = p.aff;
        els['in-daff'].value = p.daff;
        els['in-res'].value = p.res;
        update();
      });
    });

    update();
  })();
</script>

<style>
  .calc-card {
    padding: 1.55rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .calc-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .calc-title {
    margin: 0.6rem 0 0.35rem;
    font-size: var(--size-xl);
    font-weight: 700;
    color: var(--color-text);
  }

  .calc-sub {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    max-width: 64ch;
  }

  .calc-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .preset-btn {
    min-height: 36px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-inset);
    color: var(--color-primary-bright);
    border-radius: var(--radius-control);
    padding: 0.38rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--motion-micro) var(--ease-smooth),
      border-color var(--motion-micro) var(--ease-smooth);
  }

  .preset-btn:hover {
    background: rgba(201, 169, 110, 0.16);
    border-color: var(--color-primary);
  }

  .calc-inputs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.95rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .field small {
    font-weight: 400;
    color: var(--color-text-subtle);
    display: block;
    font-size: 0.75rem;
  }

  .field input,
  .field select {
    min-height: 44px;
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-elevated);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.94rem;
    transition: border-color var(--motion-micro) var(--ease-smooth);
  }

  .field select {
    font-family: var(--font-body);
  }

  .field input:focus,
  .field select:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .stacked-bar {
    height: 16px;
    border-radius: var(--radius-pill);
    overflow: hidden;
    display: flex;
    background: var(--color-inset);
    border: 1px solid var(--color-border);
  }

  .seg {
    height: 100%;
    transition: width var(--motion-state) var(--ease-smooth);
  }

  .seg-aff {
    background: #f97316;
  }

  .seg-crit {
    background: #eab308;
  }

  .seg-norm {
    background: #e2e8f0;
  }

  .seg-abr {
    background: #64748b;
  }

  .stat-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .res-box {
    padding: 0.9rem;
    border-radius: var(--radius-inset);
    background: var(--color-inset);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .res-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .hit-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    flex-shrink: 0;
  }

  .hit-dot--aff {
    background: #f97316;
  }

  .hit-dot--crit {
    background: #eab308;
  }

  .hit-dot--norm {
    background: #e2e8f0;
    border: 1px solid var(--color-border);
  }

  .hit-dot--abr {
    background: #64748b;
  }

  .res-val {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
  }

  .res-aff .res-val {
    color: #fb923c;
  }

  .res-crit .res-val {
    color: #facc15;
  }

  .res-norm .res-val {
    color: var(--color-text);
  }

  .res-abr .res-val {
    color: var(--color-text-muted);
  }

  .res-box small {
    font-family: var(--font-mono);
    font-size: 0.71rem;
    color: var(--color-text-subtle);
  }

  .calc-advice {
    margin-top: 1rem;
    padding: 0.95rem 1.05rem;
    border-radius: var(--radius-inset);
    background: rgba(201, 169, 110, 0.08);
    border: 1px solid var(--color-border-strong);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.87rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  :global(.advice-row) {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  :global(.advice-tag) {
    font-family: var(--font-heading);
    font-size: 0.71rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.14rem 0.45rem;
    border-radius: var(--radius-tight);
    flex-shrink: 0;
  }

  :global(.advice-tag--warn) {
    background: rgba(249, 115, 22, 0.18);
    color: #fb923c;
    border: 1px solid rgba(249, 115, 22, 0.35);
  }

  :global(.advice-tag--ok) {
    background: rgba(52, 211, 153, 0.16);
    color: #6ee7b7;
    border: 1px solid rgba(52, 211, 153, 0.35);
  }

  :global(.advice-tag--info) {
    background: rgba(56, 189, 248, 0.16);
    color: #7dd3fc;
    border: 1px solid rgba(56, 189, 248, 0.35);
  }

  :global(.advice-tag--gold) {
    background: rgba(201, 169, 110, 0.2);
    color: var(--color-primary-bright);
    border: 1px solid var(--color-border-strong);
  }

  @media (max-width: 820px) {
    .calc-inputs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .calc-card {
      padding: 1.15rem;
    }

    .preset-btn {
      min-height: 44px;
    }

    .field input,
    .field select {
      font-size: 16px;
    }

    .calc-inputs {
      grid-template-columns: 1fr;
    }
  }
</style>
