---
import { SITE } from '@/lib/site';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['closing', 'footer--dark', { 'footer--flow': !home }]} id="contact">
  <div class="wrap">
    {
      home && (
        <div class="closing__cta close--type">
          <div class="section-head">
            <h2>
              Tính sát thương game Where Winds Meet.<span class="muted"> Mở mô phỏng Hit Roll cho Raid Bậc 100.</span>
            </h2>
          </div>

          <a href="/builds/calculator" class="btn btn--primary btn--xl btn--wide">
            <span>Mở Hit Roll</span>
            <svg class="m-arrow" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
        </div>
      )
    }

    <div class="closing__links">
      <div class="grid">
        <div class="span-4 footer__col">
          <a href="/" class="footer__mark">
            <span class="mark" data-mark="arc" aria-hidden="true"></span>
            <span>{SITE.title}</span>
          </a>
          <p class="footer__lede">
            Ghi chú kỹ thuật backend, giáo án Where Winds Meet và tiện ích Windows mã nguồn mở.
          </p>
        </div>

        <div class="span-2 start-6 footer__col">
          <h3>Chuyên mục</h3>
          <ul>
            <li><a href="/">Trang chủ</a></li>
            <li><a href="/tips">Tips dự án</a></li>
            <li><a href="/builds">Build game</a></li>
            <li><a href="/tools">Tools Windows</a></li>
          </ul>
        </div>

        <div class="span-3 footer__col">
          <h3>Công cụ</h3>
          <ul>
            <li><a href="/builds/calculator">Mở Hit Roll</a></li>
            <li><a href="/tools/vh-translator">VH Translator</a></li>
            <li><a href="/tools/codeloader-wwm">CodeLoader WWM</a></li>
            <li><a href="/changelog">Nhật ký cập nhật</a></li>
          </ul>
        </div>

        <div class="span-2 footer__col">
          <h3>Liên kết</h3>
          <ul>
            <li><a href={SITE.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href={SITE.socials.discord} target="_blank" rel="noopener noreferrer">Discord</a></li>
            <li><a href={SITE.socials.youtube} target="_blank" rel="noopener noreferrer">YouTube</a></li>
            <li><a href={SITE.socials.email}>Email</a></li>
          </ul>
        </div>
      </div>

      <div class="footer__legal">
        <span>© {year} {SITE.title}. Mọi bài viết sử dụng dữ liệu kiểm chứng thực tế.</span>
        <span>Where Winds Meet &amp; Windows Utilities</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer--flow {
    border-top: 1px solid var(--line);
  }

  .footer__col h3 {
    margin-top: 0;
  }

  .footer__lede {
    margin-top: var(--s-4);
    color: var(--muted);
  }

  @media (max-width: 1023px) {
    .closing__links :is(ul, .footer__legal) a:not(.btn) {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      min-width: 44px;
    }
  }
</style>
