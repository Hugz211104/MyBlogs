---
import { SITE } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a href="/" class="footer-brand">
        <img src="/images/brand/mascot-logo.webp" alt="" width="36" height="36" class="footer-logo" />
        <div>
          <div class="footer-name">{SITE.title}</div>
          <div class="footer-tag">{SITE.tagline}</div>
        </div>
      </a>

      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/">Trang chủ</a>
        <a href="/tips">Tips</a>
        <a href="/builds">Builds</a>
        <a href="/tools">Tools</a>
      </nav>

      <div class="footer-socials">
        <a href={SITE.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.26 5.68.42.36.79 1.06.79 2.15v3.18c0 .31.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
          </svg>
        </a>
        <a href={SITE.socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" title="YouTube (@MUSICandANIMEVN)" class="social-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 23.5 12 31 31 0 0 0 23 7.2ZM9.7 15.2V8.8l5.8 3.2-5.8 3.2Z" />
          </svg>
        </a>
        <a href={SITE.socials.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" title="TikTok (@cachephoabruh1)" class="social-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.73a8.2 8.2 0 0 0 4.77 1.52V6.8a4.84 4.84 0 0 1-1.01-.11Z" />
          </svg>
        </a>
        <a href={SITE.socials.discord} target="_blank" rel="noopener noreferrer" aria-label="Discord" class="social-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.7 1.4a18.2 18.2 0 0 0-5.4 0L8.6 3a19.8 19.8 0 0 0-4.9 1.4C.6 9.1-.2 13.7.2 18.2a20 20 0 0 0 6 3l1.3-2.1a13 13 0 0 1-2-.9l.5-.4a14.2 14.2 0 0 0 12 0l.5.4a13 13 0 0 1-2 .9l1.3 2.1a20 20 0 0 0 6-3c.5-5.2-.8-9.8-3.5-13.8ZM8.4 15.4c-1.2 0-2.1-1.1-2.1-2.4s.9-2.4 2.1-2.4 2.1 1.1 2.1 2.4-.9 2.4-2.1 2.4Zm7.2 0c-1.2 0-2.1-1.1-2.1-2.4s.9-2.4 2.1-2.4 2.1 1.1 2.1 2.4-.9 2.4-2.1 2.4Z" />
          </svg>
        </a>
        <a href={SITE.socials.email} aria-label="Email" class="social-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-10 6L2 7" />
          </svg>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.title}. Made with ❤️ and Astro. Static deploy on Cloudflare Pages.</span>
      <a href="#top" class="scroll-top" aria-label="Lên đầu trang" title="Lên đầu trang">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="m18 15-6-6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    padding: 1.75rem 0 1.4rem;
    margin-top: auto;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .footer-logo {
    border-radius: 10px;
  }

  .footer-name {
    font-weight: 700;
    font-size: 0.98rem;
  }

  .footer-tag {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .footer-nav a:hover {
    color: var(--accent-text);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-btn {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }

  .social-btn:hover {
    border-color: var(--border-strong);
    color: var(--accent-text);
    transform: translateY(-2px);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    font-size: 0.82rem;
    color: var(--text-subtle);
  }

  .scroll-top {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-pill);
    color: var(--accent-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .scroll-top:hover {
    border-color: var(--border-strong);
  }
</style>
