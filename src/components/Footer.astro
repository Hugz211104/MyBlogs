---
import Icon from '@/components/Icon.astro';
import { SITE } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a href="/" class="footer-brand">
        <img
          src="/images/brand/mascot-logo.webp"
          alt="Logo Hưng's Blog"
          width="38"
          height="38"
          class="footer-logo"
        />
        <div>
          <div class="footer-name">{SITE.title}</div>
          <div class="footer-tag">Where Winds Meet · Dev Tips · Tools</div>
        </div>
      </a>

      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/">Trang chủ</a>
        <a href="/tips">Tips</a>
        <a href="/builds">Builds</a>
        <a href="/tools">Tools</a>
        <a href="/builds/calculator">Hit Roll</a>
        <a href="/changelog">Changelog</a>
      </nav>

      <div class="footer-socials">
        <a
          href={SITE.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
          class="social-btn"
        >
          <Icon name="github" size={17} />
        </a>
        <a
          href={SITE.socials.youtube}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
          title="YouTube (@MUSICandANIMEVN)"
          class="social-btn"
        >
          <Icon name="youtube" size={17} />
        </a>
        <a
          href={SITE.socials.tiktok}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok"
          title="TikTok (@cachephoabruh1)"
          class="social-btn"
        >
          <Icon name="tiktok" size={17} />
        </a>
        <a
          href={SITE.socials.discord}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Discord"
          title="Discord"
          class="social-btn"
        >
          <Icon name="discord" size={17} />
        </a>
        <a href={SITE.socials.email} aria-label="Email" title="Email" class="social-btn">
          <Icon name="mail" size={17} />
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.title}. Built with Astro &amp; Cyber Midnight tokens on Cloudflare.</span>
      <a href="#top" class="scroll-top" aria-label="Lên đầu trang" title="Lên đầu trang">
        <Icon name="arrow-up" size={17} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    padding: 1.75rem 0 1.45rem;
    margin-top: auto;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-logo {
    border-radius: var(--radius-control);
    object-fit: cover;
    border: 1px solid var(--color-border-strong);
  }

  .footer-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
  }

  .footer-tag {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .footer-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.15rem;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .footer-nav a {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    transition: color var(--motion-micro) var(--ease-smooth);
  }

  .footer-nav a:hover {
    color: var(--color-primary-bright);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .social-btn {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border);
    background: var(--color-inset);
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      border-color var(--motion-micro) var(--ease-smooth),
      color var(--motion-micro) var(--ease-smooth),
      transform var(--motion-micro) var(--ease-smooth);
  }

  .social-btn:hover {
    border-color: var(--color-border-strong);
    color: var(--color-primary-bright);
    transform: translateY(-2px);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    font-size: 0.82rem;
    color: var(--color-text-subtle);
  }

  .scroll-top {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-control);
    border: 1px solid var(--color-border);
    background: var(--color-inset);
    color: var(--color-primary-bright);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--motion-micro) var(--ease-smooth);
  }

  .scroll-top:hover {
    border-color: var(--color-border-strong);
  }
</style>
