---
import Icon from '@/components/Icon.astro';
import { SITE } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a href="/" class="footer-brand">
        <svg class="brand-mark" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
          <path d="M12 6.5 L14.2 12 L12 17.5 L9.8 12 Z" fill="var(--accent)" />
        </svg>
        <div>
          <div class="footer-name">{SITE.title}</div>
          <div class="footer-tag">{SITE.subtitle}</div>
        </div>
      </a>

      <nav class="footer-nav" aria-label="Điều hướng chân trang">
        <a href="/">Trang chủ</a>
        <a href="/tips">Tips</a>
        <a href="/builds">Builds</a>
        <a href="/tools">Tools</a>
        <a href="/builds/calculator">Hit Roll</a>
        <a href="/changelog">Changelog</a>
      </nav>

      <div class="footer-socials">
        <a href={SITE.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-btn">
          <Icon name="github" size={16} />
        </a>
        <a href={SITE.socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-btn">
          <Icon name="youtube" size={16} />
        </a>
        <a href={SITE.socials.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="social-btn">
          <Icon name="tiktok" size={16} />
        </a>
        <a href={SITE.socials.discord} target="_blank" rel="noopener noreferrer" aria-label="Discord" class="social-btn">
          <Icon name="discord" size={16} />
        </a>
        <a href={SITE.socials.email} aria-label="Email" class="social-btn">
          <Icon name="mail" size={16} />
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">© {year} {SITE.title}</span>
      <a href="#top" class="scroll-top" aria-label="Lên đầu trang" title="Lên đầu trang">
        <Icon name="arrow-up" size={16} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background-color: var(--bg-deepest);
    padding: var(--space-8) 0 var(--space-6);
    margin-top: auto;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-primary);
  }

  .brand-mark {
    color: var(--text-secondary);
  }

  .footer-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .footer-tag {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: 2px;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .footer-nav a {
    transition: color var(--dur-fast) var(--ease);
  }

  .footer-nav a:hover {
    color: var(--text-primary);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .social-btn,
  .scroll-top {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    background-color: var(--bg-card);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .social-btn:hover,
  .scroll-top:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
    background-color: var(--bg-raised);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
    }

    .social-btn,
    .scroll-top {
      width: 44px;
      height: 44px;
    }
  }
</style>
