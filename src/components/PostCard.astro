---
import CategoryThumbnail from '@/components/CategoryThumbnail.astro';
import { formatDateVi, type UnifiedPost } from '@/lib/posts';

interface Props {
  post: UnifiedPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article
  class:list={['surface surface-interactive post-card', { 'post-card--featured': featured }]}
  data-tags={post.tags.join(',').toLowerCase()}
  data-role={post.metaLabel.toLowerCase()}
>
  <a href={post.url} class:list={['post-card-link', { 'post-card-link--featured': featured }]}>
    <CategoryThumbnail
      category={post.category}
      cover={post.cover}
      alt={`Ảnh bài viết ${post.title}`}
      featured={featured}
    />

    <div class="post-card-body">
      <div class="post-card-top">
        <span class="cat-tag">
          <span class={`cat-dot cat-dot--${post.category}`} aria-hidden="true"></span>
          <span>{post.categoryLabel}</span>
        </span>
        <span class="meta-mono num">{post.readingMinutes} phút đọc</span>
      </div>

      <h3 class="post-card-title">{post.title}</h3>
      <p class="post-card-summary">{post.summary}</p>

      <div class="post-card-meta">
        <span class="meta-mono num">{formatDateVi(post.date)}</span>
        <span class="meta-sep" aria-hidden="true">·</span>
        <span class="meta-role">{post.metaLabel}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .post-card--featured {
    grid-column: span 2;
  }

  .post-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-card-link--featured {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }

  .post-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    gap: var(--space-2);
  }

  .post-card--featured .post-card-body {
    padding: var(--space-6);
    gap: var(--space-3);
  }

  .post-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .meta-mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .post-card-title {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.38;
    color: var(--text-primary);
  }

  .post-card--featured .post-card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.25;
  }

  .post-card-summary {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .meta-role {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .post-card--featured {
      grid-column: span 1;
    }

    .post-card-link--featured {
      display: flex;
      flex-direction: column;
    }

    .post-card--featured .post-card-body {
      padding: var(--space-5);
    }
  }
</style>
