---
import CategoryThumbnail from '@/components/CategoryThumbnail.astro';
import { formatDateVi, type UnifiedPost } from '@/lib/posts';

interface Props {
  post: UnifiedPost;
}

const { post } = Astro.props;
---

<article class="card card-interactive post-card">
  <a href={post.url} class="post-card-link">
    <CategoryThumbnail category={post.category} label={post.categoryLabel} />

    <div class="post-card-body">
      <h3 class="post-card-title">{post.title}</h3>
      <p class="post-card-summary">{post.summary}</p>

      <div class="post-card-meta">
        <span class="meta-item">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="18" height="18" x="3" y="4" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
          </svg>
          {formatDateVi(post.date)}
        </span>
        <span class="meta-item meta-label">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z" />
            <line x1="7" x2="7.01" y1="7" y2="7" />
          </svg>
          {post.metaLabel}
        </span>
        <span class="meta-arrow" aria-hidden="true">→</span>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .post-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-card-body {
    padding: 1rem 1.05rem 1.1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.55rem;
  }

  .post-card-title {
    margin: 0;
    font-size: 1.03rem;
    font-weight: 700;
    line-height: 1.38;
    color: var(--text);
  }

  .post-card-summary {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.55;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.77rem;
    color: var(--text-subtle);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .meta-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 130px;
  }

  .meta-arrow {
    margin-left: auto;
    font-weight: 700;
    color: var(--accent-text);
    transition: transform 0.18s ease;
  }

  .post-card:hover .meta-arrow {
    transform: translateX(3px);
  }
</style>
