---
import CategoryThumbnail from '@/components/CategoryThumbnail.astro';
import Icon from '@/components/Icon.astro';
import { formatDateVi, type UnifiedPost } from '@/lib/posts';

interface Props {
  post: UnifiedPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article
  class:list={['card card-interactive post-card', `post-card--${post.category}`, { 'post-card--featured': featured }]}
  data-tags={post.tags.join(',').toLowerCase()}
  data-role={post.metaLabel.toLowerCase()}
>
  <a href={post.url} class:list={['post-card-link', { 'post-card-link--featured': featured }]}>
    <CategoryThumbnail
      category={post.category}
      label={post.categoryLabel}
      cover={post.cover}
      badge={post.badge}
      alt={`Ảnh bìa bài viết ${post.title}`}
      featured={featured}
    />

    <div class="post-card-body">
      <div class="post-card-top-meta">
        <span class={`badge badge--${post.category}`}>{post.categoryLabel}</span>
        <span class="read-time">~{post.readingMinutes} phút đọc</span>
      </div>

      <h3 class="post-card-title">{post.title}</h3>
      <p class="post-card-summary">{post.summary}</p>

      <div class="post-card-meta">
        <span class="meta-item">
          <Icon name="calendar" size={14} />
          {formatDateVi(post.date)}
        </span>
        <span class="meta-item meta-label">
          <Icon name="tag" size={14} />
          {post.metaLabel}
        </span>
        <span class="meta-arrow" aria-hidden="true">
          <Icon name="arrow-right" size={15} />
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .post-card--featured {
    grid-column: span 2;
    border-color: var(--color-border-strong);
  }

  .post-card--tips:hover {
    border-color: rgba(56, 189, 248, 0.55);
    box-shadow: 0 12px 20px -8px rgba(56, 189, 248, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .post-card--builds:hover {
    border-color: rgba(201, 169, 110, 0.62);
    box-shadow: 0 12px 20px -8px rgba(201, 169, 110, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .post-card--tools:hover {
    border-color: rgba(52, 211, 153, 0.55);
    box-shadow: 0 12px 20px -8px rgba(52, 211, 153, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .post-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-card-link--featured {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
  }

  .post-card-body {
    padding: 1.05rem 1.15rem 1.15rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.55rem;
  }

  .post-card-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .read-time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-subtle);
  }

  .post-card-title {
    margin: 0;
    font-size: 1.04rem;
    font-weight: 700;
    line-height: 1.36;
    color: var(--color-text);
  }

  .post-card--featured .post-card-title {
    font-size: 1.24rem;
  }

  .post-card-summary {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.56;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    margin-top: auto;
    padding-top: 0.72rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.77rem;
    color: var(--color-text-subtle);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .meta-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 140px;
  }

  .meta-arrow {
    margin-left: auto;
    color: var(--color-primary-bright);
    transition: transform var(--motion-micro) var(--ease-smooth);
  }

  .post-card:hover .meta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .post-card--featured {
      grid-column: span 1;
    }

    .post-card-link--featured {
      display: flex;
      flex-direction: column;
    }
  }
</style>
