---
import type { CategoryKey } from '@/lib/posts';

interface Props {
  category: CategoryKey;
  cover?: string;
  alt: string;
  featured?: boolean;
}

const { category, cover, alt, featured = false } = Astro.props;

const fallbackCovers: Record<CategoryKey, string> = {
  tips: '/images/posts/tips-lawbot-fastapi.webp',
  builds: '/images/posts/builds-wwm-sword-spear.webp',
  tools: '/images/posts/tools-sonar-tts.webp',
};

const imgSrc = cover ?? fallbackCovers[category];
---

<div class:list={['thumb', { 'thumb--featured': featured }]}>
  <img src={imgSrc} alt={alt} class="thumb-img" loading="lazy" decoding="async" />
</div>

<style>
  .thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--bg-deepest);
    border-bottom: 1px solid var(--border);
  }

  .thumb--featured {
    height: 100%;
    min-height: 240px;
    border-bottom: none;
    border-right: 1px solid var(--border);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 820px) {
    .thumb--featured {
      min-height: 180px;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
