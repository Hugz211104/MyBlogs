---
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/lib/icons';
import type { CategoryKey } from '@/lib/posts';

interface Props {
  category: CategoryKey;
  label: string;
  cover?: string;
  badge?: string;
  alt: string;
  featured?: boolean;
}

const { category, label, cover, badge, alt, featured = false } = Astro.props;

const fallbackCovers: Record<CategoryKey, string> = {
  tips: '/images/posts/tips-lawbot-fastapi.webp',
  builds: '/images/posts/builds-wwm-sword-spear.webp',
  tools: '/images/posts/tools-sonar-tts.webp',
};

const PRE_BADGED = new Set([
  '/images/posts/tips-lawbot-fastapi.webp',
  '/images/posts/builds-wwm-sword-spear.webp',
  '/images/posts/tools-sonar-tts.webp',
  '/images/posts/tools-codeloader-wwm.webp',
]);

const iconByCategory: Record<CategoryKey, IconName> = {
  tips: 'tips',
  builds: 'builds',
  tools: 'tools',
};

const imgSrc = cover ?? fallbackCovers[category];
const hasBakedBadge = PRE_BADGED.has(imgSrc);
---

<div class:list={['thumb', `thumb--${category}`, { 'thumb--featured': featured }]}>
  <img src={imgSrc} alt={alt} class="thumb-img" loading="lazy" decoding="async" />
  <div class="thumb-scrim" aria-hidden="true"></div>
  {!hasBakedBadge && (
    <span class={`badge badge--${category} thumb-badge`}>
      <Icon name={iconByCategory[category]} size={13} />
      {label}
    </span>
  )}
  {badge && <span class="thumb-status-pill">{badge}</span>}
</div>

<style>
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: calc(var(--radius-surface) - 1px) calc(var(--radius-surface) - 1px) 0 0;
    background: var(--color-inset);
  }

  .thumb--featured {
    height: 100%;
    min-height: 220px;
    border-radius: calc(var(--radius-surface) - 1px) 0 0 calc(var(--radius-surface) - 1px);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--motion-panel) var(--ease-spring);
  }

  .thumb-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 13, 20, 0.15) 0%, transparent 45%, rgba(11, 13, 20, 0.45) 100%);
    pointer-events: none;
  }

  :global(.post-card:hover) .thumb-img {
    transform: scale(1.03);
  }

  .thumb-badge {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
  }

  .thumb-status-pill {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    padding: 0.22rem 0.62rem;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 700;
    color: #f3efe6;
    background: rgba(11, 13, 20, 0.78);
    border: 1px solid rgba(201, 169, 110, 0.48);
    backdrop-filter: blur(8px);
  }

  @media (max-width: 820px) {
    .thumb--featured {
      min-height: 0;
      border-radius: calc(var(--radius-surface) - 1px) calc(var(--radius-surface) - 1px) 0 0;
    }
  }
</style>
