---
import type { CategoryKey } from '@/lib/posts';

interface Props {
  category: CategoryKey;
  label: string;
  cover?: string;
  badge?: string;
  alt?: string;
}

const { category, label, cover, badge, alt = '' } = Astro.props;

const fallbackCovers: Record<CategoryKey, string> = {
  tips: '/images/posts/tips-lawbot-fastapi.webp',
  builds: '/images/posts/builds-wwm-sword-spear.webp',
  tools: '/images/posts/tools-sonar-tts.webp',
};

const PRE_BADGED = new Set([
  '/images/posts/tips-lawbot-fastapi.webp',
  '/images/posts/builds-wwm-sword-spear.webp',
  '/images/posts/tools-sonar-tts.webp',
  '/images/posts/tools-codeloader-wwm.webp',
]);

const imgSrc = cover ?? fallbackCovers[category];
const hasBakedBadge = PRE_BADGED.has(imgSrc);
---

<div class={`thumb thumb--${category}`}>
  <img src={imgSrc} alt={alt} class="thumb-img" loading="lazy" decoding="async" />
  {!hasBakedBadge && (
    <span class={`badge badge--${category} thumb-badge`}>
      {category === 'tips' && '💡 '}
      {category === 'builds' && '🎮 '}
      {category === 'tools' && '🛠️ '}
      {label}
    </span>
  )}
  {badge && <span class="thumb-status-pill">{badge}</span>}
</div>

<style>
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
    background: var(--bg-pill);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  :global(.post-card:hover) .thumb-img {
    transform: scale(1.04);
  }

  .thumb-badge {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
  }

  .thumb-status-pill {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #ffffff;
    background: rgba(17, 13, 30, 0.76);
    border: 1px solid rgba(196, 181, 253, 0.4);
    backdrop-filter: blur(8px);
  }
</style>
