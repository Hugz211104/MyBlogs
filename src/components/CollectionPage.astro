---
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { CategoryKey, UnifiedPost } from '@/lib/posts';

interface Props {
  title: string;
  description: string;
  category: CategoryKey;
  posts: UnifiedPost[];
}

const { title, description, category, posts } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="cat-hero card">
    <span class={`badge badge--${category}`}>{title}</span>
    <h1 class="cat-title">{title}</h1>
    <p class="cat-desc">{description}</p>
    <div class="cat-count">Tổng cộng {posts.length} bài viết</div>
  </section>

  {
    posts.length === 0 ? (
      <div class="card empty-state">Chưa có bài viết nào trong mục này.</div>
    ) : (
      <div class="posts-grid">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .cat-hero {
    padding: 1.55rem 1.7rem;
    margin-bottom: 1.65rem;
    background:
      radial-gradient(circle at 90% 20%, rgba(139, 92, 246, 0.2), transparent 48%),
      var(--bg-card);
  }

  .cat-title {
    margin: 0.7rem 0 0.4rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
  }

  .cat-desc {
    margin: 0;
    color: var(--text-muted);
    max-width: 65ch;
  }

  .cat-count {
    margin-top: 0.85rem;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .empty-state {
    padding: 2rem;
    text-align: center;
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
