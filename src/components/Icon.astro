      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
    </>
  )}
  {name === 'toc' && (
    <>
      <path d="M3 6h18M3 12h14M3 18h10" />
    </>
  )}
  {name === 'youtube' && (
    <>
      <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17" />
      <path d="m10 15 5-3-5-3v6Z" fill="currentColor" />
    </>
  )}
  {name === 'tiktok' && (
    <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" />
  )}
  {name === 'discord' && (
    <>
      <path d="M8.5 14.5c-.8 0-1.5-.9-1.5-2s.7-2 1.5-2 1.5.9 1.5 2-.7 2-1.5 2Zm7 0c-.8 0-1.5-.9-1.5-2s.7-2 1.5-2 1.5.9 1.5 2-.7 2-1.5 2Z" fill="currentColor" stroke="none" />
      <path d="M18.9 5.3A16 16 0 0 0 15 4l-.5 1a14 14 0 0 0-5 0L9 4a16 16 0 0 0-3.9 1.3C2.6 9.1 2 12.8 2.3 16.5a16.5 16.5 0 0 0 4.8 2.4l1-1.6a10 10 0 0 1-1.6-.8l.4-.3a11.5 11.5 0 0 0 10.2 0l.4.3a10 10 0 0 1-1.6.8l1 1.6a16.5 16.5 0 0 0 4.8-2.4c.4-4.2-.7-7.9-2.8-11.2Z" />
    </>
